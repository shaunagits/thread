         order they sit in the markup — the markup groups them by band, above
         the window and below it. */
      .dp-wide .c1 { animation-name: dp-focus-1; }
      .dp-wide .c2 { animation-name: dp-focus-2; }
      .dp-wide .c3 { animation-name: dp-focus-3; }
      .dp-wide .c4 { animation-name: dp-focus-4; }
      .dp-wide .c5 { animation-name: dp-focus-5; }
      .dp-wide .c6 { animation-name: dp-focus-6; }

      .dp-wide .s-1 { animation-name: dp-spot-1; }
      .dp-wide .s-2 { animation-name: dp-spot-2; }
      .dp-wide .s-3 { animation-name: dp-spot-3; }
      .dp-wide .s-4 { animation-name: dp-spot-4; }
      .dp-wide .s-5 { animation-name: dp-spot-5; }
      .dp-wide .s-6 { animation-name: dp-spot-6; }
