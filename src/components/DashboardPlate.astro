  @keyframes dp-spot-2 { 0%, 22% { opacity: 0 } 24.3%, 36.67% { opacity: 1 } 38.3%, 100% { opacity: 0 } }
  @keyframes dp-spot-3 { 0%, 35.3% { opacity: 0 } 37.7%, 50% { opacity: 1 } 51.7%, 100% { opacity: 0 } }
  @keyframes dp-spot-4 { 0%, 48.7% { opacity: 0 } 51%, 63.33% { opacity: 1 } 65%, 100% { opacity: 0 } }
  @keyframes dp-spot-5 { 0%, 62% { opacity: 0 } 64.3%, 76.67% { opacity: 1 } 78.3%, 100% { opacity: 0 } }
