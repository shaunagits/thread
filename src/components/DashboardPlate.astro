---
import DashboardWindow from './DashboardWindow.astro';

/* The six claims, in the drawing's reading order. One array so the wide
   plate's SVG callouts and the phone plate's HTML list cannot drift apart —
   they carried the same six strings written out twice until 29 Aug 2026.
   The coordinates stay in the markup because each callout is placed by hand. */
const claims = [
  { n: 1, text: 'Live counts from your tools' },
  { n: 2, text: 'Reconciled, not retyped' },
  { n: 3, text: 'Invoices go out on close' },
  { n: 4, text: 'One login, you set access' },
  { n: 5, text: 'Your process, not a template' },
  { n: 6, text: 'Your account, you own it' },
];
const claim = (n) => claims[n - 1].text;

/**
 * The after state: one window, carrying the client's own mark, colour and
 * navigation, with sales, operations and crew on a single screen.
 *
 * Pairs with ProblemFlow. That plate shows work being carried by hand between
 * tools; this one shows where it lands instead. Intended for §02, not §01 —
 * §01 is the problem, and a finished dashboard is not a problem.
 *
 * No invented client. The only brand text is the placeholder domain, and the
 * wordmark is an abstract bar rather than a name, so nothing here implies a
 * customer that does not exist. Figures are illustrative and should be swapped
 * for real ones the moment there are real ones.
 *
 * Every colour is a token. Motion is CSS only and lives inside
 * prefers-reduced-motion: no-preference, so the reduced-motion default is the
 * finished still drawing.
 */
---

<figure class="dashboard-plate">
  <div class="dp-pan">
    <!-- The canvas grows vertically for the callout bands and not horizontally,
         which is deliberate: extra width would shrink the window inside the
         same column, extra height costs it nothing. The window's own
         coordinates are unchanged from the un-annotated version. -->
    <svg class="dp-plate dp-wide" viewBox="0 -132 1040 748" role="img" aria-labelledby="dp-title dp-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="dp-title">One dashboard, built for your business</title>
      <desc id="dp-desc">A browser window carrying your own logo, colour and navigation. A single screen shows revenue for the month, the number of open jobs, who is on shift today, a chart of recent sales, and the crews currently working. Six labelled markers point to features: your process rather than a template, your own account, live counts from your tools, invoices sent on job close, figures reconciled rather than retyped, and one login with access you control.</desc>

      <DashboardWindow />

      <!-- ============ callouts ============
           Numbered marker, short label, and a leader to the thing it names.
           Three above the window and three below: laid out horizontally the
           labels use width efficiently, so the bands cost height rather than
           the window's size. SVG <text> is real text, so these stay selectable
           and readable by assistive tech. -->
      <g class="dp-callout">
        <g class="dp-co dp-c5">
          <path class="dp-leader" d="M24 -93 V150"/>
          <circle class="dp-marker" cx="24" cy="-104" r="13"/>
          <text class="dp-markertext" x="24" y="-100">5</text>
          <text class="dp-colabel" x="44" y="-99">{claim(5)}</text>
        </g>
        <g class="dp-co dp-c6">
          <path class="dp-leader" d="M430 -93 V-40 H520 V27"/>
          <circle class="dp-marker" cx="430" cy="-104" r="13"/>
          <text class="dp-markertext" x="430" y="-100">6</text>
          <text class="dp-colabel" x="450" y="-99">{claim(6)}</text>
        </g>
        <g class="dp-co dp-c1">
          <path class="dp-leader" d="M770 -93 V-40 H650 V150"/>
          <circle class="dp-marker" cx="770" cy="-104" r="13"/>
          <text class="dp-markertext" x="770" y="-100">1</text>
          <text class="dp-colabel" x="790" y="-99">{claim(1)}</text>
        </g>

        <g class="dp-co dp-c3">
          <path class="dp-leader" d="M24 573 V343"/>
          <circle class="dp-marker" cx="24" cy="584" r="13"/>
          <text class="dp-markertext" x="24" y="588">3</text>
          <text class="dp-colabel" x="44" y="589">{claim(3)}</text>
        </g>
        <g class="dp-co dp-c2">
          <path class="dp-leader" d="M430 573 V550 H520 V508"/>
          <circle class="dp-marker" cx="430" cy="584" r="13"/>
          <text class="dp-markertext" x="430" y="588">2</text>
          <text class="dp-colabel" x="450" y="589">{claim(2)}</text>
        </g>
        <g class="dp-co dp-c4">
          <path class="dp-leader" d="M770 573 V550 H898 V508"/>
          <circle class="dp-marker" cx="770" cy="584" r="13"/>
          <text class="dp-markertext" x="770" y="588">4</text>
          <text class="dp-colabel" x="790" y="589">{claim(4)}</text>
        </g>
      </g>

      <!-- ============ spotlights ============
           One rect per callout, framing the region of the window that callout
           names. They are drawn last so they sit above the window, and they
           are invisible until the scroll walk brings their callout up.

           Each is inset 4 units around the panel it frames so the 2px stroke
           sits outside the panel's own hairline rather than on top of it. -->
      <g class="dp-spots">
        <rect class="dp-spot dp-sp1" x="526" y="146" width="246" height="112" rx="3"/>
        <rect class="dp-spot dp-sp2" x="268" y="274" width="504" height="238" rx="3"/>
        <rect class="dp-spot dp-sp3" x="16"  y="322" width="208" height="42"  rx="3"/>
        <rect class="dp-spot dp-sp4" x="784" y="274" width="228" height="238" rx="3"/>
        <rect class="dp-spot dp-sp5" x="16"  y="140" width="208" height="258" rx="3"/>
        <rect class="dp-spot dp-sp6" x="296" y="22"  width="448" height="32"  rx="3"/>
      </g>
    </svg>

    <!-- ================= narrow =================
         A phone cannot read the wide drawing, and panning it sideways hides
         half the argument behind a gesture most visitors never make. So the
         composition changes instead of the scale: one column of panels, a
         menu button where the sidebar was, and the six labels stacked under
         the window rather than in bands beside it. Same swap at the same
         breakpoint as HeroGraphic. -->
    <svg class="dp-plate dp-narrow" viewBox="0 0 440 720" role="img" aria-labelledby="dpn-title dpn-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="dpn-title">One dashboard, built for your business</title>
      <desc id="dpn-desc">A browser window carrying your own logo and colour, showing revenue for the month, open jobs, who is on shift, a chart of recent sales and the crews working today. Beneath it, the six things that make it yours.</desc>

      <g class="dp-window">
        <rect class="dp-panel" x="8" y="8" width="424" height="420" rx="3"/>
        <path class="dp-rule" d="M8 44 H432"/>
        <g class="dp-dots"><circle cx="24" cy="26" r="4"/><circle cx="38" cy="26" r="4"/><circle cx="52" cy="26" r="4"/></g>
        <rect class="dp-urlbar" x="112" y="18" width="246" height="16" rx="8"/>
        <text class="dp-url-n" x="124" y="30">app.yourbusiness.com</text>
      </g>

      <g class="dp-side">
        <rect class="dp-mark" x="24" y="60" width="20" height="20" rx="4"/>
        <rect class="dp-wordmark" x="52" y="66" width="62" height="8" rx="4"/>
        <g class="dp-hair">
          <rect x="392" y="64" width="24" height="3" rx="1.5"/>
          <rect x="392" y="70.5" width="24" height="3" rx="1.5"/>
          <rect x="392" y="77" width="24" height="3" rx="1.5"/>
        </g>
        <path class="dp-rule" d="M8 96 H432"/>
      </g>

      <g class="dp-head">
        <text class="dp-h-n" x="24" y="128">Today</text>
        <text class="dp-lbl-n" x="24" y="147">MONDAY · ALL LOCATIONS</text>
        <rect class="dp-btn" x="316" y="110" width="96" height="28" rx="2"/>
        <text class="dp-btntext-n" x="364" y="129">New job</text>
      </g>

      <g class="dp-stats">
        <g class="dp-stat s1">
          <rect class="dp-card" x="24" y="166" width="117" height="76" rx="2"/>
          <text class="dp-lbl-n" x="34" y="188">REVENUE</text>
          <text class="dp-fig-n" x="34" y="220">$148,320</text>
        </g>
        <g class="dp-stat s2">
          <rect class="dp-card" x="153" y="166" width="117" height="76" rx="2"/>
          <text class="dp-lbl-n" x="163" y="188">JOBS OPEN</text>
          <text class="dp-fig-n" x="163" y="220">37</text>
        </g>
        <g class="dp-stat s3">
          <rect class="dp-card" x="282" y="166" width="126" height="76" rx="2"/>
          <text class="dp-lbl-n" x="292" y="188">ON SHIFT</text>
          <text class="dp-fig-n" x="292" y="220">12</text>
        </g>
      </g>

      <g class="dp-chart">
        <rect class="dp-card" x="24" y="262" width="250" height="150" rx="2"/>
        <text class="dp-lbl-n" x="36" y="284">SALES · LAST 7 DAYS</text>
        <g class="dp-grid">
          <path d="M36 344 H262" fill="none"/>
          <path d="M36 370 H262" fill="none"/>
        </g>
        <path class="dp-rule" d="M36 396 H262" fill="none"/>
        <path class="dp-s3" pathLength="1" fill="none" d="M36.0 385 L73.7 381 L111.3 383 L149.0 374 L186.7 379 L224.3 368 L262.0 372"/>
        <path class="dp-s2" pathLength="1" fill="none" d="M36.0 376 L73.7 368 L111.3 374 L149.0 358 L186.7 366 L224.3 350 L262.0 356"/>
        <path class="dp-s1" pathLength="1" fill="none" d="M36.0 366 L73.7 350 L111.3 370 L149.0 336 L186.7 356 L224.3 324 L262.0 344"/>
        <circle class="dp-point" cx="262" cy="344" r="4"/>
      </g>

      <g class="dp-list">
        <rect class="dp-card" x="286" y="262" width="122" height="150" rx="2"/>
        <text class="dp-lbl-n" x="298" y="284">CREW</text>
        <g class="dp-row r1">
          <circle class="dp-avatar" cx="304" cy="316" r="9"/>
          <rect class="dp-hair" x="320" y="313" width="52" height="6" rx="3"/>
          <circle class="dp-status" cx="394" cy="316" r="4"/>
        </g>
        <g class="dp-row r2">
          <circle class="dp-avatar" cx="304" cy="352" r="9"/>
          <rect class="dp-hair" x="320" y="349" width="44" height="6" rx="3"/>
          <circle class="dp-status" cx="394" cy="352" r="4"/>
        </g>
        <g class="dp-row r3">
          <circle class="dp-avatar" cx="304" cy="388" r="9"/>
          <rect class="dp-hair" x="320" y="385" width="48" height="6" rx="3"/>
          <circle class="dp-status dp-status-off" cx="394" cy="388" r="4"/>
        </g>
      </g>

      <g class="dp-callout">
        <g class="dp-co dp-c1">
          <circle class="dp-marker" cx="22" cy="470" r="13"/>
          <text class="dp-markertext" x="22" y="474">1</text>
          <text class="dp-colabel-n" x="46" y="475">{claim(1)}</text>
        </g>
        <g class="dp-co dp-c2">
          <circle class="dp-marker" cx="22" cy="512" r="13"/>
          <text class="dp-markertext" x="22" y="516">2</text>
          <text class="dp-colabel-n" x="46" y="517">{claim(2)}</text>
        </g>
        <g class="dp-co dp-c3">
          <circle class="dp-marker" cx="22" cy="554" r="13"/>
          <text class="dp-markertext" x="22" y="558">3</text>
          <text class="dp-colabel-n" x="46" y="559">{claim(3)}</text>
        </g>
        <g class="dp-co dp-c4">
          <circle class="dp-marker" cx="22" cy="596" r="13"/>
          <text class="dp-markertext" x="22" y="600">4</text>
          <text class="dp-colabel-n" x="46" y="601">One login · you set access</text>
        </g>
        <g class="dp-co dp-c5">
          <circle class="dp-marker" cx="22" cy="638" r="13"/>
          <text class="dp-markertext" x="22" y="642">5</text>
          <text class="dp-colabel-n" x="46" y="643">{claim(5)}</text>
        </g>
        <g class="dp-co dp-c6">
          <circle class="dp-marker" cx="22" cy="680" r="13"/>
          <text class="dp-markertext" x="22" y="684">6</text>
          <text class="dp-colabel-n" x="46" y="685">Your account · you own it</text>
        </g>
      </g>
    </svg>

    <!-- ================= phone, zoomed =================
         The full desktop drawing in a tight frame, scrubbing to each of the
         six regions in turn as the figure crosses the viewport, with the
         claims as real text underneath rather than as 11px SVG labels.

         ⚠️ This only renders where `animation-timeline` is supported, and
         `.dp-narrow` above is the fallback. That is not belt and braces: the
         drawing is 1040 units wide in a 350px frame, so unzoomed its labels
         render at about 3.7px. Without the scroll walk this composition is
         illegible, where the narrow redraw is legible with no motion at all.
         The design file drives the same behaviour with a scroll handler,
         which always runs; CSS does not, so the fallback is load-bearing. -->
    <div class="dp-zoomwrap">
      <div class="dp-frame">
        <svg class="dp-plate dp-zoom" viewBox="0 0 1040 548" role="img" aria-labelledby="dpz-title dpz-desc" xmlns="http://www.w3.org/2000/svg">
          <title id="dpz-title">One dashboard, built for your business</title>
          <desc id="dpz-desc">A browser window showing revenue for the month, open jobs, who is on shift, a chart of recent sales and the crews working today. It zooms to each labelled area in turn as you scroll.</desc>
          <g class="dp-zoomg">
            <DashboardWindow />
            <g class="dp-spots">
              <rect class="dp-spot dp-sp1" x="526" y="146" width="246" height="112" rx="3" vector-effect="non-scaling-stroke"/>
              <rect class="dp-spot dp-sp2" x="268" y="274" width="504" height="238" rx="3" vector-effect="non-scaling-stroke"/>
              <rect class="dp-spot dp-sp3" x="16"  y="322" width="208" height="42"  rx="3" vector-effect="non-scaling-stroke"/>
              <rect class="dp-spot dp-sp4" x="784" y="274" width="228" height="238" rx="3" vector-effect="non-scaling-stroke"/>
              <rect class="dp-spot dp-sp5" x="16"  y="140" width="208" height="176" rx="3" vector-effect="non-scaling-stroke"/>
              <rect class="dp-spot dp-sp6" x="296" y="22"  width="448" height="32"  rx="3" vector-effect="non-scaling-stroke"/>
            </g>
          </g>
        </svg>
      </div>

      <ol class="dp-claims">
        {claims.map((c) => (
          <li class={`dp-claim dp-cl${c.n}`}>
            <span class="dp-claim-n">{c.n}</span>
            <span class="dp-claim-t">{c.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</figure>

<style is:global>
  /* ⚠️ is:global, deliberately.

     The window drawing lives in DashboardWindow.astro so the wide plate and
     the phone plate can frame the same coordinates two ways. Astro stamps each
     component's markup with its own scope id, so a scoped rule here would
     compile to `.dp-panel[data-astro-cid-PLATE]` and match nothing the child
     renders — the same failure as landmine 18, one level up.

     Global is safe because every selector below is namespaced: dp- for the
     drawing, dp-co/dp-cN for the callouts, dp-spot/dp-spN for the spotlights.
     The callout and spotlight families were `.co`/`.cN`/`.s-N` until this
     change and were renamed precisely because those are too short to put in a
     global namespace. Keep any new selector in this file dp-prefixed. */
  /* 1100px is the .wrap content width (1180 less its 40px padding), so the
     drawing fills the column exactly rather than being letterboxed by the
     gutters the callouts need. */
  /* Drawing-space type. The unit here is the viewBox, not the screen, so the
     numbers differ between the two compositions even though the roles are
     identical. Four roles: a label, a name, a figure, and the callout.

     The callout earned its own size on 18 Aug 2026. It is the only text in the
     plate that is the page's content rather than part of the interface being
     depicted — CLAUDE.md calls the six callouts content, not decoration — and
     it is the only one whose rendered size has to hold across the narrow
     composition's whole scale range. Every other role is drawn UI and can ride
     the drawing's scale without anyone minding. */
  .dp-wide   { --fs-micro: 11px; --fs-name: 16px; --fs-fig: 28px; --fs-colabel: 11px; }

  /* Between 821 and 1000 the wide drawing is still in use but the column has
     dropped to 740-920px, so a 1040-unit canvas renders at 0.71-0.89 and the
     names fell to 12.6px against 16.5px body copy. Name and figure are bumped
     to compensate; --fs-colabel deliberately is not, because the callout labels
     sit close to the canvas edge and "Live counts from your tools" overflows it
     above 12 units. (That constraint used to be written against --fs-micro,
     which the wide callout shared until the callout took its own role.) */
  @media (min-width: 821px) and (max-width: 1000px) {
    .dp-wide { --fs-name: 21px; --fs-fig: 34px; }
  }
  /* Capped at its own 440-unit width for the same reason as the hero's narrow
     composition: unbounded, it scaled 1.56x at tablet and rendered its figures
     at 31px.

     The cap is why --fs-colabel is 14 here and 11 in the wide drawing. This
     composition does not render at one scale: a 375px phone gives the SVG
     331px, or 0.75, while anything from 484px up hits the 440 cap at 1.0. So a
     unit value lands at two different sizes. 14 splits the difference, at
     10.5px on a phone and 14px above the cap, against a 10px --text-micro. It
     was 18, inherited from --fs-name, which rendered at 18px above the cap —
     larger than 16.5px body copy, and the size the owner reported. --fs-name is
     absent here because the callout was its only consumer in this composition. */
  .dp-narrow { --fs-micro: 11px; --fs-fig: 24px; --fs-colabel: 14px; max-width: 440px; }

  .dashboard-plate { margin-top: 44px; max-width: 1100px; }
  .dp-plate { display: block; width: 100%; height: auto; overflow: visible; }
  .dp-narrow { display: none; }

  /* Type inside the narrow composition is sized against a 440-unit canvas
     rather than a 1040-unit one, so these are roughly 2.4x the wide values
     and land at about the same rendered size on a phone. */
  .dp-url-n     { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-lbl-n     { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-h-n       { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-fig-n     { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-btntext-n { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-paper); text-anchor: middle; }
  .dp-colabel-n { font-family: var(--font-mono); font-size: var(--fs-colabel); letter-spacing: var(--tracking-wide); text-transform: uppercase; fill: var(--color-body); }

  /* ---- paint. no hex; every value is a token from global.css ---- */
  .dp-panel     { fill: var(--color-white); stroke: var(--color-hair); stroke-width: 1; }
  .dp-card      { fill: var(--color-white); stroke: var(--color-hair); stroke-width: 1; }
  .dp-rule      { stroke: var(--color-rule); stroke-width: 1; fill: none; }
  .dp-dots      { fill: var(--color-hair); }
  .dp-hair      { fill: var(--color-hair); }
  .dp-urlbar    { fill: var(--color-wash); }
  .dp-avatar    { fill: var(--color-wash); stroke: var(--color-hair); stroke-width: 1; }

  /* the client's own mark and colour */
  .dp-mark      { fill: var(--color-accent); }
  .dp-wordmark  { fill: var(--color-accent); }
  .dp-navactive { fill: var(--color-wash); }

  .dp-url       { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-lbl       { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-h         { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-fig       { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-navon     { font-family: var(--font-serif); font-size: var(--fs-name); fill: var(--color-accent); }
  .dp-navoff    { font-family: var(--font-serif); font-size: var(--fs-name); fill: var(--color-body); }
  .dp-rowtext   { font-family: var(--font-serif); font-size: var(--fs-name); fill: var(--color-body); }

  .dp-btn       { fill: var(--color-accent); }
  .dp-btntext   { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-paper); text-anchor: middle; }

  /* callouts. The marker reuses ServiceList's numbered-circle treatment
     exactly, at 26px instead of 34px, so no new pattern enters the design. */
  .dp-leader     { stroke: var(--color-accent-dark); stroke-width: 1; fill: none; }
  .dp-marker     { fill: var(--color-paper); stroke: var(--color-accent-dark); stroke-width: 1; }
  .dp-markertext{ font-family: var(--font-mono); font-size: var(--fs-micro); fill: var(--color-accent); text-anchor: middle; }
  .dp-colabel   { font-family: var(--font-mono); font-size: var(--fs-colabel); letter-spacing: var(--tracking-wide); text-transform: uppercase; fill: var(--color-body); }

  .dp-grid path { stroke: var(--color-rule); stroke-width: 1; fill: none; }
  /* Three series, darkest on top. All one hue family, so it reads as one chart
     rather than three competing colours. No fills anywhere in here — see the
     note in the markup. */
  /* stroke-dasharray sits here rather than in the motion block so the value is
     always present; the keyframe only moves the offset. A dasharray of 1 on a
     path normalised to pathLength=1 means one dash covers the whole line. */
  .dp-s1, .dp-s2, .dp-s3 { fill: none; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; }
  /* Under the ocean palette these were koa / line / ochre — three distinct
     hues. Graphite has two accent steps, not three, and aliasing koa and ochre
     both onto --color-accent would have drawn the leading and trailing series
     in exactly the same colour. Separation is now weight and depth rather than
     hue, which is what the design draws: the leading series is the dark accent
     at 2px, the middle the same colour at 1.5, the trailing one the lighter
     accent. */
  .dp-s1 { stroke: var(--color-accent-dark); stroke-width: 2; }
  .dp-s2 { stroke: var(--color-accent-dark); stroke-width: 1.5; }
  .dp-s3 { stroke: var(--color-accent);      stroke-width: 1.5; }
  .dp-point { fill: var(--color-white); stroke: var(--color-accent-dark); stroke-width: 2; }
  .dp-status    { fill: var(--color-accent-dark); }
  .dp-status-off{ fill: var(--color-hair); }

  /* ============================================================
     Motion — CSS only. No JavaScript, no library, no SMIL.
     Entry runs once; the plate sits below the fold on most screens but
     above it on a tall desktop, so this is time-driven rather than
     scroll-driven for the same reason HeroGraphic is.
     ============================================================ */
  /* From-states live here, not in the rules. That is landmine 22's whole point:
     a rule that hides the element survives when the thing meant to reveal it is
     dropped, and the drawing goes permanently invisible. In a keyframe the
     hidden state cannot outlive its own animation.

     They were absent until 18 Aug 2026, and every one of these was `to`-only.
     With animation-fill-mode: both and nothing hiding the elements, each
