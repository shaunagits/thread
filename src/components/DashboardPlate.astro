---
/**
 * The after state: one window, carrying the client's own mark, colour and
 * navigation, with sales, operations and crew on a single screen.
 *
 * Pairs with ProblemFlow. That plate shows work being carried by hand between
 * tools; this one shows where it lands instead. Intended for §02, not §01 —
 * §01 is the problem, and a finished dashboard is not a problem.
 *
 * No invented client. The only brand text is the placeholder domain, and the
 * wordmark is an abstract bar rather than a name, so nothing here implies a
 * customer that does not exist. Figures are illustrative and should be swapped
 * for real ones the moment there are real ones.
 *
 * Every colour is a token. Motion is CSS only and lives inside
 * prefers-reduced-motion: no-preference, so the reduced-motion default is the
 * finished still drawing.
 */
---

<figure class="dashboard-plate">
  <div class="dp-pan">
    <!-- The canvas grows vertically for the callout bands and not horizontally,
         which is deliberate: extra width would shrink the window inside the
         same column, extra height costs it nothing. The window's own
         coordinates are unchanged from the un-annotated version. -->
    <svg class="dp-plate dp-wide" viewBox="0 -132 1040 748" role="img" aria-labelledby="dp-title dp-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="dp-title">One dashboard, built for your business</title>
      <desc id="dp-desc">A browser window carrying your own logo, colour and navigation. A single screen shows revenue for the month, the number of open jobs, who is on shift today, a chart of recent sales, and the crews currently working. Six labelled markers point to features: your process rather than a template, your own account, live counts from your tools, invoices sent on job close, figures reconciled rather than retyped, and one login with access you control.</desc>

      <!-- ============ window ============ -->
      <g class="dp-window">
        <rect class="dp-panel" x="8" y="16" width="1024" height="516" rx="3"/>
        <path class="dp-rule" d="M8 60 H1032"/>
        <g class="dp-dots"><circle cx="34" cy="38" r="4.5"/><circle cx="52" cy="38" r="4.5"/><circle cx="70" cy="38" r="4.5"/></g>
        <rect class="dp-urlbar" x="300" y="27" width="440" height="22" rx="11"/>
        <text class="dp-url" x="322" y="42">app.yourbusiness.com</text>
      </g>

      <!-- ============ sidebar: the client's own ============ -->
      <g class="dp-side">
        <path class="dp-rule" d="M240 60 V532"/>
        <rect class="dp-mark" x="32" y="88" width="26" height="26" rx="5"/>
        <rect class="dp-wordmark" x="70" y="96" width="86" height="11" rx="5.5"/>

        <rect class="dp-navactive" x="20" y="150" width="200" height="38" rx="2"/>
        <text class="dp-navon"  x="40" y="175">Dashboard</text>
        <text class="dp-navoff" x="40" y="217">Sales</text>
        <text class="dp-navoff" x="40" y="259">Jobs</text>
        <text class="dp-navoff" x="40" y="301">Team</text>
        <text class="dp-navoff" x="40" y="343">Invoices</text>

        <path class="dp-rule" d="M20 384 H220"/>
        <circle class="dp-avatar" cx="38" cy="424" r="13"/>
        <rect class="dp-hair" x="62" y="419" width="94" height="9" rx="4.5"/>
      </g>

      <!-- ============ header row ============ -->
      <g class="dp-head">
        <text class="dp-h" x="272" y="106">Today</text>
        <text class="dp-lbl" x="272" y="130">MONDAY · ALL LOCATIONS</text>
        <rect class="dp-btn" x="896" y="84" width="112" height="34" rx="2"/>
        <text class="dp-btntext" x="952" y="106">New job</text>
      </g>

      <!-- ============ the three figures ============ -->
      <g class="dp-stats">
        <g class="dp-stat s1">
          <rect class="dp-card" x="272" y="150" width="238" height="104" rx="2"/>
          <text class="dp-lbl" x="292" y="184">REVENUE · THIS MONTH</text>
          <text class="dp-fig" x="292" y="226">$148,320</text>
        </g>
        <g class="dp-stat s2">
          <rect class="dp-card" x="530" y="150" width="238" height="104" rx="2"/>
          <text class="dp-lbl" x="550" y="184">JOBS OPEN</text>
          <text class="dp-fig" x="550" y="226">37</text>
        </g>
        <g class="dp-stat s3">
          <rect class="dp-card" x="788" y="150" width="220" height="104" rx="2"/>
          <text class="dp-lbl" x="808" y="184">ON SHIFT TODAY</text>
          <text class="dp-fig" x="808" y="226">12</text>
        </g>
      </g>

      <!-- ============ sales ============ -->
      <g class="dp-chart">
        <rect class="dp-card" x="272" y="278" width="496" height="230" rx="2"/>
        <text class="dp-lbl" x="292" y="310">SALES · LAST 7 DAYS</text>
        <path class="dp-rule" d="M292 480 H748"/>
        <g class="dp-bars">
          <rect class="dp-bar" x="294" y="422" width="40" height="58"/>
          <rect class="dp-bar" x="358" y="394" width="40" height="86"/>
          <rect class="dp-bar" x="422" y="430" width="40" height="50"/>
          <rect class="dp-bar" x="486" y="370" width="40" height="110"/>
          <rect class="dp-bar" x="550" y="404" width="40" height="76"/>
          <rect class="dp-bar" x="614" y="348" width="40" height="132"/>
          <rect class="dp-bar dp-bar-now" x="678" y="382" width="40" height="98"/>
        </g>
      </g>

      <!-- ============ crew ============ -->
      <g class="dp-list">
        <rect class="dp-card" x="788" y="278" width="220" height="230" rx="2"/>
        <text class="dp-lbl" x="808" y="310">CREW · TODAY</text>

        <g class="dp-row r1">
          <circle class="dp-avatar" cx="812" cy="348" r="13"/>
          <text class="dp-rowtext" x="838" y="353">Install</text>
          <circle class="dp-status" cx="986" cy="348" r="5"/>
        </g>
        <g class="dp-row r2">
          <circle class="dp-avatar" cx="812" cy="396" r="13"/>
          <text class="dp-rowtext" x="838" y="401">Delivery</text>
          <circle class="dp-status" cx="986" cy="396" r="5"/>
        </g>
        <g class="dp-row r3">
          <circle class="dp-avatar" cx="812" cy="444" r="13"/>
          <text class="dp-rowtext" x="838" y="449">Front desk</text>
          <circle class="dp-status dp-status-off" cx="986" cy="444" r="5"/>
        </g>
      </g>

      <!-- ============ callouts ============
           Numbered marker, short label, and a leader to the thing it names.
           Three above the window and three below: laid out horizontally the
           labels use width efficiently, so the bands cost height rather than
           the window's size. SVG <text> is real text, so these stay selectable
           and readable by assistive tech. -->
      <g class="dp-callout">
        <g class="co c5">
          <path class="dp-leader" d="M24 -93 V150"/>
          <circle class="dp-marker" cx="24" cy="-104" r="13"/>
          <text class="dp-markertext" x="24" y="-100">5</text>
          <text class="dp-colabel" x="44" y="-99">Your process, not a template</text>
        </g>
        <g class="co c6">
          <path class="dp-leader" d="M430 -93 V-40 H520 V27"/>
          <circle class="dp-marker" cx="430" cy="-104" r="13"/>
          <text class="dp-markertext" x="430" y="-100">6</text>
          <text class="dp-colabel" x="450" y="-99">Your account · you own it</text>
        </g>
        <g class="co c1">
          <path class="dp-leader" d="M770 -93 V-40 H650 V150"/>
          <circle class="dp-marker" cx="770" cy="-104" r="13"/>
          <text class="dp-markertext" x="770" y="-100">1</text>
          <text class="dp-colabel" x="790" y="-99">Live counts from your tools</text>
        </g>

        <g class="co c3">
          <path class="dp-leader" d="M24 573 V343"/>
          <circle class="dp-marker" cx="24" cy="584" r="13"/>
          <text class="dp-markertext" x="24" y="588">3</text>
          <text class="dp-colabel" x="44" y="589">Invoices go out on close</text>
        </g>
        <g class="co c2">
          <path class="dp-leader" d="M430 573 V550 H520 V508"/>
          <circle class="dp-marker" cx="430" cy="584" r="13"/>
          <text class="dp-markertext" x="430" y="588">2</text>
          <text class="dp-colabel" x="450" y="589">Reconciled, not retyped</text>
        </g>
        <g class="co c4">
          <path class="dp-leader" d="M770 573 V550 H898 V508"/>
          <circle class="dp-marker" cx="770" cy="584" r="13"/>
          <text class="dp-markertext" x="770" y="588">4</text>
          <text class="dp-colabel" x="790" y="589">One login · you set access</text>
        </g>
      </g>
    </svg>

    <!-- ================= narrow =================
         A phone cannot read the wide drawing, and panning it sideways hides
         half the argument behind a gesture most visitors never make. So the
         composition changes instead of the scale: one column of panels, a
         menu button where the sidebar was, and the six labels stacked under
         the window rather than in bands beside it. Same swap at the same
         breakpoint as HeroGraphic. -->
    <svg class="dp-plate dp-narrow" viewBox="0 0 440 720" role="img" aria-labelledby="dpn-title dpn-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="dpn-title">One dashboard, built for your business</title>
      <desc id="dpn-desc">A browser window carrying your own logo and colour, showing revenue for the month, open jobs, who is on shift, a chart of recent sales and the crews working today. Beneath it, the six things that make it yours.</desc>

      <g class="dp-window">
        <rect class="dp-panel" x="8" y="8" width="424" height="420" rx="3"/>
        <path class="dp-rule" d="M8 44 H432"/>
        <g class="dp-dots"><circle cx="24" cy="26" r="4"/><circle cx="38" cy="26" r="4"/><circle cx="52" cy="26" r="4"/></g>
        <rect class="dp-urlbar" x="112" y="18" width="246" height="16" rx="8"/>
        <text class="dp-url-n" x="124" y="30">app.yourbusiness.com</text>
      </g>

      <g class="dp-side">
        <rect class="dp-mark" x="24" y="60" width="20" height="20" rx="4"/>
        <rect class="dp-wordmark" x="52" y="66" width="62" height="8" rx="4"/>
        <g class="dp-hair">
          <rect x="392" y="64" width="24" height="3" rx="1.5"/>
          <rect x="392" y="70.5" width="24" height="3" rx="1.5"/>
          <rect x="392" y="77" width="24" height="3" rx="1.5"/>
        </g>
        <path class="dp-rule" d="M8 96 H432"/>
      </g>

      <g class="dp-head">
        <text class="dp-h-n" x="24" y="128">Today</text>
        <text class="dp-lbl-n" x="24" y="147">MONDAY · ALL LOCATIONS</text>
        <rect class="dp-btn" x="316" y="110" width="96" height="28" rx="2"/>
        <text class="dp-btntext-n" x="364" y="129">New job</text>
      </g>

      <g class="dp-stats">
        <g class="dp-stat s1">
          <rect class="dp-card" x="24" y="166" width="117" height="76" rx="2"/>
          <text class="dp-lbl-n" x="34" y="188">REVENUE</text>
          <text class="dp-fig-n" x="34" y="220">$148,320</text>
        </g>
        <g class="dp-stat s2">
          <rect class="dp-card" x="153" y="166" width="117" height="76" rx="2"/>
          <text class="dp-lbl-n" x="163" y="188">JOBS OPEN</text>
          <text class="dp-fig-n" x="163" y="220">37</text>
        </g>
        <g class="dp-stat s3">
          <rect class="dp-card" x="282" y="166" width="126" height="76" rx="2"/>
          <text class="dp-lbl-n" x="292" y="188">ON SHIFT</text>
          <text class="dp-fig-n" x="292" y="220">12</text>
        </g>
      </g>

      <g class="dp-chart">
        <rect class="dp-card" x="24" y="262" width="250" height="150" rx="2"/>
        <text class="dp-lbl-n" x="36" y="284">SALES · LAST 7 DAYS</text>
        <path class="dp-rule" d="M36 396 H262"/>
        <g class="dp-bars">
          <rect class="dp-bar" x="38" y="366" width="22" height="30"/>
          <rect class="dp-bar" x="70" y="350" width="22" height="46"/>
          <rect class="dp-bar" x="102" y="370" width="22" height="26"/>
          <rect class="dp-bar" x="134" y="336" width="22" height="60"/>
          <rect class="dp-bar" x="166" y="356" width="22" height="40"/>
          <rect class="dp-bar" x="198" y="324" width="22" height="72"/>
          <rect class="dp-bar dp-bar-now" x="230" y="344" width="22" height="52"/>
        </g>
      </g>

      <g class="dp-list">
        <rect class="dp-card" x="286" y="262" width="122" height="150" rx="2"/>
        <text class="dp-lbl-n" x="298" y="284">CREW</text>
        <g class="dp-row r1">
          <circle class="dp-avatar" cx="304" cy="316" r="9"/>
          <rect class="dp-hair" x="320" y="313" width="52" height="6" rx="3"/>
          <circle class="dp-status" cx="394" cy="316" r="4"/>
        </g>
        <g class="dp-row r2">
          <circle class="dp-avatar" cx="304" cy="352" r="9"/>
          <rect class="dp-hair" x="320" y="349" width="44" height="6" rx="3"/>
          <circle class="dp-status" cx="394" cy="352" r="4"/>
        </g>
        <g class="dp-row r3">
          <circle class="dp-avatar" cx="304" cy="388" r="9"/>
          <rect class="dp-hair" x="320" y="385" width="48" height="6" rx="3"/>
          <circle class="dp-status dp-status-off" cx="394" cy="388" r="4"/>
        </g>
      </g>

      <g class="dp-callout">
        <g class="co c1">
          <circle class="dp-marker" cx="22" cy="470" r="13"/>
          <text class="dp-markertext" x="22" y="474">1</text>
          <text class="dp-colabel-n" x="46" y="475">Live counts from your tools</text>
        </g>
        <g class="co c2">
          <circle class="dp-marker" cx="22" cy="512" r="13"/>
          <text class="dp-markertext" x="22" y="516">2</text>
          <text class="dp-colabel-n" x="46" y="517">Reconciled, not retyped</text>
        </g>
        <g class="co c3">
          <circle class="dp-marker" cx="22" cy="554" r="13"/>
          <text class="dp-markertext" x="22" y="558">3</text>
          <text class="dp-colabel-n" x="46" y="559">Invoices go out on close</text>
        </g>
        <g class="co c4">
          <circle class="dp-marker" cx="22" cy="596" r="13"/>
          <text class="dp-markertext" x="22" y="600">4</text>
          <text class="dp-colabel-n" x="46" y="601">One login · you set access</text>
        </g>
        <g class="co c5">
          <circle class="dp-marker" cx="22" cy="638" r="13"/>
          <text class="dp-markertext" x="22" y="642">5</text>
          <text class="dp-colabel-n" x="46" y="643">Your process, not a template</text>
        </g>
        <g class="co c6">
          <circle class="dp-marker" cx="22" cy="680" r="13"/>
          <text class="dp-markertext" x="22" y="684">6</text>
          <text class="dp-colabel-n" x="46" y="685">Your account · you own it</text>
        </g>
      </g>
    </svg>
  </div>
</figure>

<style>
  /* 1100px is the .wrap content width (1180 less its 40px padding), so the
     drawing fills the column exactly rather than being letterboxed by the
     gutters the callouts need. */
  /* Drawing-space type. The unit here is the viewBox, not the screen, so the
     numbers differ between the two compositions even though the three roles
     are identical. Three roles, nothing else: a label, a name, a figure. */
  .dp-wide   { --fs-micro: 11px; --fs-name: 16px; --fs-fig: 28px; }

  /* Between 821 and 1000 the wide drawing is still in use but the column has
     dropped to 740-920px, so a 1040-unit canvas renders at 0.71-0.89 and the
     names fell to 12.6px against 16.5px body copy. Name and figure are bumped
     to compensate; --fs-micro deliberately is not, because the callout labels
     are already close to the canvas edge and "Live counts from your tools"
     overflows it above 12 units. */
  @media (min-width: 821px) and (max-width: 1000px) {
    .dp-wide { --fs-name: 21px; --fs-fig: 34px; }
  }
  /* Capped at its own 440-unit width for the same reason as the hero's narrow
     composition: unbounded, it scaled 1.56x at tablet and rendered its figures
     at 31px. The name value is 18 rather than higher because the longest
     callout, "Your process, not a template", has to clear the canvas. */
  .dp-narrow { --fs-micro: 11px; --fs-name: 18px; --fs-fig: 24px; max-width: 440px; }

  .dashboard-plate { margin-top: 46px; max-width: 1100px; }
  .dp-plate { display: block; width: 100%; height: auto; overflow: visible; }
  .dp-narrow { display: none; }

  /* Type inside the narrow composition is sized against a 440-unit canvas
     rather than a 1040-unit one, so these are roughly 2.4x the wide values
     and land at about the same rendered size on a phone. */
  .dp-url-n     { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-lbl-n     { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-h-n       { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-fig-n     { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-btntext-n { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-paper); text-anchor: middle; }
  .dp-colabel-n { font-family: var(--font-mono); font-size: var(--fs-name); letter-spacing: var(--tracking-wide); text-transform: uppercase; fill: var(--color-body); }

  /* ---- paint. no hex; every value is a token from global.css ---- */
  .dp-panel     { fill: var(--color-white); stroke: var(--color-hair); stroke-width: 1; }
  .dp-card      { fill: var(--color-white); stroke: var(--color-hair); stroke-width: 1; }
  .dp-rule      { stroke: var(--color-rule); stroke-width: 1; fill: none; }
  .dp-dots      { fill: var(--color-hair); }
  .dp-hair      { fill: var(--color-hair); }
  .dp-urlbar    { fill: var(--color-wash); }
  .dp-avatar    { fill: var(--color-wash); stroke: var(--color-hair); stroke-width: 1; }

  /* the client's own mark and colour */
  .dp-mark      { fill: var(--color-koa); }
  .dp-wordmark  { fill: var(--color-koa); }
  .dp-navactive { fill: var(--color-wash); }

  .dp-url       { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-lbl       { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-faint); }
  .dp-h         { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-fig       { font-family: var(--font-display); font-size: var(--fs-fig); letter-spacing: var(--tracking-tight); fill: var(--color-ink); }
  .dp-navon     { font-family: var(--font-serif); font-size: var(--fs-name); fill: var(--color-koa); }
  .dp-navoff    { font-family: var(--font-serif); font-size: var(--fs-name); fill: var(--color-body); }
  .dp-rowtext   { font-family: var(--font-serif); font-size: var(--fs-name); fill: var(--color-body); }

  .dp-btn       { fill: var(--color-koa); }
  .dp-btntext   { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); fill: var(--color-paper); text-anchor: middle; }

  /* callouts. The marker reuses ServiceList's numbered-circle treatment
     exactly, at 26px instead of 34px, so no new pattern enters the design. */
  .dp-leader     { stroke: var(--color-line); stroke-width: 1; fill: none; }
  .dp-marker     { fill: var(--color-paper); stroke: var(--color-line); stroke-width: 1; }
  .dp-markertext{ font-family: var(--font-mono); font-size: var(--fs-micro); fill: var(--color-koa); text-anchor: middle; }
  .dp-colabel   { font-family: var(--font-mono); font-size: var(--fs-micro); letter-spacing: var(--tracking-wide); text-transform: uppercase; fill: var(--color-body); }

  .dp-bar       { fill: var(--color-ochre); }
  .dp-bar-now   { fill: var(--color-line); }
  .dp-status    { fill: var(--color-line); }
  .dp-status-off{ fill: var(--color-hair); }

  /* ============================================================
     Motion — CSS only. No JavaScript, no library, no SMIL.
     Entry runs once; the plate sits below the fold on most screens but
     above it on a tall desktop, so this is time-driven rather than
     scroll-driven for the same reason HeroGraphic is.
     ============================================================ */
  @keyframes dp-reveal { to { opacity: 1; } }
  @keyframes dp-rise   { to { opacity: 1; transform: translateY(0); } }
  @keyframes dp-grow   { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  @media (prefers-reduced-motion: no-preference) {
    .dp-side, .dp-head, .dp-stat, .dp-chart, .dp-list { opacity: 0; }
    .dp-stat, .dp-chart, .dp-list { transform: translateY(8px); }

    .dp-side  { animation: dp-reveal .28s ease-out forwards .10s; }
    .dp-head  { animation: dp-reveal .28s ease-out forwards .20s; }
    .dp-stat  { animation: dp-rise   .34s ease-out forwards; }
    .s1 { animation-delay: .30s; } .s2 { animation-delay: .38s; } .s3 { animation-delay: .46s; }
    .dp-chart { animation: dp-rise   .34s ease-out forwards .56s; }
    .dp-list  { animation: dp-rise   .34s ease-out forwards .64s; }

    .dp-bar {
      transform-box: fill-box; transform-origin: bottom;
      animation: dp-grow .42s cubic-bezier(.3,.7,.3,1) both .78s;
    }
    .dp-bar:nth-child(2) { animation-delay: .84s; }
    .dp-bar:nth-child(3) { animation-delay: .90s; }
    .dp-bar:nth-child(4) { animation-delay: .96s; }
    .dp-bar:nth-child(5) { animation-delay: 1.02s; }
    .dp-bar:nth-child(6) { animation-delay: 1.08s; }
    .dp-bar:nth-child(7) { animation-delay: 1.14s; }

    /* callouts land last, once the thing they point at exists */
    .co { opacity: 0; animation: dp-reveal .26s ease-out forwards; }
    .c6 { animation-delay: 1.30s; } .c1 { animation-delay: 1.38s; }
    .c5 { animation-delay: 1.46s; } .c3 { animation-delay: 1.54s; }
    .c4 { animation-delay: 1.62s; } .c2 { animation-delay: 1.70s; }
  }

  /* Composition swap, not a scale-down and not a sideways pan. Both drawings
     fit the column they are given at every width. */
  @media (max-width: 820px) {
    .dashboard-plate { margin-top: 34px; }
    .dp-wide   { display: none; }
    .dp-narrow { display: block; }
  }
</style>
