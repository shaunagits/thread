  @keyframes dp-focus-4 { 0%, 9% { opacity: 1 } 11%, 48.7% { opacity: .22 } 50%, 63.33% { opacity: 1 } 65%, 89% { opacity: .22 } 90%, 100% { opacity: 1 } }
  @keyframes dp-focus-5 { 0%, 9% { opacity: 1 } 11%, 62% { opacity: .22 } 63.33%, 76.67% { opacity: 1 } 78.3%, 89% { opacity: .22 } 90%, 100% { opacity: 1 } }
  @keyframes dp-focus-6 { 0%, 9% { opacity: 1 } 11%, 75.3% { opacity: .22 } 76.67%, 100% { opacity: 1 } }

