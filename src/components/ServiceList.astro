---
/** Three capabilities, presented as one connected spread rather than cards. */
import { plans } from '../content/site';
---

<div class="services-spread">
  {plans.map((service, i) => (
    <article class="service">
      <span class="num">0{i + 1}</span>
      <span class="label">{service.label}</span>
      <h3>{service.title}</h3>
      <p>{service.body}</p>
      <div class="meta">
        {service.meta.map((line, j) => <span>{j > 0 && <i>·</i>}{line}</span>)}
      </div>
    </article>
  ))}
</div>

<style>
  .services-spread {
    display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:0;
    margin-top:52px; position:relative;
  }
  .services-spread::before {
    content:''; position:absolute; left:17px; right:17px; top:17px;
    border-top:1px solid var(--color-hair);
  }
  .service { position:relative; padding:52px 34px 8px 0; min-height:280px; }
  .service + .service { padding-left:34px; border-left:1px solid var(--color-rule); }
  .num {
    position:absolute; left:0; top:0; z-index:1; width:34px; height:34px;
    display:grid; place-items:center; border:1px solid var(--color-hair); border-radius:50%;
    background:var(--color-wash); color:var(--color-koa); font-family:var(--font-mono);
    font-size:10px; letter-spacing:.04em;
  }
  .service + .service .num { left:33px; }
  .label { display:block; margin-bottom:14px; color:var(--color-koa); font-family:var(--font-mono); font-size:9.5px; letter-spacing:.14em; text-transform:uppercase; }
  h3 { max-width:12ch; margin-bottom:13px; font-size:clamp(25px, 2.5vw, 33px); line-height:1.08; }
  p { max-width:27ch; font-family:var(--font-serif); font-size:17px; line-height:1.58; color:var(--color-body); }
  .meta { margin-top:20px; color:var(--color-faint); font-family:var(--font-mono); font-size:9.5px; letter-spacing:.1em; text-transform:uppercase; }
  .meta i { padding:0 7px; color:var(--color-line); font-style:normal; }
  @media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .num, h3 { transition:color .2s ease, border-color .2s ease, background .2s ease; }
    .service:hover .num { border-color:var(--color-koa); background:var(--color-koa); color:var(--color-paper); }
    .service:hover h3 { color:var(--color-koa); }
  }
  @media (max-width:760px) {
    .services-spread { grid-template-columns:1fr; gap:0; margin-top:42px; }
    .services-spread::before { left:17px; right:auto; top:17px; bottom:17px; border-top:0; border-left:1px solid var(--color-hair); }
    .service, .service + .service { min-height:0; padding:0 0 43px 58px; border-left:0; }
    .service + .service { padding-top:0; }
    .service + .service .num { left:0; }
    .num { top:0; }
    .label { padding-top:4px; }
  }
</style>
