---
import { services } from '../content/site';
---

<div class="items">
  {services.map((service, i) => (
    <div class="item">
      <div class="num">{i + 1}</div>
      <div>
        <h3>{service.title}</h3>
        <p>{service.body}</p>
      </div>
      <div class="meta">
        {service.meta.map((line, j) => (
          <>{j > 0 && <br />}{line}</>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .items { margin-top: 8px; }
  .item {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) 250px;
    gap: 32px; padding: 34px 0;
    border-bottom: 1px solid var(--color-rule); align-items: start;
  }
  .item:first-child { border-top: 1px solid var(--color-rule); }
  .num {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-koa); color: var(--color-paper);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500; margin-top: 3px;
  }
  .item h3 { margin-bottom: 9px; }
  .item p {
    font-family: var(--font-serif); font-size: 16.5px;
    line-height: 1.6; color: var(--color-body); max-width: 52ch;
  }
  .item .meta {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .13em;
    text-transform: uppercase; color: var(--color-faint);
    line-height: 1.9; padding-top: 5px;
  }

  @media (max-width: 1000px) {
    .item { grid-template-columns: 48px minmax(0, 1fr); gap: 22px; }
    .item .meta { grid-column: 2; padding-top: 14px; }
  }
</style>
