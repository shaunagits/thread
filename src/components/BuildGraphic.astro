---
/**
 * §02's drawing: a workflow builds itself, joins up, and then runs on its own.
 *
 * Ported 29 Aug 2026 from `buildgraphic.jsx`, supplied by the owner with
 * "What We Build Graphic.dc.html". It replaces DashboardPlate.astro and
 * DashboardWindow.astro, and the six `claims` went with them.
 *
 * THE SOURCE IS REACT DRIVEN BY A CLOCK. This is CSS. The scene cues are the
 * source's own — Draw 0, Connect 2.2, Run 4.2, Settle 7.0, total 9.4s — and
 * every keyframe percentage below is one of its expressions in `T` divided by
 * 9.4. The easings it imported from the absent animations-v3.jsx are
 * cubic-beziers here; see RepetitiveGraphic.astro for the ob() note.
 *
 * Two things the source does that CSS cannot do the same way, both re-expressed
 * rather than approximated:
 *
 *  - It finds pulse positions with getPointAtLength on a measuring <path>.
 *    Here the dots ride `offset-path: path(...)` on the same `d` string, so
 *    they follow the identical curve without a measurement step.
 *  - Its counter is Math.round(lerp(0, 24, easeInOutCubic(...))). Here it is a
 *    column of 25 numerals behind a one-line clip, stepped by the 24 moments
 *    that expression actually gains a whole number, so the climb decelerates
 *    exactly as drawn rather than running linearly.
 *
 * ⚠️ The window is drawn flat — border, no drop shadow. The source carries
 * `0 40px 80px rgba(38,35,30,.13)`. Nothing else in this design has a shadow
 * on a drawing, and reproducing it means an SVG filter on the largest element
 * on the page. Raised with the owner as a deviation.
 */

/* Two compositions, and each carries its own coordinates. The wide one is the
   source's own graph: a left-to-right convergence, three sources into two
   stages into one result. The narrow one is the same six nodes and the same
   six links REDRAWN top-to-bottom, because the wide graph is 872 units of
   mostly-horizontal run and a phone column is 350px — scaled down it renders
   its nodes at 40px wide with 3px of bar in them. The link curves turn with
   it: the wide bezier reaches sideways by 62 units, the narrow one reaches
   down by 42. */
const LINKS = [[0, 3], [1, 3], [1, 4], [2, 4], [3, 5], [4, 5]];

/* The source's NODES, NW/NH and path() verbatim, so the wide composition is
   the authored drawing rather than a redrawing of it. */
const NW = 176, NH = 76;
const W_NODES = [[0, 62], [0, 222], [0, 382], [292, 142], [292, 302], [584, 222]].map(([x, y], i) => ({
  x, y, w: NW, h: NH, rx: 13,
  bx: x + 18, by: y + (NH - 22) / 2, box: 22, boxRx: 7, chk: 13,
  barX: x + 54,
  b1y: y + 27, b1h: 8, b1w: [86, 70, 94, 78, 88, 96][i],
  b2y: y + 43, b2h: 6, b2w: [48, 56, 42, 50, 44, 58][i],
}));
const wPath = (a, b) => {
  const n1 = W_NODES[a], n2 = W_NODES[b];
  const x1 = n1.x + NW, y1 = n1.y + NH / 2, x2 = n2.x, y2 = n2.y + NH / 2;
  return `M${x1} ${y1} C${x1 + 62} ${y1} ${x2 - 62} ${y2} ${x2} ${y2}`;
};

/* Three across, two across, one — the same topology stood on end. */
const N_NODES = [
  { x: 0, y: 0, w: 96, pad: 10, box: 16, chk: 10, ig: 8, b1h: 6, b2h: 5, b1w: 40, b2w: 24 },
  { x: 108, y: 0, w: 96, pad: 10, box: 16, chk: 10, ig: 8, b1h: 6, b2h: 5, b1w: 34, b2w: 26 },
  { x: 216, y: 0, w: 96, pad: 10, box: 16, chk: 10, ig: 8, b1h: 6, b2h: 5, b1w: 44, b2w: 22 },
  { x: 0, y: 170, w: 140, pad: 12, box: 18, chk: 11, ig: 10, b1h: 7, b2h: 5, b1w: 64, b2w: 36 },
  { x: 172, y: 170, w: 140, pad: 12, box: 18, chk: 11, ig: 10, b1h: 7, b2h: 5, b1w: 72, b2w: 32 },
  { x: 66, y: 340, w: 180, pad: 14, box: 20, chk: 12, ig: 12, b1h: 8, b2h: 6, b1w: 80, b2w: 48 },
].map((n) => {
  const h = 64, tot = n.b1h + 6 + n.b2h, top = n.y + (h - tot) / 2;
  return {
    ...n, h, rx: 11,
    bx: n.x + n.pad, by: n.y + (h - n.box) / 2, boxRx: n.box / 3,
    barX: n.x + n.pad + n.box + n.ig,
    b1y: top, b2y: top + n.b1h + 6,
  };
});
const nPath = (a, b) => {
  const n1 = N_NODES[a], n2 = N_NODES[b];
  const x1 = n1.x + n1.w / 2, y1 = n1.y + n1.h, x2 = n2.x + n2.w / 2, y2 = n2.y;
  return `M${x1} ${y1} C${x1} ${y1 + 42} ${x2} ${y2 - 42} ${x2} ${y2}`;
};

const CHECK = 'M2.5 6.4 L4.9 8.7 L9.5 3.5';
const COUNT = Array.from({ length: 25 }, (_, n) => n);

const W = {
  cls: 'bg-wide', idp: 'w', viewBox: '0 0 872 700', win: { w: 872, h: 700, rx: 26 },
  nodes: W_NODES, path: wPath, pulseR: 5,
  /* scale(0.96) about the 760x520 graph's centre, folded into one transform:
     56 + 380*(1-0.96) = 71.2, and 90 + 260*(1-0.96) = 100.4. */
  graph: 'translate(71.2 100.4) scale(0.96)',
  ring: { x: 584 - 14, y: 222 - 14, w: NW + 28, h: NH + 28, rx: 20, sw: 2 },
  head: {
    h: 66, dotR: 6, dots: [32, 54, 76], dotY: 33,
    mark: { x: 102, y: 25, s: 16, rx: 5 }, bar: { x: 130, y: 31, w: 132, h: 8 },
    blip: { cx: 737.5, cy: 33, r: 4.5 },
    count: { x: 754, y: 22, w: 26, lh: 22 }, rbar: { x: 792, y: 30, w: 54, h: 7 },
  },
  foot: { track: { x: 26, y: 672, w: 698, h: 5 }, dot: { x: 740, y: 671, w: 22, h: 7, step: 28 } },
};
const N = {
  cls: 'bg-narrow', idp: 'n', viewBox: '0 0 360 528', win: { w: 360, h: 528, rx: 14 },
  nodes: N_NODES, path: nPath, pulseR: 4,
  graph: 'translate(24 64)',
  ring: { x: 66 - 12, y: 340 - 12, w: 180 + 24, h: 64 + 24, rx: 17, sw: 2 },
  head: {
    h: 44, dotR: 4, dots: [16, 30, 44], dotY: 22,
    mark: { x: 60, y: 16, s: 12, rx: 4 }, bar: { x: 78, y: 19, w: 60, h: 6 },
    blip: { cx: 272.5, cy: 22, r: 3.5 },
    count: { x: 286, y: 13, w: 22, lh: 18 }, rbar: { x: 318, y: 20, w: 30, h: 5 },
  },
  foot: { track: { x: 12, y: 506, w: 247, h: 5 }, dot: { x: 269, y: 505, w: 16, h: 7, step: 21 } },
};

const label =
  'Six steps of a process appear one by one inside a clean window, connections draw ' +
  'themselves between the steps until the whole path is joined, the system starts running ' +
  'on its own with work pulsing along the path and a counter climbing, and then every step ' +
  'checks itself off and the final step completes.';
---

<figure class="build-graphic">
  {[W, N].map((c) => (
    <svg class={`bg-plate ${c.cls}`} viewBox={c.viewBox} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
      <defs>
        <clipPath id={`bg-count-clip-${c.idp}`}>
          <rect x={c.head.count.x} y={c.head.count.y} width={c.head.count.w} height={c.head.count.lh} />
        </clipPath>
      </defs>

      <rect class="bg-win" x="0" y="0" width={c.win.w} height={c.win.h} rx={c.win.rx} />

      {/* ---------- window chrome ---------- */}
      {c.head.dots.map((cx, i) => (
        <circle class={i === 0 ? 'bg-tl bg-tl-on' : 'bg-tl'} cx={cx} cy={c.head.dotY} r={c.head.dotR} />
      ))}
      <rect class="bg-mark" x={c.head.mark.x} y={c.head.mark.y} width={c.head.mark.s} height={c.head.mark.s} rx={c.head.mark.rx} />
      <rect class="bg-bar" x={c.head.bar.x} y={c.head.bar.y} width={c.head.bar.w} height={c.head.bar.h} rx={c.head.bar.h / 2} />

      {/* The blip is the only thing in the drawing that never stops: it is the
          system still being up, and it runs on wall-clock time rather than on
          the 9.4s composition, exactly as the source's |sin(T*2.1)| does. */}
      <circle class="bg-blip" cx={c.head.blip.cx} cy={c.head.blip.cy} r={c.head.blip.r} />

      <g clip-path={`url(#bg-count-clip-${c.idp})`}>
        <g class="bg-count">
          {COUNT.map((n) => (
            <text class="bg-countn" x={c.head.count.x + c.head.count.w} y={c.head.count.y + n * c.head.count.lh + c.head.count.lh / 2}>{n}</text>
          ))}
        </g>
      </g>
      <rect class="bg-bar bg-bar-q" x={c.head.rbar.x} y={c.head.rbar.y} width={c.head.rbar.w} height={c.head.rbar.h} rx={c.head.rbar.h / 2} />
      <rect class="bg-hr" x="0" y={c.head.h} width={c.win.w} height="1" />

      {/* ---------- the graph ---------- */}
      <g transform={c.graph}>
        {LINKS.map(([a, b], i) => {
          const d = c.path(a, b);
          return (
            <g>
              <path class={`bg-link bg-link-${i}`} d={d} pathLength="1" />
              <path class={`bg-glow bg-glow-${i}`} d={d} />
            </g>
          );
        })}

        {/* Pulses last inside the graph so they ride over the links. */}
        <g class="bg-pulses">
          {LINKS.map(([a, b], i) => (
            <circle
              class={`bg-pulse bg-pulse-${i}`}
              cx="0" cy="0" r={c.pulseR}
              style={`offset-path: path('${c.path(a, b)}')`}
            />
          ))}
        </g>

        {c.nodes.map((n, i) => {
          const last = i === 5;
          const co = (n.box - n.chk) / 2;
          return (
            <g class={`bg-n${i}`}>
              <g class="bg-node">
                <rect class="bg-nodebg" x={n.x} y={n.y} width={n.w} height={n.h} rx={n.rx} />
                {last && <rect class="bg-fill5" x={n.x} y={n.y} width={n.w} height={n.h} rx={n.rx} />}
                {last && <rect class="bg-edge5" x={n.x} y={n.y} width={n.w} height={n.h} rx={n.rx} />}

                <g class="bg-pop">
                  <rect class="bg-box" x={n.bx} y={n.by} width={n.box} height={n.box} rx={n.boxRx} />
                  <rect class={last ? 'bg-boxfill bg-boxfill-alt' : 'bg-boxfill'} x={n.bx} y={n.by} width={n.box} height={n.box} rx={n.boxRx} />
                  <g transform={`translate(${n.bx + co} ${n.by + co}) scale(${n.chk / 12})`}>
                    <path class={last ? 'bg-check bg-check-alt' : 'bg-check'} d={CHECK} pathLength="1" />
                  </g>
                </g>

                {/* The last node's bars cross-fade to the light set at the
                    moment its fill passes 0.4, which is what the source's
                    `done > 0.4` ternary does in one frame. */}
                <rect class={last ? 'bg-nbar bg-swap-out' : 'bg-nbar'} x={n.barX} y={n.b1y} width={n.b1w} height={n.b1h} rx={n.b1h / 2} />
                <rect class={last ? 'bg-nbar bg-nbar2 bg-swap-out' : 'bg-nbar bg-nbar2'} x={n.barX} y={n.b2y} width={n.b2w} height={n.b2h} rx={n.b2h / 2} />
                {last && <rect class="bg-nbar-lt bg-swap-in" x={n.barX} y={n.b1y} width={n.b1w} height={n.b1h} rx={n.b1h / 2} />}
                {last && <rect class="bg-nbar-lt bg-nbar2 bg-swap-in" x={n.barX} y={n.b2y} width={n.b2w} height={n.b2h} rx={n.b2h / 2} />}
              </g>
            </g>
          );
        })}

        <rect class="bg-ring" x={c.ring.x} y={c.ring.y} width={c.ring.w} height={c.ring.h} rx={c.ring.rx} />
      </g>

      {/* ---------- progress and the four scene dots ---------- */}
      <rect class="bg-track" x={c.foot.track.x} y={c.foot.track.y} width={c.foot.track.w} height={c.foot.track.h} rx={c.foot.track.h / 2} />
      <rect class="bg-prog" x={c.foot.track.x} y={c.foot.track.y} width={c.foot.track.w} height={c.foot.track.h} rx={c.foot.track.h / 2} />
      {[0, 1, 2, 3].map((i) => (
        <rect
          class={i === 0 ? 'bg-dot bg-dot-on' : `bg-dot bg-dot-${i}`}
          x={c.foot.dot.x + i * c.foot.dot.step}
          y={c.foot.dot.y} width={c.foot.dot.w} height={c.foot.dot.h} rx={c.foot.dot.h / 2}
        />
      ))}
    </svg>
  ))}
</figure>

<style>
  /* ============================================================
     Drawing-space type. Landmine 17. The only text in this drawing is the
     counter, so --fs-fig is the one role with a consumer; there is no label
     and no name here. Rendered size = value x (rendered width / viewBox
     width), and the column is min(1100, 100vw-40) with the plate capped at
     900px wide.

       vw    svg px   scale    --fs-fig
       1440   900.0   1.0321   11 -> 11.35px
        940   900.0   1.0321   11 -> 11.35px
        900   860.0   0.9862   11 -> 10.85px
        821   781.0   0.8956   11 ->  9.85px
        820   780.0   0.8945   13 -> 11.63px
        700   660.0   0.7569   13 ->  9.84px
        641   601.0   0.6892   13 ->  8.96px
       ---- narrow, 360u canvas capped at 390px ----
        640   390.0   1.0833   11 -> 11.92px
        390   350.0   0.9722   11 -> 10.69px

     8.96-11.92px across every width. The 641-820 bump is needed because a
     single value cannot span the whole range: the band needs >= 8/0.6892 =
     11.61 at the bottom and <= 12/1.0321 = 11.63 at the top, which is a
     0.02-unit window and not a thing to rely on.
     ============================================================ */
  .bg-wide   { --fs-fig: 11px; max-width: 900px; --dot-off: .3182; --cl: 22px; }
  @media (max-width: 820px) { .bg-wide { --fs-fig: 13px; } }
  .bg-narrow { --fs-fig: 11px; max-width: 390px; --dot-off: .3125; --cl: 18px; }

  /* The scene dots grow from their off width to their on width, so the ratio
     differs between compositions (7/22 and 5/16) while one keyframe serves
     both. --cl is the counter's line pitch, and it is per-composition for a
     containment reason rather than a typographic one: the counter is a column
     of 25 numerals behind a one-line clip, so at the wide pitch it is 550
     units tall and the narrow canvas is only 528. Double-clipped, it never
     painted outside — but geometry that leaves its own canvas is the thing
     that broke the hero graphic on phones, and it should not be there to be
     found. At 18 the column ends at 461, inside the window. */

  /* ⚠️ 900px, not the 1100px .wrap content width the old plate used. The
     source is a 1000x1000 square; at full column width that is 1100px of
     drawing and 1100px of height, which is a screen and a half on a laptop
     and pushes the five service cards above it clean out of view. Cropping
     the square to the window it contains (872x700) and capping at 900 lands
     it at 900x722 — a shade shorter than the 1040x748 plate it replaces at
     the same place on the page, so §02's rhythm is unchanged. */
  .build-graphic { margin: 44px 0 0; }
  .bg-plate { display: block; width: 100%; height: auto; }
  .bg-narrow { display: none; }
  @media (max-width: 640px) {
    .bg-wide   { display: none; }
    .bg-narrow { display: block; }
  }

  /* ---- paint. No hex; every value is a token from global.css. The source's
     C.paper / C.line / C.soft / C.ink map onto the graphite palette exactly as
     they do in RepetitiveGraphic, and its navy accent becomes --color-accent.
     The two source files use different accents, green and navy; the site has
     one, so both drawings land on it. ---- */
  .bg-win  { fill: var(--color-white); stroke: var(--color-rule); stroke-width: 1; }
  .bg-hr   { fill: var(--color-rule); }
  .bg-tl   { fill: var(--color-rule); }
  .bg-tl-on{ fill: var(--color-accent); opacity: .55; }
  .bg-mark { fill: var(--color-accent); opacity: .75; }
  .bg-bar  { fill: var(--color-hair); }
  .bg-bar-q{ opacity: .5; }
  .bg-blip { fill: var(--color-accent); opacity: .9; }
  .bg-countn {
    font-family: var(--font-mono); font-size: var(--fs-fig); font-weight: 500;
    letter-spacing: var(--tracking-mono); fill: var(--color-accent);
    opacity: .9; text-anchor: end; dominant-baseline: central;
  }

  .bg-link { fill: none; stroke: var(--color-hair); stroke-width: 2.2; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .bg-glow { fill: none; stroke: var(--color-accent); stroke-width: 2.2; opacity: .45; }
  .bg-pulse { fill: var(--color-accent); }
  /* The pulses are motion and nothing else, so they rest invisible: the
     finished frame is a joined graph, not a graph with dots parked on it. */
  .bg-pulses { opacity: 0; }

  .bg-nodebg { fill: var(--color-white); stroke: var(--color-rule); stroke-width: 1; }
  .bg-fill5  { fill: var(--color-accent); }
  .bg-edge5  { fill: none; stroke: var(--color-accent); stroke-width: 1; }
  .bg-node   { transform-box: fill-box; transform-origin: center; }
  .bg-pop    { transform-box: fill-box; transform-origin: center; }
  .bg-box     { fill: none; stroke: var(--color-hair); stroke-width: 1.5; }
  .bg-boxfill { fill: var(--color-accent); stroke: var(--color-accent); stroke-width: 1.5; }
  .bg-check   { fill: none; stroke: var(--color-white); stroke-width: 1.9;
                stroke-linecap: round; stroke-linejoin: round;
                stroke-dasharray: 1; stroke-dashoffset: 0; }
  /* Node 06 inverts: a light box with an accent check, because by then it is
     sitting on the accent fill rather than on the window. */
  .bg-boxfill-alt { fill: var(--color-white); stroke: var(--color-white); }
  .bg-check-alt   { stroke: var(--color-accent); }
  .bg-nbar   { fill: var(--color-rule); }
  .bg-nbar2  { opacity: .55; }
  .bg-nbar-lt { fill: var(--color-white); opacity: .92; }
  .bg-nbar-lt.bg-nbar2 { opacity: .5; }

  .bg-ring  { fill: none; stroke: var(--color-accent); stroke-width: 2; opacity: 0;
              transform-box: fill-box; transform-origin: center; }
  .bg-track { fill: var(--color-rule); }
  .bg-prog  { fill: var(--color-accent); opacity: .75;
              transform-box: fill-box; transform-origin: left center; }
  .bg-dot   { fill: var(--color-accent); opacity: .8;
              transform-box: fill-box; transform-origin: left center; }

  /* ---- the resting state IS the finished frame ----
     No motion and the drawing sits where the loop ends: every node placed and
     ticked, every link drawn and lit, node 06 filled, the counter on 24 and
     the progress bar full. Every from-state lives inside a keyframe, so a
     dropped declaration renders this rather than an empty window.
     Landmine 22. */
  .bg-swap-out { opacity: 0; }
  .bg-count { transform: translateY(calc(var(--cl) * -24)); }

  @media (prefers-reduced-motion: no-preference) {
    /* ⚠️ Longhands only, as in RepetitiveGraphic. Nothing here needs a
       timeline, so landmine 22's exact failure cannot bite this file — but
       the two drawings are read together and a shorthand here would be the
       thing someone copies into a file where it does. */
    .bg-node, .bg-link, .bg-glow, .bg-boxfill, .bg-check, .bg-pop,
    .bg-fill5, .bg-edge5, .bg-swap-in, .bg-swap-out,
    .bg-ring, .bg-prog, .bg-dot-1, .bg-dot-2, .bg-dot-3,
    .bg-count, .bg-pulses {
      animation-duration: 9.4s;
      animation-iteration-count: infinite;
      animation-fill-mode: both;
      animation-timing-function: cubic-bezier(.215, .61, .355, 1);
    }
    /* The counter and the progress bar are the two things the source runs on
       easeInOutCubic. The counter also steps rather than sliding. */
    .bg-prog  { animation-timing-function: cubic-bezier(.645, .045, .355, 1); }
    .bg-count { animation-timing-function: steps(1, end); }
    /* Instant switches, not eased ones: the source tests `T > cue`. */
    .bg-dot-1, .bg-dot-2, .bg-dot-3, .bg-swap-in, .bg-swap-out, .bg-pulses {
      animation-timing-function: steps(1, end);
    }

    .bg-n0 .bg-node { animation-name: bg-node-0; }
    .bg-n1 .bg-node { animation-name: bg-node-1; }
    .bg-n2 .bg-node { animation-name: bg-node-2; }
    .bg-n3 .bg-node { animation-name: bg-node-3; }
    .bg-n4 .bg-node { animation-name: bg-node-4; }
    .bg-n5 .bg-node { animation-name: bg-node-5; }

    .bg-link-0 { animation-name: bg-link-0; } .bg-glow-0 { animation-name: bg-glow-0; }
    .bg-link-1 { animation-name: bg-link-1; } .bg-glow-1 { animation-name: bg-glow-1; }
    .bg-link-2 { animation-name: bg-link-2; } .bg-glow-2 { animation-name: bg-glow-2; }
    .bg-link-3 { animation-name: bg-link-3; } .bg-glow-3 { animation-name: bg-glow-3; }
    .bg-link-4 { animation-name: bg-link-4; } .bg-glow-4 { animation-name: bg-glow-4; }
    .bg-link-5 { animation-name: bg-link-5; } .bg-glow-5 { animation-name: bg-glow-5; }

    .bg-n0 .bg-boxfill, .bg-n0 .bg-check { animation-name: bg-tick-0; }
    .bg-n1 .bg-boxfill, .bg-n1 .bg-check { animation-name: bg-tick-1; }
    .bg-n2 .bg-boxfill, .bg-n2 .bg-check { animation-name: bg-tick-2; }
    .bg-n3 .bg-boxfill, .bg-n3 .bg-check { animation-name: bg-tick-3; }
    .bg-n4 .bg-boxfill, .bg-n4 .bg-check { animation-name: bg-tick-4; }
    .bg-n5 .bg-boxfill, .bg-n5 .bg-check { animation-name: bg-tick-5; }
    .bg-n0 .bg-pop { animation-name: bg-pop-0; }
    .bg-n1 .bg-pop { animation-name: bg-pop-1; }
    .bg-n2 .bg-pop { animation-name: bg-pop-2; }
    .bg-n3 .bg-pop { animation-name: bg-pop-3; }
    .bg-n4 .bg-pop { animation-name: bg-pop-4; }
    .bg-n5 .bg-pop { animation-name: bg-pop-5; }

    .bg-fill5    { animation-name: bg-fill5; }
    .bg-edge5    { animation-name: bg-swap-in; }
    .bg-swap-in  { animation-name: bg-swap-in; }
    .bg-swap-out { animation-name: bg-swap-out; }

    .bg-ring  { animation-name: bg-ring; }
    .bg-prog  { animation-name: bg-prog; }
    .bg-count { animation-name: bg-count; }
    .bg-dot-1 { animation-name: bg-dot-1; }
    .bg-dot-2 { animation-name: bg-dot-2; }
    .bg-dot-3 { animation-name: bg-dot-3; }

    .bg-blip {
      animation-name: bg-blip;
      animation-duration: 1.496s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }

    /* The dots only exist where they can actually travel a path. Without
       offset-path they would sit stacked at each curve's start and blink,
       which reads as a bug rather than as no feature. */
    @supports (offset-path: path('M0 0')) {
      .bg-pulses { animation-name: bg-pulsegate; }
      .bg-pulse {
        offset-rotate: 0deg;
        animation-name: bg-pulse;
        animation-duration: 1.5s;
        animation-iteration-count: infinite;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }
      /* i * 0.16 of a 1.5s traverse, so the six dots are spread along the
         graph rather than moving as one rank. */
      .bg-pulse-0 { animation-delay: 0s; }
      .bg-pulse-1 { animation-delay: -.24s; }
      .bg-pulse-2 { animation-delay: -.48s; }
      .bg-pulse-3 { animation-delay: -.72s; }
      .bg-pulse-4 { animation-delay: -.96s; }
      .bg-pulse-5 { animation-delay: -1.2s; }
    }
  }

