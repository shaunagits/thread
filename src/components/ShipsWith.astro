---
import { shipsWith } from '../content/site';

/**
 * What ships with every build.
 *
 * Replaces Fig4CarePlate, which was the last un-refreshed graphic on the page:
 * a boxed table drawn in SVG, with sans-serif body text after the rest of the
 * site moved to serif, and letter-spacing carried as SVG attributes rather than
 * CSS. It also baked its copy into the drawing, so none of it could be selected,
 * searched, or read properly by assistive tech.
 *
 * This is the same information as real text, in the row-and-rule idiom the site
 * already uses. It needs no minimum width, so it fits a phone without the
 * sideways pan the wide plates need.
 *
 * Grouped by tag since 18 Aug 2026. It was one flat list with the tag repeated
 * on every row, which set the right-hand column droning "Included, Included,
 * Included, Optional, Optional" down the page — five rows saying two things.
 * The tag is now a heading over its own set and appears once each, which is
 * also the honest shape of the information: what you always get, and what you
 * can add.
 *
 * Grouping is derived from the data rather than hardcoded, so site.ts stays the
 * single source of both the copy and the order, and a third tag would just work.
 * No copy changed here — see CLAUDE.md on content living in site.ts.
 */

const groups = [...new Set(shipsWith.map((r) => r.tag))].map((tag) => ({
  tag,
  rows: shipsWith.filter((r) => r.tag === tag),
}));
---

<div class="ships">
  <div class="ships-head">Ships with every build</div>

  <div class="ships-sets">
    {groups.map((group) => (
      <div class="ships-group">
      {/* The full stop is the wordmark's, not a drawn circle: `thread.` ends on
          a koa period and so does each label here. A 4px dot at the far end of
          the leader was tried first and read as a stray speck, because it sat
          an entire column away from the word it was meant to punctuate. */}
        <h3 class="ships-label"><span class="ships-word">{group.tag}</span><span class="ships-lead" aria-hidden="true"></span></h3>
        <ul>
          {group.rows.map((row) => <li>{row.item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  /* No max-width: the two sets sit side by side and want the full column. It
     was 640px when they stacked. */
  .ships { margin-top: 40px; }

  .ships-head {
    font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-koa);
    padding-bottom: 14px; border-bottom: 1px solid var(--color-hair);
  }

  /* The two sets side by side, 18 Aug 2026. Stacked, this section ran to five
     rows plus two labels under copy that was already full width, which made §03
     both the tallest thing on the page and a single unbroken left rail. Setting
     Included against Optional halves the height and puts a second axis on the
     page, without making §03 the one section whose copy does not run full
     width — which is what got a side-by-side layout rejected twice before.

     56px and the 1000px collapse are .doc's, not new values. */
  .ships-sets {
    margin-top: 22px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start;
  }
  /* A div, not a <section>. `section { padding: 104px 0; border-top: … }` is a
     global element rule for the page's own sections, and a nested <section>
     silently inherits all of it — 104px of dead space and a stray rule above
     every group. Cost one measurement to find. */
  .ships-group { margin-top: 0; }

  /* Same type as .ships-head one level down, so the two read as a hierarchy
     rather than two competing labels: quiet, not koa, and the rule carries the
     emphasis instead of the colour. */
  .ships-label {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 500;
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--color-quiet); margin-bottom: 4px;
  }
  .ships-lead {
    flex: 1; height: 1px; background: var(--color-rule); position: relative;
  }
  .ships-word::after { content: '.'; color: var(--color-koa); }

  ul { list-style: none; margin: 0; padding: 0; }
  li {
    font-family: var(--font-serif); font-size: var(--text-body); line-height: var(--leading-body);
    color: var(--color-body);
    padding: 13px 0; border-bottom: 1px solid var(--color-rule);
  }
  /* Every set closes on the heavier rule the head opened with, so each column
     reads as an enclosed object rather than a list that stops. Both, not just
     the last: side by side there is no "last" in reading order. */
  .ships-group li:last-child { border-bottom-color: var(--color-hair); }

  /* The sets hold two columns down to 820px rather than collapsing at 1000,
     changed 18 Aug 2026: at 1000 a laptop window that is not maximised drops
     straight back to the single tall column this layout exists to avoid, and
     that is the state the owner saw on production and objected to.

     Between 820 and 1000 the gap tightens to .doc's collapsed value to buy the
     columns width. Measured at 830, the tightest two-column case: 358px
     columns, and every row still sets on one line. 820 is the page's existing
     breakpoint (the plate swaps composition there); no new value is
     introduced. */
  @media (max-width: 1000px) {
    .ships-sets { gap: 34px; }
  }
  @media (max-width: 820px) {
    .ships-sets { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
