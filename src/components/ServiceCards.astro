---
import { services } from '../content/site';

/**
 * The four services as a 2×2 card grid, chosen by the owner 19 Aug 2026 with
 * the editorial-index layout for §02. Replaces ServiceList's numbered rows
 * (recover from git if rows return): §02 is stacked rows of type now, so the
 * services take the other shape, bounded cards on a grid.
 *
 * Cards use the tokens that already mean "card": --color-white surfaces on
 * the paper ground with a --color-rule hairline. Titles are h3 on the scale,
 * meta stays micro/faint like every caption on the site. The two service
 * cards deleted on 17 Aug 2026 died for saying what §01's drawing already
 * said, not for being cards; these carry the durations and terms, which the
 * drawing does not.
 *
 * A new component pattern, reserved for the owner by the build rules; the
 * owner made the call when picking this layout.
 */
---

<div class="cards">
  {services.map((service) => (
    <div class="card">
      <h3>{service.title}</h3>
      <p>{service.body}</p>
      {/* One term per line, like the old meta column. Joined with " · " these
          wrapped mid-phrase inside a card's width ("HUMAN REVIEW BUILT / IN"),
          which the screenshot pass caught. */}
      <p class="card-meta">
        {service.meta.map((line, j) => (
          <>{j > 0 && <br />}{line}</>
        ))}
      </p>
    </div>
  ))}
</div>

<style>
  .cards {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px; margin-top: 44px;
  }
  .card {
    display: flex; flex-direction: column;
    background: var(--color-white);
    border: 1px solid var(--color-rule);
    padding: 34px;
  }
  .card h3 {
    margin-bottom: 12px;
    font-size: var(--text-d3); line-height: var(--leading-tight);
  }
  .card p {
    font-family: var(--font-serif); font-size: var(--text-body);
    line-height: var(--leading-body); color: var(--color-body);
  }
  /* Bottom-aligned across the row so the metas read as one line of ledger
     even when the bodies run different lengths. */
  .card-meta {
    margin-top: auto; padding-top: 22px;
    font-family: var(--font-mono); font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--color-faint); line-height: 1.9;
  }

  @media (max-width: 820px) {
    .cards { grid-template-columns: 1fr; gap: 22px; margin-top: 40px; }
    .card { padding: 28px; }
  }
</style>
