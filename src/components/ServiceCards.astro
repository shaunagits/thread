---
import { services } from '../content/site';

/**
 * The five build types, as a six-column grid: three cards spanning two on the
 * first row, two spanning three on the second.
 *
 * Rebuilt 29 Aug 2026 for the Style C redesign. It was a 2×2 grid of four
 * cards on the paper ground with a pale hairline and a meta column of
 * durations. Three things changed and each is deliberate:
 *
 *  - Five cards, not four, so the grid is 6/2/2/2 + 3/3 rather than 2×2. The
 *    second row's wider cards give the two longest titles the room to set on
 *    one line ("Customer or employee portal").
 *  - The meta column is gone. The design draws no durations; see the note over
 *    `services` in site.ts for what was dropped and where to recover it.
 *  - The number moved out of the card and onto its top edge, as a filled tab
 *    that breaks the border. That is what makes five bounded rectangles read
 *    as a numbered set rather than as five separate panels.
 *
 * The cards sit on the wash, so their ground is --color-paper rather than
 * --color-white: on the wash, white cards read as lit and the paper reads as
 * the same sheet with an edge drawn round it, which is the drawing's language.
 */
---

<ol class="cards">
  {services.map((service, i) => (
    <li class={`card span-${service.span}`}>
      <span class="tab">{String(i + 1).padStart(2, '0')}</span>
      <h3>{service.title}</h3>
      <p>{service.body}</p>
    </li>
  ))}
</ol>

<style>
  .cards {
    list-style: none; margin: 56px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 30px;
  }
  .span-2 { grid-column: span 2; }
  .span-3 { grid-column: span 3; }

  .card {
    position: relative;
    background: var(--color-paper);
    border: 1px solid var(--color-ink);
    padding: 30px;
  }

  /* Sits astride the top border rather than inside the card. -16px is half the
     tab's own height plus its border, so the border passes through its middle;
     22px from the left puts it clear of the corner without lining up with the
     30px text inset, which would read as a mistake rather than a tab. */
  .tab {
    position: absolute; top: -16px; left: 22px;
    font-family: var(--font-mono); font-weight: 500; font-size: var(--text-btn);
    background: var(--color-ink); color: var(--color-white);
    padding: 3px 10px;
  }

  /* 14px of clearance under the tab before the title starts. */
  .card h3 { margin: 14px 0 10px; }
  .card p {
    font-family: var(--font-serif); font-size: var(--text-ui);
    line-height: var(--leading-body); color: var(--color-body);
  }

  /* Two up rather than three, so the cards keep a readable measure before they
     go single file. The spans have to be overridden together or a span-3 card
     would take the full row while the span-2s pair up. */
  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; }
    .span-2, .span-3 { grid-column: span 1; }

    /* The last row always fills the width, whether it holds one card or two.
       With an odd number of cards the final one would otherwise sit at half
       width against empty space, which reads as a missing sixth card rather
       than as the end of the set.

       Written as :last-child:nth-child(odd) rather than against the fifth
       card specifically, so it keeps working if the number of build types
       changes — which it already has once, from four to five. */
    .card:last-child:nth-child(odd) { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; gap: 22px; margin-top: 44px; }
    .card { padding: 26px; }
    /* Must be reset explicitly. `span 2` in a single-column grid does not
       clamp — it creates an implicit second column and the last card breaks
       the layout it was meant to tidy. */
    .card:last-child:nth-child(odd) { grid-column: auto; }
  }
</style>
