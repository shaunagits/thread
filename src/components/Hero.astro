---
import HeroGraphic from './HeroGraphic.astro';
import { cta, ctaHref } from '../content/site';
---
<section class="hero ruled ruled-fade" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {/* "Put your busywork on autopilot." since 29 Aug 2026, on the owner's
          instruction, replacing "Turn busywork into software." from earlier the
          same day and "Built around how you already work." before that.
          Duplicated by hand in og.astro; the two must always agree or the share
          card outlives the page edit in every already-scraped cache. */}
      <h1>Put your busywork on autopilot.</h1>

      {/* Three parts now: headline, subtitle, button. Cut back on the owner's
          instruction, same day, from four blocks of copy.

          What went, and where it survives, so neither is rewritten from
          scratch if it comes back:

          The problem paragraph ("Your team shouldn't spend their week copying
          data, updating spreadsheets, chasing information...") named four
          specific symptoms. §01's signal list names seven of them one scroll
          down, so the hero was doing that section's job in a paragraph.

          ⚠️ The signature line ("Custom software, built in Honolulu, Hawaiʻi.")
          went with it, and that was the last mention of the location above the
          fold. The eyebrow that used to carry it was already dropped by the
          Style C redesign. The place still appears in the contact section, in
          both footer rows and in the ProfessionalService schema, so it is not
          gone from the page — but nothing on the first screen now says where
          this business is. Raised with the owner. */}
      <p class="claim claim-sm hero-promise">
        I build custom software that does that work for you.
      </p>

      {/* One button, not two. The ghost "See how it works" pointed at /#how,
          and that section no longer exists — the page runs three sections now.
          A single CTA also stops the hero offering a choice before it has
          made its case. */}
      <div class="btn-row">
        <a href={ctaHref} class="btn">{cta}</a>
      </div>
    </div>
    <div class="hero-figure"><HeroGraphic /></div>
  </div>
</section>

<style>
  /* The graphic column is the wider of the two: the drawing is the thing that
     explains "busywork into software" faster than the copy can. */
  .hero-grid {
    display:grid; grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
    gap:clamp(34px, 5vw, 64px); align-items:center;
  }

  /* 17ch. "Put your busywork on autopilot." sets as two even lines at this
     measure — "Put your busywork / on autopilot." — with no widow, because
     the first line is exactly 17 characters. Same measure suited the previous
     headline for the same reason; it is not a coincidence worth relying on,
     so re-check the break if the headline changes again. */
  .hero-copy h1 { max-width:17ch; margin:0 0 18px; }

  /* Margin-free: .btn-row's own 34px top margin is the only gap between the
     subtitle and the button now that nothing sits between them. */
  .hero-promise { max-width:40ch; margin:0; }

  .hero-figure { width:100%; max-width:680px; justify-self:end; }

  /* Two columns down to 820px, the same breakpoint at which HeroGraphic swaps
     to its narrow composition. They used to disagree: the grid stacked at
     1000px while the drawing stayed wide until 820, so between those two
     widths the page showed a letterboxed wide diagram under the copy. */
  @media (max-width:820px) {
    .hero-grid { grid-template-columns:1fr; gap:40px; }
    .hero-figure { max-width:680px; justify-self:start; }
  }
  @media (max-width:640px) { section.hero { padding:56px 0 72px; } }
  @media (max-width:420px) {
    .btn-row { flex-direction:column; align-items:stretch; width:100%; }
    .btn-row a { text-align:center; }
  }
</style>
