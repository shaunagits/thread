---
import HeroGraphic from './HeroGraphic.astro';
---

<section class="hero" id="top">
  <div class="wrap">
    {/* Deliberate deviation from index.html's hero, decided with the owner
        14 Aug 2026. The original stacked a full-width plate under the copy,
        which put it below the fold on a laptop — and this graphic animates on
        load and rotates continuously, so below the fold spends both for
        nothing. Copy and graphic now share the row. Recorded in CLAUDE.md.

        The margin note was cut entirely on the same date, second pass. It
        restated the lead and pre-explained the systems map, which §04 already
        carries in full. The hero is now label, headline, one paragraph, two
        buttons, and nothing else. Don't reintroduce a note here without
        checking §04 doesn't already say it. */}
    <div class="doc hero-doc">
      <div class="hero-copy">
        {/* The place name is held together so the wrap falls at the ·. The
            eyebrow needs 399px on one line and no phone gives it that, so it
            always wraps — this only decides where. Unwrapped, it orphans
            "Hawaiʻi" onto a second line and splits the place name. */}
        <div class="eyebrow">Custom software and automation · <span class="eyebrow-place">Honolulu, Hawaiʻi</span></div>
        {/* `auto` rather than `0` for the inline margins so the centring in
            the stacked layout below can take hold. It changes nothing above
            1000px: the 19ch cap never binds there, the box already fills its
            grid column, and auto margins on a full-width box resolve to 0. */}
        <h1 style="margin:20px auto 22px;max-width:19ch">
          Software that brings your business together.
        </h1>
        <p class="lead" style="max-width:54ch">
          Thread builds software that fits how your business already works.
          Not the other way around.
        </p>
        {/* PLACEHOLDER DESTINATION. The owner has a scheduling link but hasn't
            supplied it yet, so the primary CTA points at the contact form in
            the meantime. Swap the href for the booking URL when it lands.
            Tracked in LAUNCH-CHECKLIST.md §8. */}
        <div class="btn-row">
          <a href="#contact" class="btn">Book a call</a>
          <a href="#how" class="btn-ghost">See how it works</a>
        </div>
      </div>

      {/* Not wrapped in Figure.astro and deliberately uncaptioned: this is the
          hero graphic, not a numbered plate. The numbered figures start in §01. */}
      <div class="hero-figure">
        <HeroGraphic compact />
      </div>
    </div>
  </div>
</section>

<style>
  /* Two columns weighted toward the copy, both flexible, so the pair reflows
     smoothly through the 1000–1180 band instead of squeezing the headline
     against a fixed 400px rail. */
  .hero-doc {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  /* The graphic is drawn at 360 units. Past about 440px it starts to look
     inflated next to the type, so cap it and hang it off the right edge. */
  .hero-figure { max-width: 440px; margin-left: auto; width: 100%; }

  /* global.css collapses `.doc` to one column here, but `.hero-doc` is more
     specific and is not itself inside a media query, so it would keep winning.
     Restate it. Breakpoint is the original's, verbatim. */
  @media (max-width: 1000px) {
    .hero-doc { grid-template-columns: 1fr; gap: 34px; }
    .hero-figure { max-width: 420px; }

    /* Centred once the grid collapses, agreed with the owner 14 Aug 2026.

       Stacked, every element keeps a measure far narrower than the column it
       now sits in — at 834 the copy left 265–531px of empty space against 40
       on the left, and the 420px graphic left 374. Flush left under that much
       slack reads as a two-column layout with the right column missing.

       Centring the text alone isn't enough: h1 and .lead are capped at 19ch
       and 54ch, so their *boxes* stay pinned left and only the ink inside
       them would move. The auto inline margins centre the boxes; text-align
       centres the ink within them. Both are needed. */
    .hero-copy { text-align: center; }
    .hero-copy .lead { margin-inline: auto; }
    .hero-copy .btn-row { justify-content: center; }
    .hero-figure { margin-inline: auto; }
  }

  .eyebrow-place { white-space: nowrap; }

  /* ============================================================
     Phones — agreed with the owner 14 Aug 2026.

     Two deliberate deviations from index.html, which is otherwise still
     binding for spacing and layout. Both are phone-only; nothing at or
     above 641px moves.
     ============================================================ */

  /* 1. `section.hero` in global.css is class+element, so the 66px that the
     `section` rule hands every other section at this breakpoint loses to the
     hero's 76px and the hero alone keeps desktop spacing on a phone. Stacked
     on the 71px header that put 147px — 17% of a 390x844 viewport — above
     the first word. Only the top is cut; the bottom keeps the section rhythm
     into the connects strip. */
  @media (max-width: 640px) {
    section.hero { padding-top: 36px; }
  }

  /* 2. Content-width CTAs stack ragged once the row stops fitting — 131px
     above 165px, left aligned, which reads as an accident rather than a
     choice. They also only just fit between 360 and 390, so any change to
     either label re-breaks it. Below 420 they go full width instead. */
  @media (max-width: 420px) {
    /* align-items must be restated: global .btn-row sets `center`, which in
       a column flex centres on the horizontal axis and defeats the stretch. */
    .btn-row { flex-direction: column; align-items: stretch; }
    .btn-row .btn, .btn-row .btn-ghost { text-align: center; }
  }

  /* ============================================================
     Entry — CSS only. No JavaScript, no library, no SMIL.

     Runs once on load rather than on scroll. The hero is above the fold,
     so `animation-timeline: view()` is already past its trigger on first
     paint and would never run — same reasoning as HeroGraphic.astro.

     Copy leads, graphic assembles alongside it: the four copy elements
     resolve by ~0.96s, the graphic's bars land at 1.15s. Nothing here
     moves more than 12px, and nothing waits on anything above it.

     No classes in the markup — Astro scopes these selectors to this
     component, so `h1` and `.lead` reach the hero's and nobody else's.
     ============================================================ */
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px) }
    to   { opacity: 1; transform: none }
  }

  /* The headline alone resolves out of a slight blur. It's the one element
     large enough to carry it — at 14px the same effect reads as a font
     failing to load rather than as an intention. */
  @keyframes hero-focus {
    from { opacity: 0; transform: translateY(12px); filter: blur(5px) }
    to   { opacity: 1; transform: none; filter: blur(0) }
  }

  @media (prefers-reduced-motion: no-preference) {
    .eyebrow, h1, .lead, .btn-row {
      opacity: 0;
      animation: hero-rise .62s cubic-bezier(.16, 1, .3, 1) forwards;
    }
    .eyebrow { animation-delay: .04s }
    h1       { animation: hero-focus .8s cubic-bezier(.16, 1, .3, 1) forwards .1s }
    .lead    { animation-delay: .22s }
    .btn-row { animation-delay: .34s }
  }
</style>
