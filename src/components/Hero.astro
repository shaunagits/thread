---
import HeroGraphic from './HeroGraphic.astro';
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">More than a website</div>
      <h1>Software that brings your business together.</h1>
      <p class="lead">Thread connects the tools you use and builds what they cannot.</p>
      <div class="btn-row"><a href="#contact" class="btn">Book a call</a><a href="#how" class="btn-ghost">See how it works</a></div>
    </div>
    <div class="hero-figure"><HeroGraphic /></div>
  </div>
</section>
<style>
  .hero-grid { display:grid; grid-template-columns:minmax(0,.92fr) minmax(480px,1.08fr); gap:clamp(36px, 5vw, 72px); align-items:center; }
  .hero-copy h1 { max-width:13ch; margin:18px 0; font-size:clamp(42px, 4.7vw, 62px); }
  .hero-copy .lead { max-width:42ch; }
  .hero-figure { width:100%; max-width:680px; justify-self:end; }
  @media (max-width:960px) { .hero-grid { grid-template-columns:1fr; gap:40px; } .hero-figure { max-width:680px; justify-self:center; } }
  @media (min-width:641px) and (max-width:960px) { .hero-copy { text-align:center; } .hero-copy h1, .hero-copy .lead { margin-inline:auto; } .hero-copy .btn-row { justify-content:center; } }
  @media (max-width:640px) { section.hero { padding-top:42px; } .hero-copy h1 { font-size:clamp(40px, 12vw, 52px); } }
  @media (max-width:420px) { .btn-row { flex-direction:column; align-items:stretch; width:100%; } .btn-row a { text-align:center; } }
</style>
