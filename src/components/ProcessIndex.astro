---
import { steps } from '../content/site';

/**
 * The process as an editorial index: an oversized display numeral per step,
 * copy beside it, a hairline between rows. Chosen by the owner 19 Aug 2026
 * from four layout options, replacing ProcessTimeline (recover that from git
 * if the spine ever returns). The point of the change: §02 and §03 had both
 * become rows of numbered things on threads and read as the same drawing
 * twice. This section is now typographic and §03 is cards, so they stop
 * rhyming.
 *
 * The numeral is display type on the existing scale — --text-d1, Newsreader,
 * like the h1 — not a new size. It is real text, so it must clear AA for
 * large type (3.0): --color-line at 3.90:1 passes, and the closing step takes
 * --color-koa (6.94:1), which inherits the filled-arrival idea from the old
 * timeline. --color-ochre stays fills-only per landmine 5 and is not used
 * here.
 *
 * This is a new component pattern, which the build rules reserve for the
 * owner; the owner made the call when picking this layout.
 */
---

<ol class="pindex">
  {steps.map((step) => (
    <li class="pi-row">
      {/* The numeral is real content, not decoration — it is the only place
          the step number appears. It printed twice at first, here and in the
          micro label ("01 · Fit call"), which the first screenshot pass
          caught; the label now carries the stage name alone. */}
      <span class="pi-n">{step.n}</span>
      <div class="pi-body">
        <span class="pi-label">{step.label}</span>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .pindex { list-style: none; margin-top: 56px; }

  .pi-row {
    display: grid; grid-template-columns: 140px minmax(0, 1fr);
    gap: 34px; padding: 40px 0; align-items: start;
    border-top: 1px solid var(--color-rule);
  }
  .pi-row:last-child { border-bottom: 1px solid var(--color-rule); }

  .pi-n {
    font-family: var(--font-display); font-size: var(--text-d1);
    line-height: 1; letter-spacing: var(--tracking-tight);
    color: var(--color-line);
  }
  .pi-row:last-child .pi-n { color: var(--color-koa); }

  .pi-label {
    display: block; margin-bottom: 10px;
    font-family: var(--font-mono); font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide); text-transform: uppercase;
    color: var(--color-koa);
  }
  .pi-row h3 {
    margin-bottom: 10px; max-width: 24ch;
    font-size: var(--text-d3); line-height: var(--leading-tight);
  }
  .pi-row p {
    max-width: 52ch; font-family: var(--font-serif); font-size: var(--text-body);
    line-height: var(--leading-body); color: var(--color-body);
  }

  /* From-state inside the keyframes, never in the rule, and longhands rather
     than the animation shorthand — landmine 22 in full. If the declaration is
     ever dropped, the rows render normally instead of staying invisible. */
  @keyframes pi-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .pi-row {
        animation-name: pi-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 12% cover 34%;
      }
    }
  }

  @media (max-width: 820px) {
    .pi-row { grid-template-columns: 88px minmax(0, 1fr); gap: 22px; padding: 34px 0; }
  }
  @media (max-width: 640px) {
    .pindex { margin-top: 40px; }
    /* One column, numeral above the copy. It stays visible: it is the only
       place the step number lives, and at --text-d1's 40px floor it is the
       phone-sized version of the same editorial gesture. */
    .pi-row { grid-template-columns: 1fr; gap: 0; }
    .pi-n { margin-bottom: 12px; }
  }
</style>
