---
import { footerColumns } from '../content/site';

// Built at compile time so the year never goes stale.
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <span class="mark">thread<span class="dot">.</span></span>
        <p class="blurb">
          Custom software and automation for Hawaiʻi businesses.
        </p>
      </div>
      {footerColumns.map((column) => (
        <div>
          {/* h2, not the original's h5: h5 skipped three levels below the
              page's h2 sections. Renders identically. */}
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="foot-bot">
      <span>© {year} Thread · Honolulu, Hawaiʻi</span>
      <span class="foot-legal">
        <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
      </span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--color-ink); color: var(--color-foot-text);
    padding: 64px 0 40px;
  }
  /* Was 2fr 1fr 1fr 1fr for three link columns. The Services and Approach
     columns merged into one on 17 Aug 2026, so the brand block takes the
     space rather than an empty cell being left behind. */
  .foot-grid {
    display: grid; grid-template-columns: 2.2fr 1fr 1fr; gap: 40px;
    padding-bottom: 44px; border-bottom: 1px solid var(--color-foot-rule);
  }
  /* Same mark as the header, same exemption from the scale. */
  .mark {
    font-family: var(--font-wordmark); font-weight: 600; font-size: 24px;
    letter-spacing: -.025em; color: var(--color-paper);
  }
  .mark .dot { color: var(--color-ochre); }
  footer h2 {
    font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-foot-label);
    font-weight: 500; margin-bottom: 15px; line-height: var(--leading-body);
  }
  footer ul { list-style: none; }
  footer li { margin-bottom: 9px; font-size: var(--text-body); }
  footer a { color: var(--color-foot-text); }
  footer a:hover { color: var(--color-foot-link-hover); }
  .foot-bot {
    display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    padding-top: 26px; font-size: var(--text-micro); color: var(--color-foot-label);
  }
  /* Was plain text until Privacy and Terms existed as pages. Kept at the
     bottom bar's muted colour so it doesn't compete with the columns above. */
  .foot-legal a { color: var(--color-foot-label); }
  .foot-legal a:hover { color: var(--color-foot-link-hover); }
  .blurb {
    font-size: var(--text-body); color: var(--color-foot-blurb);
    max-width: 34ch; margin-top: 14px; line-height: var(--leading-body);
  }

  @media (max-width: 1000px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px)  { .foot-grid { grid-template-columns: 1fr; } }
</style>
