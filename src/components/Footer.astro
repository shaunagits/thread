---
import { footerColumns } from '../content/site';

// Built at compile time so the year never goes stale.
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <span class="mark">thread<span class="dot">.</span></span>
        <p class="blurb">
          Custom software, dashboards and automation for Hawaiʻi businesses, built around
          the way the work actually moves.
        </p>
      </div>
      {footerColumns.map((column) => (
        <div>
          {/* h2, not the original's h5: h5 skipped three levels below the
              page's h2 sections. Renders identically. */}
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="foot-bot">
      <span>© {year} Thread · Honolulu, Hawaiʻi</span>
      <span>Privacy · Terms</span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--color-ink); color: var(--color-foot-text);
    padding: 64px 0 40px;
  }
  .foot-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px;
    padding-bottom: 44px; border-bottom: 1px solid var(--color-foot-rule);
  }
  .mark {
    font-family: var(--font-serif); font-weight: 600; font-size: 24px;
    letter-spacing: -.025em; color: var(--color-paper);
  }
  .mark .dot { color: var(--color-ochre); }
  footer h2 {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .15em;
    text-transform: uppercase; color: var(--color-foot-label);
    font-weight: 500; margin-bottom: 15px; line-height: 1.6;
  }
  footer ul { list-style: none; }
  footer li { margin-bottom: 9px; font-size: 13.5px; }
  footer a { color: var(--color-foot-text); }
  footer a:hover { color: var(--color-foot-link-hover); }
  .foot-bot {
    display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    padding-top: 26px; font-size: 12.5px; color: var(--color-foot-label);
  }
  .blurb {
    font-size: 14px; color: var(--color-foot-blurb);
    max-width: 34ch; margin-top: 14px; line-height: 1.6;
  }

  @media (max-width: 1000px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px)  { .foot-grid { grid-template-columns: 1fr; } }
</style>
