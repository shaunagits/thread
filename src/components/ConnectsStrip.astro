---
import { integrations } from '../content/site';
---

<div class="strip">
  <div class="wrap strip-in">
    <span class="strip-lbl">Connects to</span>
    {/* The names are wrapped rather than loose siblings so the phone layout can
        put the tag on its own line and flush the list left beneath it, without
        the tag becoming one more item in the same wrap flow. */}
    <div class="strip-names">
      {integrations.map((name) => <span class="strip-item">{name}</span>)}
    </div>
  </div>
</div>

<style>
  /* Inverted with the Style C redesign, 29 Aug 2026: the strip was a pale wash
     band and is now the ink ground. It is the first hard horizontal on the
     page and it separates the hero's claim from the argument that follows,
     which a wash band 1.06:1 off the paper never did.

     Rules on both edges are ink against ink, so they are invisible by design
     and kept only so the band still resolves if the ground is ever lightened
     again. §01 below carries `noRule` because of them. */
  .strip {
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-ink);
    background: var(--color-ink);
    padding: 22px 0;
  }
  /* 22px. Thirteen names at 28 need about 1200px against the 1100 .wrap gives,
     so "Google Workspace", the widest, orphaned onto a line of its own and read
     as a mistake. The label is now a filled tag rather than loose uppercase, so
     it takes more room than it did, and the names dropped to mono at 15 to pay
     for it. Measured on one line at 1440 and 1180. */
  .strip-in {
    display: flex; align-items: center; gap: 12px 22px;
    flex-wrap: wrap; justify-content: center;
  }
  /* `display: contents` so the thirteen names stay direct participants in the
     strip's own wrap flow at desktop — the wrapper exists for the phone
     layout and must be invisible to the layout everywhere else. */
  .strip-names { display: contents; }
  /* A filled tag, not loose uppercase. It is the only accent fill on the ink
     ground and it is what stops the row reading as thirteen equal words with
     no subject. Paper on accent is 6.65:1. */
  .strip-lbl {
    font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 500;
    letter-spacing: .04em; color: var(--color-white);
    background: var(--color-accent); padding: 3px 8px;
  }
  /* Mono, not the body face. These are product names, which is label work, and
     the mono sets them as a machine-readable list rather than as prose. */
  .strip-item {
    font-family: var(--font-mono); font-size: var(--text-small);
    color: var(--color-foot-text);
  }

  /* On a phone the thirteen names wrap to four rows and the band ran 223px —
     a quarter of the viewport, directly under the hero, before §01 starts.
     Tighter type and less vertical padding pull that back without dropping a
     name.

     The tag takes its own line and the names left-align beneath it. Centred,
     thirteen names wrap into four ragged rows with a different indent each
     time and read as a word cloud; flushed left they read as a list. */
  @media (max-width: 640px) {
    .strip { padding: 20px 0; }
    .strip-in { display: block; }
    .strip-lbl { display: inline-block; margin-bottom: 12px; }
    .strip-names {
      display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: flex-start;
    }
    .strip-item { font-size: var(--text-btn); }
  }
</style>
