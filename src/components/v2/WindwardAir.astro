---
/**
 * The hero animation: a dispatcher assigns an incoming HVAC job. A new card
 * slides into a job list, a cursor opens an assignee menu, picks a tech, and
 * the row flips from Unassigned to Assigned. 12-second loop.
 *
 * Ported verbatim in behaviour from _docs/windward-air-animation.html, supplied
 * by the owner 1 Sep 2026. The motion, the timing constants and the easing are
 * the file's own and were not re-derived. Four things changed on the way in,
 * all mechanical:
 *
 *  1. Every colour is a token. The supplied file hardcoded eighteen hexes, and
 *     "no hardcoded hex in components" is what made this site's last two
 *     palette swaps one-file changes. Its accent was #2E4FBF, which is
 *     --color-accent exactly, so the drawing was already in this palette.
 *  2. Instrument Sans, loaded from Google Fonts, became var(--font-sans).
 *     The site self-hosts its faces; adding a third-party font request to the
 *     hero would be the only such request on the site and would block the
 *     first paint of the largest element on the page. Public Sans carries the
 *     400/500/600 the drawing uses.
 *  3. The stylesheet is `is:global`. The job list is built by the script with
 *     innerHTML, so those cards never receive Astro's scope attribute and a
 *     scoped rule would silently match nothing — the same failure landmine 18
 *     records, and the same fix DashboardPlate already uses. EVERY SELECTOR
 *     HERE MUST STAY `wa-` PREFIXED. There is no scope protecting them.
 *  4. A visually-hidden description and a caption, so the drawing is not a
 *     wall of unreadable text to a screen reader and so nobody mistakes it for
 *     a screenshot of a real client's dashboard.
 *
 * ⚠️ CLIENT JAVASCRIPT, and this is the exception rather than a new rule.
 * CLAUDE.md records that this site ships two lines of client JS. This adds
 * roughly ninety, on the owner's explicit instruction 1 Sep 2026, and only
 * because the animation cannot be expressed in CSS: the cursor path is
 * multi-stop eased interpolation between seven waypoints and the list reflows
 * against it mid-loop. It stays non-interactive — nothing a visitor clicks
 * depends on it, and the page is complete without it.
 *
 * It behaves when it cannot run: prefers-reduced-motion renders a single
 * settled frame and stops, and the loop pauses on visibilitychange so a
 * background tab costs nothing.
 *
 * ⚠️ TYPE INSIDE THE DRAWING IS STAGE-SPACE, NOT PIXELS — landmine 17. The
 * stage is 1080px wide and scaled to its container, so a 27px title renders at
 * 14.0px against HeroV2's 560px cap and 8.4px in the 335px column a 375pt phone
 * leaves. The sizes below are the design's own and are exempt from the type
 * scale for the same reason the SVG drawings are — measured, not guessed, and
 * to be re-measured if the container cap changes.
 *
 * ⚠️ RAISED, NOT FIXED: the frame and cards are drawn with 16-18px corner
 * radii. Every other bounded object on this site is square — .btn, .card, the
 * form fields and the panels all set border-radius: 0 explicitly. Built as
 * supplied rather than silently squared off, per the standing rule about
 * design that looks like a mistake. It is a one-line change if the owner wants
 * it to match.
 */
---

<figure class="wa-fig">
  <div class="wa-embed">
    <div
      class="wa-frame"
      id="waFrame"
      role="img"
      aria-label="A job dispatch board. A new call comes in, a dispatcher assigns it to a technician, and the customer is notified."
    >
      <div class="wa-stage" id="waStage" aria-hidden="true">
        <div class="wa-cam" id="waCam">
          <div class="wa-head">
            <div class="wa-brand-dot"></div>
            <div class="wa-brand">Windward Air</div>
            <div class="wa-spacer"></div>
            <div class="wa-date">Thu, Sep 4</div>
          </div>
          <div class="wa-title-row">
            <div class="wa-h1">Today&rsquo;s jobs</div>
            <div class="wa-spacer"></div>
            <div class="wa-date" id="waCount">5 open</div>
          </div>
          <div class="wa-rule"></div>
          <div id="waList"></div>

          <div class="wa-card" id="waNew">
            <div class="wa-grow">
              <div class="wa-t">AC out, no cooling</div>
              <div class="wa-m">Waipahu &middot; Rodriguez &middot; 92&deg; inside</div>
            </div>
            <div class="wa-right">
              <div class="wa-pillbox">
                <div id="waPillOld" class="wa-pillold">
                  <div class="wa-pill unassigned"><span class="wa-dot"></span>Unassigned</div>
                </div>
                <div id="waPillNew" class="wa-pillnew">
                  <div class="wa-pill assigned">Assigned &middot; Dane</div>
                </div>
              </div>
              <div id="waBtnBox" class="wa-btnbox">
                <div class="wa-btn" id="waBtn">Assign</div>
                <div id="waAvatarWrap" class="wa-avwrap"><div class="wa-av">D</div></div>
              </div>
              <div class="wa-pop" id="waPop">
                <h4>Assign to</h4>
                <div class="wa-row"><div class="wa-av">K</div><div><div class="wa-rn">Kekoa Silva</div><div class="wa-rd">2 jobs today</div></div></div>
                <div class="wa-row"><div class="wa-av">M</div><div><div class="wa-rn">Malia Reyes</div><div class="wa-rd">3 jobs today</div></div></div>
                <div class="wa-row" id="waRow3"><div class="wa-av">D</div><div><div class="wa-rn">Dane Kalili</div><div class="wa-rd">Open now</div></div></div>
              </div>
            </div>
          </div>

          <div class="wa-ring" id="waRing"></div>
        </div>

        <div class="wa-toast" id="waToast">
          <span class="wa-check"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.3 L4.7 9 L10 3.2" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          Assigned to Dane Kalili &middot; arriving 11:15
        </div>

        <div class="wa-cursor" id="waCursor">
          <svg width="34" height="44" viewBox="0 0 24 32" fill="none" aria-hidden="true"><path d="M4 2 L4 25 L10 19.5 L14 28 L18 26 L14 18 L21 17.5 Z" class="wa-cursor-p"/></svg>
        </div>
      </div>
    </div>
  </div>
  {/* ⚠️ NO CAPTION, removed on the owner's instruction 1 Sep 2026. It read
      "An example dispatch board. Not a real customer."

      Worth knowing before anything is built on top of this: "Windward Air",
      its five customers and its three technicians are all invented. That is
      fine for an illustration and the owner has confirmed it, but the drawing
      no longer says so itself. Nothing derived from it — a screenshot, a
      social card, a case study — may present it as a real customer. This site
      deleted a fabricated case study once already. */}
</figure>

<style is:global>
  /* ⚠️ GLOBAL, and every selector is `wa-` prefixed for that reason. See the
     note at the head of this file: the job list is built with innerHTML and
     carries no scope attribute, so scoped rules would match nothing. */
  .wa-fig { margin: 0; }
  .wa-embed { width: 100%; margin: 0 auto; }
  .wa-embed * { box-sizing: border-box; }

  .wa-frame {
    position: relative; width: 100%; aspect-ratio: 1/1; overflow: hidden;
    border-radius: 16px; background: var(--color-paper);
    border: 1px solid var(--color-ink);
  }
  .wa-stage {
    position: absolute; top: 0; left: 0; width: 1080px; height: 1080px;
    transform-origin: 0 0;
    font-family: var(--font-sans);
    color: var(--color-ink); -webkit-font-smoothing: antialiased;
  }
  .wa-cam { position: absolute; inset: 0; transform-origin: 50% 300px; }

  .wa-head { position: absolute; left: 64px; top: 52px; right: 64px; display: flex; align-items: center; }
  .wa-brand-dot { width: 12px; height: 12px; border-radius: 6px; background: var(--color-accent); margin-right: 12px; }
  .wa-brand { font-size: 22px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .wa-spacer { flex: 1; }
  .wa-date { font-size: 20px; color: var(--color-faint); }
  .wa-title-row { position: absolute; left: 64px; top: 110px; right: 64px; display: flex; align-items: baseline; }
  .wa-h1 { font-size: 46px; font-weight: 600; letter-spacing: -.025em; }
  .wa-rule { position: absolute; left: 64px; right: 64px; top: 184px; height: 1px; background: var(--color-rule); }

  .wa-card {
    position: absolute; left: 64px; width: 952px; height: 108px;
    background: var(--color-white);
    border: 1px solid var(--color-rule); border-radius: 18px;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--color-ink) 5%, transparent);
    display: flex; align-items: center; padding: 0 24px;
  }
  .wa-grow { flex: 1; min-width: 0; }
  .wa-t { font-size: 27px; font-weight: 600; letter-spacing: -.015em; }
  .wa-m { font-size: 19px; color: var(--color-faint); margin-top: 6px; }
  .wa-right { display: flex; align-items: center; gap: 14px; position: relative; }

  .wa-pill {
    display: inline-flex; align-items: center; gap: 9px; height: 40px; padding: 0 18px;
    border-radius: 20px; font-size: 18px; font-weight: 500; white-space: nowrap;
  }
  .wa-pill.assigned { background: var(--color-accent); color: var(--color-white); }
  .wa-pill.scheduled { background: var(--color-wash); color: var(--color-quiet); }
  .wa-pill.unassigned { color: var(--color-faint); border: 1.5px solid var(--color-rule); }
  .wa-dot { width: 8px; height: 8px; border-radius: 4px; background: var(--color-hair); }
  .wa-av {
    width: 40px; height: 40px; border-radius: 20px;
    background: var(--color-ink); color: var(--color-white);
    display: flex; align-items: center; justify-content: center;
    font-size: 17px; font-weight: 600;
  }

  .wa-pillbox { position: relative; height: 40px; display: flex; align-items: center; }
  .wa-pillold { display: flex; align-items: center; }
  .wa-pillnew { position: absolute; right: 0; top: 0; transform-origin: 100% 50%; }
  .wa-btnbox { position: relative; height: 44px; }
  .wa-btn {
    position: absolute; inset: 0; border-radius: 22px;
    background: var(--color-accent); color: var(--color-white);
    display: flex; align-items: center; justify-content: center;
    font-size: 19px; font-weight: 600;
  }
  .wa-avwrap { position: absolute; right: 2px; top: 2px; }

  .wa-pop {
    position: absolute; right: 0; top: 78px; width: 320px;
    background: var(--color-white); border: 1px solid var(--color-rule);
    border-radius: 16px;
    box-shadow: 0 24px 60px color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding: 14px 0; transform-origin: 85% 0%; z-index: 5;
  }
  .wa-pop h4 {
    margin: 0 0 10px; padding: 0 18px; font-family: var(--font-sans);
    font-size: 16px; color: var(--color-faint); font-weight: 400;
    letter-spacing: .06em; text-transform: uppercase; line-height: 1.5;
  }
  .wa-row { display: flex; align-items: center; gap: 14px; padding: 11px 18px; }
  .wa-row .wa-av { width: 34px; height: 34px; font-size: 15px; background: var(--color-hair); }
  /* A very light accent tint. Mixed off the token rather than pinned to a hex,
     so it follows the accent through any future palette change. */
  .wa-row.on { background: color-mix(in srgb, var(--color-accent) 7%, var(--color-white)); }
  .wa-row.on .wa-av { background: var(--color-accent); }
  .wa-rn { font-size: 20px; font-weight: 500; }
  .wa-rd { font-size: 16px; color: var(--color-faint); margin-top: 2px; }

  /* The confirmation, and the payoff of the whole loop — it is the moment the
     drawing is actually about. Rebuilt 1 Sep 2026 on the owner's instruction
     because it was easy to miss: it was small (20px in stage space, so under
     10px rendered in the hero), it was ink on a light ground at the very
     bottom edge, and it arrives after the interaction is over, by which point
     the eye is up at the card that just changed.

     Four things now carry it. It is set at the card-title size rather than
     below the meta line. It is filled in the accent, which is the site's one
     signal colour and already marks the assigned pill and the Assign button,
     so the notification is visibly the same event as the row change. It has a
     ring and a wider shadow so it lifts off the board. And it pops on entry
     rather than only sliding — see the scale in render().

     Paper on accent is 6.75:1, so the label passes AA. The check badge
     inverts with the fill: a paper disc with an accent tick.

     ⚠️ `bottom` is constrained and is not free to grow. With the new job in
     place the list runs to about y=914 in the 1080 stage, so the toast has
     roughly 166px of clear board beneath it. At this size it stands about
     71px tall, which leaves ~50px of air above it at bottom:44. Raising
     `bottom` much further, or growing the padding, puts it on top of the last
     job row. */
  .wa-toast {
    position: absolute; left: 50%; bottom: 44px; display: flex; align-items: center; gap: 16px;
    padding: 20px 34px; border-radius: 999px;
    background: var(--color-accent); color: var(--color-white);
    font-size: 27px; font-weight: 600; letter-spacing: -.01em; line-height: 1.2;
    white-space: nowrap;
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--color-accent) 18%, transparent),
      0 22px 54px color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .wa-check {
    width: 30px; height: 30px; border-radius: 15px; background: var(--color-white);
    color: var(--color-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .wa-check svg { width: 16px; height: 16px; }

  .wa-cursor {
    position: absolute; left: 0; top: 0; transform-origin: 4px 2px;
    filter: drop-shadow(0 6px 14px color-mix(in srgb, var(--color-ink) 30%, transparent));
  }
  .wa-cursor-p { fill: var(--color-ink); stroke: var(--color-paper); stroke-width: 1.6; stroke-linejoin: round; }

  .wa-ring {
    position: absolute; left: 58px; width: 964px; height: 120px; border-radius: 24px;
    border: 2px solid var(--color-accent); pointer-events: none;
  }
</style>

<script>
  (function () {
    var W = 1080, PAD = 64, CW = 952, LIST_TOP = 206, CARD_H = 108, PITCH = 120;
    var DUR = 12, A = 2, S = 5, R = 10;

    var JOBS = [
      ['Split AC not cooling', 'Kailua · Nakamura · Today 9:00', 'assigned', 'Kekoa'],
      ['Annual maintenance', 'Hawaii Kai · Fernandez · Today 10:30', 'assigned', 'Malia'],
      ['Mini split install (2 units)', 'Kapolei · Souza · Thursday', 'scheduled'],
      ['Condenser making noise', 'Mililani · Chang · Tomorrow', 'unassigned'],
      ['Filter replacement', 'Pearl City · Kim · Friday', 'scheduled']
    ];

    var frame = document.getElementById('waFrame');
    var stage = document.getElementById('waStage');
    var list = document.getElementById('waList');
    if (!frame || !stage || !list) return;

    var cards = [];
    JOBS.forEach(function (j, i) {
      var el = document.createElement('div');
      el.className = 'wa-card';
      el.style.top = (LIST_TOP + i * PITCH) + 'px';
      var pill = j[2] === 'assigned'
        ? '<div class="wa-pill assigned">Assigned · ' + j[3] + '</div><div class="wa-av">' + j[3][0] + '</div>'
        : j[2] === 'scheduled'
          ? '<div class="wa-pill scheduled">Scheduled</div>'
          : '<div class="wa-pill unassigned"><span class="wa-dot"></span>Unassigned</div>';
      el.innerHTML = '<div class="wa-grow"><div class="wa-t">' + j[0] + '</div><div class="wa-m">' + j[1] + '</div></div><div class="wa-right">' + pill + '</div>';
      list.appendChild(el);
      cards.push(el);
    });

    var E = {
      outCubic: function (t) { return 1 - Math.pow(1 - t, 3); },
      inOutCubic: function (t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; },
      outBack: function (t) { var c = 1.70158, s = c + 1; return 1 + s * Math.pow(t - 1, 3) + c * Math.pow(t - 1, 2); }
    };
    function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }
    function tw(t, from, to, start, end, ease) {
      if (t <= start) return from;
      if (t >= end) return to;
      return from + (to - from) * ease((t - start) / (end - start));
    }
    function multi(t, stops, vals, ease) {
      if (t <= stops[0]) return vals[0];
      for (var i = 0; i < stops.length - 1; i++) {
        if (t <= stops[i + 1]) {
          var p = (t - stops[i]) / (stops[i + 1] - stops[i]);
          return vals[i] + (vals[i + 1] - vals[i]) * ease(p);
        }
      }
      return vals[vals.length - 1];
    }

    var el = {
      cam: document.getElementById('waCam'), newCard: document.getElementById('waNew'),
      ring: document.getElementById('waRing'), pop: document.getElementById('waPop'),
      row3: document.getElementById('waRow3'), pillOld: document.getElementById('waPillOld'),
      pillNew: document.getElementById('waPillNew'), btn: document.getElementById('waBtn'),
      btnBox: document.getElementById('waBtnBox'), avatar: document.getElementById('waAvatarWrap'),
      toast: document.getElementById('waToast'), cursor: document.getElementById('waCursor'),
      count: document.getElementById('waCount')
    };

    /* Tokens, so the drawing follows a palette change like everything else.
       These two are the only colours the script sets rather than the
       stylesheet, because both are animated per frame. */
    var INK_10 = 'color-mix(in srgb, var(--color-ink) 10%, transparent)';
    var C_ACCENT = 'var(--color-accent)';
    var C_RULE = 'var(--color-rule)';

    var btnX = PAD + CW - 24 - 148 + 74, btnY = LIST_TOP + CARD_H / 2;
    var rowX = PAD + CW - 24 - 210, rowY = LIST_TOP + CARD_H + 78 + 2 * 62;
    var stops = [A + .5, A + .8, S, S + .45, S + 1.35, S + 2.6, S + 3.0];
    var xs = [W + 120, W + 120, btnX, btnX, rowX, rowX, W + 140];
    var ys = [1140, 1140, btnY, btnY, rowY, rowY, 1140];

    function render(t) {
      var shift = tw(t, 0, PITCH, A + .05, A + .75, E.outCubic) - tw(t, 0, PITCH, R + .15, R + 1.1, E.inOutCubic);
      var newIn = tw(t, 0, 1, A + .1, A + .6, E.outCubic);
      var newOut = tw(t, 0, 1, R + .15, R + .95, E.inOutCubic);
      var op = clamp(newIn - newOut, 0, 1);
      var top = LIST_TOP - 26 * (1 - newIn) - 22 * newOut;
      var ring = Math.max(0, tw(t, 0, 1, A + .15, A + .5, E.outCubic) - tw(t, 0, 1, A + .9, A + 1.6, E.inOutCubic));
      var pop = clamp(tw(t, 0, 1, S + .16, S + .6, E.outBack) - tw(t, 0, 1, S + 1.55, S + 1.85, E.outCubic), 0, 1);
      var hover = t > S + 1.05 && t < S + 1.8;
      var done = tw(t, 0, 1, S + 1.62, S + 2.0, E.outCubic);
      var avPop = tw(t, 0, 1, S + 1.72, S + 2.2, E.outBack);
      /* Two values, not one. `toast` is clamped and drives opacity. `toastIn`
         is the unclamped entry curve, and outBack carries it past 1 mid-way,
         which is what gives the scale below its overshoot — clamping first
         would flatten the pop out of existence. Held ~0.35s longer than it
         was, ending just before the job card starts to leave at R+.15. */
      var toast = clamp(tw(t, 0, 1, S + 1.9, S + 2.45, E.outBack) - tw(t, 0, 1, R - .35, R + .1, E.outCubic), 0, 1);
      var toastIn = tw(t, 0, 1, S + 1.9, S + 2.45, E.outBack);
      var zoom = 1 + .045 * clamp(tw(t, 0, 1, A + .5, S, E.inOutCubic) - tw(t, 0, 1, R - .6, R + .9, E.inOutCubic), 0, 1);
      var clickA = Math.max(0, 1 - Math.abs(t - (S + .12)) / .16);
      var clickB = Math.max(0, 1 - Math.abs(t - (S + 1.5)) / .16);
      var co = clamp(tw(t, 0, 1, A + .55, A + .9, E.outCubic) - tw(t, 0, 1, S + 2.5, S + 2.9, E.outCubic), 0, 1);

      el.cam.style.transform = 'scale(' + zoom + ')';
      for (var i = 0; i < cards.length; i++) cards[i].style.transform = 'translateY(' + shift + 'px)';
      el.newCard.style.top = top + 'px';
      el.newCard.style.opacity = op;
      el.newCard.style.boxShadow = '0 ' + (18 * op) + 'px ' + (46 * op) + 'px ' + INK_10;
      el.newCard.style.borderColor = ring > 0 ? C_ACCENT : C_RULE;
      el.ring.style.top = (top - 6) + 'px';
      el.ring.style.opacity = ring * .45;
      el.pop.style.opacity = pop;
      el.pop.style.transform = 'translateY(' + ((1 - pop) * -10) + 'px) scale(' + (.96 + .04 * pop) + ')';
      el.row3.className = 'wa-row' + (hover ? ' on' : '');
      el.pillOld.style.opacity = 1 - done;
      el.pillNew.style.opacity = done;
      el.pillNew.style.transform = 'scale(' + (.94 + .06 * done) + ')';
      el.btnBox.style.width = (148 - 94 * done) + 'px';
      el.btn.style.opacity = 1 - done;
      el.btn.style.transform = 'scale(' + (1 - .04 * clickA) + ')';
      el.avatar.style.opacity = avPop;
      el.avatar.style.transform = 'scale(' + (.6 + .4 * avPop) + ')';
      el.toast.style.opacity = toast;
      /* Order matters: scale applies in the element's own space first, then
         the translates. translateX(-50%) is resolved against the unscaled
         layout width, so the toast stays centred at any scale. */
      el.toast.style.transform = 'translateX(-50%) translateY(' + ((1 - toast) * 26) + 'px) scale(' + (.86 + .14 * toastIn) + ')';
      el.count.textContent = (op > .5 ? 6 : 5) + ' open';
      el.cursor.style.opacity = co;
      el.cursor.style.transform = 'translate(' + multi(t, stops, xs, E.inOutCubic) + 'px,' +
        multi(t, stops, ys, E.inOutCubic) + 'px) scale(' + (1 - .16 * Math.max(clickA, clickB)) + ')';
    }

    /* The stage is a fixed 1080px square scaled to whatever width it is given,
       which is what keeps every coordinate above in one system. */
    function fit() { stage.style.transform = 'scale(' + (frame.clientWidth / W) + ')'; }
    fit();
    if (window.ResizeObserver) new ResizeObserver(fit).observe(frame);
    else addEventListener('resize', fit);

    /* One settled frame and nothing else. t=0.5 is before the new job arrives,
       so the still is a plain job list rather than a half-drawn interaction. */
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) { render(0.5); return; }

    var t0 = null, visible = !document.hidden;
    document.addEventListener('visibilitychange', function () { visible = !document.hidden; t0 = null; });
    function loop(ts) {
      if (visible) {
        if (t0 === null) t0 = ts;
        render(((ts - t0) / 1000) % DUR);
      }
      requestAnimationFrame(loop);
    }
    render(0);
    requestAnimationFrame(loop);
  })();
</script>
