---
import { proof } from '../../content/site-v2';
import DispatchRouteGraphic from './DispatchRouteGraphic.astro';
import EfHero from '../work/EfHero.astro';

/**
 * The homepage proof section.
 *
 * Rebuilt 13 Sep 2026. It was a three-column row of equal cards, which meant
 * one finished case study sat beside two empty dashed boxes: a layout that
 * says "one client" louder than it says "here is the work". Now the finished
 * work runs full width, two columns, with the drawing large enough to read,
 * and what is still being written is one line of text instead of two holes.
 *
 * An entry is featured when it is not a placeholder. Placeholders are counted,
 * not drawn. Nothing is invented to fill the space; the line under the feature
 * says plainly that more are coming, which is true and costs no credibility.
 *
 * `graphic` picks the drawing. 'estimateflow' is the EstimateFlow hero
 * composite, the same one the case study page opens with. 'dispatch' is
 * DispatchRouteGraphic, unused since 4 Sep 2026 and kept because switching it
 * back on is one key in site-v2.ts; it is an illustration and carries its own
 * caption saying so.
 */
const featured = proof.filter((item) => !item.placeholder);
const pending = proof.filter((item) => item.placeholder).length;
---

<div class="proof">
  {featured.map((item) => (
    <article class="pf">
      <div class="pf-fig">
        {item.graphic === 'dispatch' ? <DispatchRouteGraphic /> : null}
        {item.graphic === 'estimateflow' ? <EfHero /> : null}
      </div>
      <div class="pf-copy">
        <p class="eyebrow">Case study</p>
        <h3 class="pf-name">{item.result}</h3>
        <p class="pf-body">{item.body}</p>
        {item.href && (
          <a href={item.href} class="btn-ghost pf-more">
            Read the case study<span class="u" aria-hidden="true"></span>
          </a>
        )}
      </div>
    </article>
  ))}

  {pending > 0 && (
    <p class="pf-pending">
      More case studies are being written. If you want to know whether I have
      solved a problem like yours, ask me and I will tell you straight.
    </p>
  )}
</div>

<style>
  .proof { margin-top: 40px; }

  .pf {
    display: grid; grid-template-columns: 1.35fr 1fr; gap: 40px; align-items: center;
  }
  .pf + .pf { margin-top: 48px; padding-top: 48px; border-top: 1px solid var(--color-rule); }

  /* An ink hairline and square corners, like every other bounded object on
     the page. The drawing keeps its own radii inside. */
  .pf-fig {
    border: 1px solid var(--color-ink); background: var(--color-white); overflow: hidden;
  }

  .pf-copy .eyebrow { margin-bottom: 10px; }
  .pf-name {
    margin: 0 0 12px;
    font-family: var(--font-display); font-weight: 650; font-size: var(--text-d3);
    letter-spacing: var(--tracking-tight); line-height: var(--leading-snug);
    color: var(--color-ink);
  }
  .pf-body {
    font-family: var(--font-serif); font-size: var(--text-body);
    line-height: var(--leading-body); color: var(--color-body); max-width: 46ch;
  }
  .pf-more { margin-top: 22px; }

  /* One quiet line where two empty cards used to be. */
  .pf-pending {
    margin-top: 44px; padding-top: 22px; border-top: 1px solid var(--color-rule);
    font-family: var(--font-serif); font-size: var(--text-small);
    line-height: var(--leading-body); color: var(--color-faint); max-width: 62ch;
  }

  @media (max-width: 1000px) {
    .pf { grid-template-columns: 1fr; gap: 24px; }
    .pf-body { max-width: none; }
  }
  @media (max-width: 640px) {
    .proof { margin-top: 28px; }
    .pf + .pf { margin-top: 34px; padding-top: 34px; }
    .pf-pending { margin-top: 32px; }
  }
</style>
