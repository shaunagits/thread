---
import WindwardAir from './WindwardAir.astro';
import { hero, cta, ctaHref } from '../../content/site-v2';
---

<section class="hero ruled ruled-fade" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>{hero.h1}</h1>
      <p class="lead hero-sub">{hero.sub}</p>

      {/* Two buttons, from the wireframe: the ask, and a way to check the
          price before committing to a conversation. The live homepage runs a
          single CTA deliberately; this page has prices to point at, which is
          what earns the second button. */}
      <div class="btn-row">
        <a href={ctaHref} class="btn">{cta}</a>
        <a href={hero.secondary.href} class="btn-ghost">
          {hero.secondary.label}<span class="u" aria-hidden="true"></span>
        </a>
      </div>
    </div>

    <div class="hero-figure"><WindwardAir /></div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(34px, 5vw, 64px); align-items: center;
  }
  /* 20ch. The headline is 62 characters and sets as three lines at this
     measure with no widow. Re-check the break if the headline changes. */
  .hero-copy h1 { max-width: 20ch; margin: 0 0 20px; }
  .hero-sub { max-width: 46ch; margin: 0; }

  /* The drawing is a 1:1 square, so it is capped rather than allowed to fill
     a wide column — at full width it would stand taller than the copy beside
     it and push the CTA under the fold on a laptop. */
  .hero-figure { width: 100%; max-width: 560px; justify-self: end; }

  /* 820px, the same width the live homepage's hero stacks at, so a visitor
     comparing the two sees the same page shape change at the same place. */
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-figure { max-width: 560px; justify-self: start; }
  }
  @media (max-width: 640px) {
    .hero-copy h1, .hero-sub { max-width: none; }
    .hero-grid { gap: 30px; }
    .hero-figure { max-width: none; }
    /* Unlike the live homepage this page renders no sticky CTA bar, so the
       hero keeps its buttons on a phone — there is no pinned duplicate for
       them to sit above. */
    .btn-row { flex-direction: column; align-items: stretch; }
  }
</style>
