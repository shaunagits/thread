---
/**
 * The dashboard window itself: chrome, sidebar, header row, the three figures,
 * the sales chart and the crew list. No callouts, no spotlights, no <svg>
 * wrapper — just the drawing, so a parent can frame it however it needs.
 *
 * Extracted 29 Aug 2026 when the phone composition arrived. The wide plate
 * draws it inside a 1040x748 canvas with 132 units of callout band above and
 * below; the phone draws the same thing inside a tight 1040x548 frame and
 * zooms around it. Duplicating ninety lines of coordinates so the two could
 * differ by a viewBox was the alternative, and they would have drifted.
 *
 * Every colour is a token and every class belongs to DashboardPlate's scoped
 * stylesheet, so this file deliberately carries no <style> of its own.
 */
---

    <!-- ============ window ============ -->
    <g class="dp-window">
      <rect class="dp-panel" x="8" y="16" width="1024" height="516" rx="3"/>
      <path class="dp-rule" d="M8 60 H1032"/>
      <g class="dp-dots"><circle cx="34" cy="38" r="4.5"/><circle cx="52" cy="38" r="4.5"/><circle cx="70" cy="38" r="4.5"/></g>
      <rect class="dp-urlbar" x="300" y="27" width="440" height="22" rx="11"/>
      <text class="dp-url" x="322" y="42">app.yourbusiness.com</text>
    </g>

    <!-- ============ sidebar: the client's own ============ -->
    <g class="dp-side">
      <path class="dp-rule" d="M240 60 V532"/>
      <rect class="dp-mark" x="32" y="88" width="26" height="26" rx="5"/>
      <rect class="dp-wordmark" x="70" y="96" width="86" height="11" rx="5.5"/>

      <rect class="dp-navactive" x="20" y="150" width="200" height="38" rx="2"/>
      <text class="dp-navon"  x="40" y="175">Dashboard</text>
      <text class="dp-navoff" x="40" y="217">Sales</text>
      <text class="dp-navoff" x="40" y="259">Jobs</text>
      <text class="dp-navoff" x="40" y="301">Team</text>
      <text class="dp-navoff" x="40" y="343">Invoices</text>

      <path class="dp-rule" d="M20 384 H220"/>
      <circle class="dp-avatar" cx="38" cy="424" r="13"/>
      <rect class="dp-hair" x="62" y="419" width="94" height="9" rx="4.5"/>
    </g>

    <!-- ============ header row ============ -->
    <g class="dp-head">
      <text class="dp-h" x="272" y="106">Today</text>
      <text class="dp-lbl" x="272" y="130">MONDAY · ALL LOCATIONS</text>
      <rect class="dp-btn" x="896" y="84" width="112" height="34" rx="2"/>
      <text class="dp-btntext" x="952" y="106">New job</text>
    </g>

    <!-- ============ the three figures ============ -->
    <g class="dp-stats">
      <g class="dp-stat s1">
        <rect class="dp-card" x="272" y="150" width="238" height="104" rx="2"/>
        <text class="dp-lbl" x="292" y="184">REVENUE · THIS MONTH</text>
        <text class="dp-fig" x="292" y="226">$148,320</text>
      </g>
      <g class="dp-stat s2">
        <rect class="dp-card" x="530" y="150" width="238" height="104" rx="2"/>
        <text class="dp-lbl" x="550" y="184">JOBS OPEN</text>
        <text class="dp-fig" x="550" y="226">37</text>
      </g>
      <g class="dp-stat s3">
        <rect class="dp-card" x="788" y="150" width="220" height="104" rx="2"/>
        <text class="dp-lbl" x="808" y="184">ON SHIFT TODAY</text>
        <text class="dp-fig" x="808" y="226">12</text>
      </g>
    </g>

    <!-- ============ sales ============ -->
    <g class="dp-chart">
      <rect class="dp-card" x="272" y="278" width="496" height="230" rx="2"/>
      <text class="dp-lbl" x="292" y="310">SALES · LAST 7 DAYS</text>
      {/* Three series, not bars and not one line. The hero graphic a scroll
          above ends in a small bar chart, so a second bar chart read as the
          same drawing twice — and a single line with a filled area under it
          was both flat and fragile: the fill used color-mix against
          transparent, which some engines resolve to opaque black. Three
          strokes, no fills, nothing to fall back to. */}
      <g class="dp-grid">
        <path d="M292 410 H748" fill="none"/>
        <path d="M292 445 H748" fill="none"/>
      </g>
      <path class="dp-rule" d="M292 480 H748" fill="none"/>
      <path class="dp-s3" pathLength="1" fill="none" d="M292.0 458 L368.0 450 L444.0 454 L520.0 440 L596.0 446 L672.0 428 L748.0 434"/>
      <path class="dp-s2" pathLength="1" fill="none" d="M292.0 440 L368.0 428 L444.0 436 L520.0 410 L596.0 422 L672.0 394 L748.0 406"/>
      <path class="dp-s1" pathLength="1" fill="none" d="M292.0 422 L368.0 394 L444.0 430 L520.0 370 L596.0 404 L672.0 348 L748.0 382"/>
      <circle class="dp-point" cx="748" cy="382" r="5"/>
    </g>

    <!-- ============ crew ============ -->
    <g class="dp-list">
      <rect class="dp-card" x="788" y="278" width="220" height="230" rx="2"/>
      <text class="dp-lbl" x="808" y="310">CREW · TODAY</text>

      <g class="dp-row r1">
        <circle class="dp-avatar" cx="812" cy="348" r="13"/>
        <text class="dp-rowtext" x="838" y="353">Install</text>
        <circle class="dp-status" cx="986" cy="348" r="5"/>
      </g>
      <g class="dp-row r2">
        <circle class="dp-avatar" cx="812" cy="396" r="13"/>
        <text class="dp-rowtext" x="838" y="401">Delivery</text>
        <circle class="dp-status" cx="986" cy="396" r="5"/>
      </g>
      <g class="dp-row r3">
        <circle class="dp-avatar" cx="812" cy="444" r="13"/>
        <text class="dp-rowtext" x="838" y="449">Front desk</text>
        <circle class="dp-status dp-status-off" cx="986" cy="444" r="5"/>
      </g>
    </g>
