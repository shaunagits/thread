    <g class="hg-line" stroke-width="1">
      <path class="hg-thread w1" pathLength="1" d="M118 68 C118 130, 450 128, 450 186"/>
      <path class="hg-thread w2" pathLength="1" d="M284 68 C284 130, 450 128, 450 186"/>
