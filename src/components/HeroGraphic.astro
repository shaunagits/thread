---
import { siAirtable, siQuickbooks, siShopify, siSquare, siStripe, siXero } from 'simple-icons';

/** Local brand paths avoid a third-party image request. The marks crossfade in
    place, while reduced-motion visitors see the first state. */
---

<div class="system-visual">
  <svg viewBox="0 56 560 318" role="img" aria-labelledby="system-title system-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="system-title">Thread brings business tools into one clear operating view</title>
    <desc id="system-desc">Business tools including QuickBooks, Square, and Shopify connect through a Thread mark to one clear outcome.</desc>
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <path class="connector connector-one" pathLength="1" d="M155 110 C205 110 207 207 248 207" />
      <path class="connector connector-two" pathLength="1" d="M155 215 H248" />
      <path class="connector connector-three" pathLength="1" d="M155 320 C205 320 207 223 248 223" />
      <path class="connector accent-line" pathLength="1" d="M315 215 H360" />
    </g>
    <g class="source-card source-one"><rect x="24" y="76" width="132" height="68" rx="2" /><g class="source-option label-one"><path d={siQuickbooks.path} transform="translate(36 99) scale(.84)" /><text x="67" y="108">QuickBooks</text><text x="67" y="125" class="label-type">ACCOUNTING</text></g><g class="source-option label-two"><path d={siXero.path} transform="translate(36 99) scale(.84)" /><text x="67" y="108">Xero</text><text x="67" y="125" class="label-type">ACCOUNTING</text></g></g>
    <g class="source-card source-two"><rect x="24" y="181" width="132" height="68" rx="2" /><g class="source-option label-one label-delay"><path d={siSquare.path} transform="translate(36 204) scale(.84)" /><text x="67" y="213">Square</text><text x="67" y="230" class="label-type">PAYMENTS</text></g><g class="source-option label-two label-delay"><path d={siStripe.path} transform="translate(36 204) scale(.84)" /><text x="67" y="213">Stripe</text><text x="67" y="230" class="label-type">PAYMENTS</text></g></g>
    <g class="source-card source-three"><rect x="24" y="286" width="132" height="68" rx="2" /><g class="source-option label-one label-delay-two"><path d={siShopify.path} transform="translate(36 309) scale(.84)" /><text x="67" y="318">Shopify</text><text x="67" y="335" class="label-type">COMMERCE</text></g><g class="source-option label-two label-delay-two"><path d={siAirtable.path} transform="translate(36 309) scale(.84)" /><text x="67" y="318">Airtable</text><text x="67" y="335" class="label-type">OPERATIONS</text></g></g>
    <g class="thread-mark" transform="translate(242 183) scale(.5)"><path pathLength="1" d="M78 19H121C136 19 145 30 145 42.5C145 55 136 66 121 66H115C98 66 87 58 76 49C65 40 53 19 41 19H29C18 19 9 30 9 42.5C9 55 18 66 29 66H48C79 66 96 79 96 95V114C96 127 86 135 75 135C64 135 55 127 55 114V82" /></g>
    <g class="outcome"><rect x="360" y="150" width="176" height="130" rx="2" /><path d="M360 202H536" class="outcome-rule" /><circle cx="382" cy="184" r="4" class="node-dot" /><text x="396" y="188" class="outcome-label">ONE CLEAR VIEW</text><text x="386" y="239" class="outcome-copy">One clear system.</text></g>
  </svg>
</div>

<style>
  .system-visual { color: var(--color-ink); width: 100%; } svg { display: block; width: 100%; height: auto; overflow: visible; }
  .connector { stroke: var(--color-hair); stroke-width: 1; } .accent-line { stroke: var(--color-line); }
  .source-card rect, .outcome rect { fill: var(--color-white); stroke: var(--color-hair); stroke-width: 1; } .source-option path { fill: var(--color-koa); }
  .thread-mark path { fill: none; stroke: var(--color-ink); stroke-width: 5.8; stroke-linecap: round; stroke-linejoin: round; } .node-dot { fill: var(--color-line); }
  text { font-family: var(--font-sans); fill: var(--color-body); font-size: 12px; } .source-option text:not(.label-type) { font-size: 13px; font-weight: 500; } .label-type { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: .11em; fill: var(--color-faint); } .outcome-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: .11em; fill: var(--color-faint); } .outcome-rule { stroke: var(--color-rule); stroke-width: 1; } .outcome-copy { font-family: var(--font-serif); font-size: 13px; fill: var(--color-ink); }
  .label-two { opacity: 0; } @keyframes source-swap { 0%, 42% { opacity: 1 } 50%, 92% { opacity: 0 } 100% { opacity: 1 } } @keyframes source-swap-alt { 0%, 42% { opacity: 0 } 50%, 92% { opacity: 1 } 100% { opacity: 0 } }
  @keyframes diagram-draw { to { stroke-dashoffset:0; } } @keyframes diagram-reveal { to { opacity:1; } }
  @media (prefers-reduced-motion: no-preference) {
    .source-card, .outcome { opacity:0; }
    .source-card { animation:diagram-reveal .28s ease-out forwards; }
    .source-one { animation-delay:.05s; } .source-two { animation-delay:.14s; } .source-three { animation-delay:.23s; }
    .connector, .thread-mark path { stroke-dasharray:1; stroke-dashoffset:1; animation:diagram-draw .62s cubic-bezier(.5,0,.25,1) forwards; }
    .connector-one { animation-delay:.28s; } .connector-two { animation-delay:.36s; } .connector-three { animation-delay:.44s; }
    .thread-mark path { animation-delay:.72s; }
    .accent-line { animation-delay:1.04s; } .outcome { animation:diagram-reveal .32s ease-out forwards 1.15s; }
    .label-one { animation:source-swap 12s ease-in-out infinite 1.5s; } .label-two { animation:source-swap-alt 12s ease-in-out infinite 1.5s; }
    .label-delay { animation-delay:-2.5s; } .label-delay-two { animation-delay:-6.5s; }
  }
</style>
