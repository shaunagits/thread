        <rect x="168" y="258" width="180" height="46" rx="2"/>
        <rect x="360" y="258" width="180" height="46" rx="2"/>
        <rect x="552" y="258" width="180" height="46" rx="2"/>
      </g>
      <g class="hg-hair">
        <rect x="182" y="270" width="56" height="10" rx="3"/><rect x="182" y="287" width="34" height="5" rx="2.5"/>
        <rect x="374" y="270" width="46" height="10" rx="3"/><rect x="374" y="287" width="40" height="5" rx="2.5"/>
        <rect x="566" y="270" width="38" height="10" rx="3"/><rect x="566" y="287" width="30" height="5" rx="2.5"/>
      </g>
      <path class="hg-rule" d="M168 356 H430" stroke-width="1"/>
      <g class="hg-rule" stroke-width="1"><path d="M460 336 H732"/><path d="M460 356 H732"/></g>
      <g class="hg-hair">
        <rect x="460" y="322" width="120" height="5" rx="2.5"/>
        <rect x="460" y="342" width="96" height="5" rx="2.5"/>
        <rect x="460" y="362" width="132" height="5" rx="2.5"/>
      </g>
    </g>
    <g class="hg-ochre">
      <rect class="hg-bar" x="172" y="342" width="18" height="14"/><rect class="hg-bar" x="200" y="334" width="18" height="22"/>
      <rect class="hg-bar" x="228" y="324" width="18" height="32"/><rect class="hg-bar" x="256" y="336" width="18" height="20"/>
      <rect class="hg-bar" x="284" y="320" width="18" height="36"/><rect class="hg-bar" x="312" y="330" width="18" height="26"/>
      <rect class="hg-bar" x="340" y="316" width="18" height="40"/>
    </g>
  </svg>

  <!-- ================= narrow ================= -->
  <svg
    class="hg-plate hg-narrow"
    viewBox="0 0 360 300"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Five small symbols for everyday business tools sit in a row, connected by curved lines that converge into a single point and open into one dashboard panel below. The symbols keep changing, one at a time, cycling through email, scheduling, messaging, reporting, crews, reviews, invoicing, checklists, orders, shipping, site, location, payments, time and mobile."
  >
    <g class="hg-tile">
      <rect class="hg-in s1" x="36"  y="16" width="48" height="48" rx="4"/>
      <rect class="hg-in s2" x="96"  y="16" width="48" height="48" rx="4"/>
      <rect class="hg-in s3" x="156" y="16" width="48" height="48" rx="4"/>
      <rect class="hg-in s4" x="216" y="16" width="48" height="48" rx="4"/>
      <rect class="hg-in s5" x="276" y="16" width="48" height="48" rx="4"/>
    </g>

    <g class="hg-in s1"><g class="hg-tool">
      <use class="hg-a p1" href="#hg-mail"  transform="translate(48,28)"/>
      <use class="hg-b p1" href="#hg-cal"   transform="translate(48,28)"/>
      <use class="hg-c p1" href="#hg-chat"  transform="translate(48,28)"/>
    </g></g>
    <g class="hg-in s2"><g class="hg-tool">
      <use class="hg-a p2" href="#hg-chart" transform="translate(108,28)"/>
      <use class="hg-b p2" href="#hg-crew"  transform="translate(108,28)"/>
      <use class="hg-c p2" href="#hg-star"  transform="translate(108,28)"/>
    </g></g>
    <g class="hg-in s3"><g class="hg-tool">
      <use class="hg-a p3" href="#hg-doc"   transform="translate(168,28)"/>
      <use class="hg-b p3" href="#hg-clip"  transform="translate(168,28)"/>
