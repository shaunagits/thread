---
interface Props {
  /**
   * Use the narrow composition at every width instead of swapping at 820px.
   * Set when the graphic sits in a column rather than across the page, where
   * the wide 900x400 drawing is far too letterboxed to read.
   */
  compact?: boolean;
}
const { compact = false } = Astro.props;

/**
 * Hero graphic — tools into one panel.
 *
 * Five connected boxes feed a single node, which opens into a wireframe
 * panel. Each box rotates through three different tools on its own phase
 * offset, so something changes roughly every 2.4 seconds and the five
 * visible tools are almost always a mixture rather than a matched set.
 * That mixture is the argument: whichever tools happen to be yours.
 *
 * No text of any kind. The panel is placeholder bars, deliberately, so it
 * reads as a drawing rather than a screenshot of software that exists.
 *
 * Two compositions, one wide and one narrow, swapped at the 820px
 * breakpoint with display. Both are inline SVG, no image assets.
 *
 * Motion is CSS only — no JavaScript, no library, no SMIL — and every rule
 * lives inside prefers-reduced-motion: no-preference, so the reduced-motion
 * default is the finished still drawing with the first tool in each slot.
 *
 * Glyphs take stroke="currentColor" and inherit `color` from the <use>.
 * Author styles do not reliably cross a <use> shadow tree; inherited
 * properties always do. Do not convert these to a class-based fill.
 */
---

<div class:list={['hg', { 'is-compact': compact }]}>
  <!-- Glyph library. Referenced by both compositions below. -->
  <svg class="hg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <g id="hg-mail"  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="5" width="22" height="15" rx="1.5"/><path d="M1.6 6.4 L12 14.4 L22.4 6.4"/></g>
      <g id="hg-cal"   fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="18" rx="1.5"/><path d="M2 9.5 H22"/><path d="M7.5 2 V6.5"/><path d="M16.5 2 V6.5"/></g>
      <g id="hg-chat"  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5.5 a2.5 2.5 0 0 1 2.5 -2.5 H18.5 a2.5 2.5 0 0 1 2.5 2.5 V14 a2.5 2.5 0 0 1 -2.5 2.5 H10.5 L6 20.5 V16.5 H5.5 A2.5 2.5 0 0 1 3 14 Z"/></g>

      <g id="hg-chart" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21 H22"/><path d="M6.5 21 V13"/><path d="M12 21 V6"/><path d="M17.5 21 V16"/></g>
      <g id="hg-crew"  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="8" r="3.6"/><path d="M2 20.5 a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9.5" r="2.8"/><path d="M15.5 20.5 a5.6 5.6 0 0 1 6.5 -3.6"/></g>
      <g id="hg-star"  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.6 L14.9 8.6 L21.5 9.6 L16.7 14.2 L17.9 20.7 L12 17.6 L6.1 20.7 L7.3 14.2 L2.5 9.6 L9.1 8.6 Z"/></g>

      <g id="hg-doc"   fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="1.5"/><path d="M8 8 H16"/><path d="M8 12 H16"/><path d="M8 16 H13"/></g>
      <g id="hg-clip"  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3.5" width="16" height="18.5" rx="1.5"/><rect x="8.5" y="1.5" width="7" height="4" rx="1"/><path d="M8 12 H16"/><path d="M8 16.5 H13.5"/></g>
      <g id="hg-bag"   fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7 H20 L18.4 21.5 H5.6 Z"/><path d="M8.5 9.5 V6.2 a3.5 3.5 0 0 1 7 0 V9.5"/></g>

      <g id="hg-truck" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="13" height="10" rx="1.5"/><path d="M14 9 H18 L22 12.5 V16 H14 Z"/><circle cx="6" cy="18.5" r="2.4"/><circle cx="18" cy="18.5" r="2.4"/></g>
      <g id="hg-hat"   fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 18 a8.5 8.5 0 0 1 17 0"/><path d="M1.5 18 H22.5"/><path d="M9 18 V10.4"/><path d="M15 18 V10.4"/></g>
      <g id="hg-pin"   fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21.5 C12 21.5 4.5 14 4.5 9.5 a7.5 7.5 0 0 1 15 0 C19.5 14 12 21.5 12 21.5 Z"/><circle cx="12" cy="9.5" r="2.6"/></g>

      <g id="hg-card"  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1.5" y="5" width="21" height="14" rx="2"/><path d="M1.5 10 H22.5"/></g>
      <g id="hg-clock" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 6 V12 L16.4 14.6"/></g>
      <g id="hg-phone" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="1.5" width="12" height="21" rx="2.5"/><path d="M10.3 19.2 H13.7"/></g>
    </defs>
  </svg>

  <!-- ================= wide ================= -->
  <svg
    class="hg-plate hg-wide"
    viewBox="0 0 900 400"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Five small symbols for everyday business tools sit in a row, connected by curved lines that converge into a single point and open into one dashboard panel below. The symbols keep changing, one at a time, cycling through email, scheduling, messaging, reporting, crews, reviews, invoicing, checklists, orders, shipping, site, location, payments, time and mobile."
  >
    <g class="hg-tile">
      <rect class="hg-in s1" x="96"  y="24" width="44" height="44" rx="4"/>
      <rect class="hg-in s2" x="262" y="24" width="44" height="44" rx="4"/>
      <rect class="hg-in s3" x="428" y="24" width="44" height="44" rx="4"/>
      <rect class="hg-in s4" x="594" y="24" width="44" height="44" rx="4"/>
      <rect class="hg-in s5" x="760" y="24" width="44" height="44" rx="4"/>
    </g>

    <g class="hg-in s1"><g class="hg-tool">
      <use class="hg-a p1" href="#hg-mail"  transform="translate(106,34)"/>
      <use class="hg-b p1" href="#hg-cal"   transform="translate(106,34)"/>
