<style>
  .hg { margin-top: 46px; }
  .hg-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .hg-plate { display: block; width: 100%; height: auto; }
  .hg-narrow { display: none; }

  /* compact: pinned to the narrow composition at every width, and no top
     margin, because in a column the grid gap already does that spacing. */
  .hg.is-compact { margin-top: 0; }
  .hg.is-compact .hg-wide { display: none; }
  .hg.is-compact .hg-narrow { display: block; }

  /* ---- paint. no hex; every value is a token from global.css ---- */
  .hg-panel { fill: var(--color-white); stroke: var(--color-hair); }
  .hg-tile  { fill: none; stroke: var(--color-hair); stroke-width: 1; }
  .hg-rule  { stroke: var(--color-rule); }
  .hg-hair  { fill: var(--color-hair); }
  .hg-ochre { fill: var(--color-ochre); }
  .hg-line  { stroke: var(--color-line); }
  /* glyphs inherit this through the use shadow tree via currentColor */
  .hg-tool  { color: var(--color-plate); }

  /* Base state. The second and third tool in every slot are hidden, so a
     visitor with reduced motion sees one settled set rather than three
     drawings stacked on top of each other. */
  .hg-b, .hg-c { opacity: 0; }

  /* ============================================================
     Motion — CSS only. No JavaScript, no library, no SMIL.

     Entry runs once on load. Scroll driving would be wrong here: the
     graphic is above the fold, so animation-timeline: view() is already
     past its trigger on first paint and would never run.

     The rotation is a 36s cycle per slot, five slots offset by 7.2s, so a
     single icon changes roughly every 2.4 seconds and never two at once.
     ============================================================ */
  @keyframes hg-draw { from { stroke-dashoffset: 1 } to { stroke-dashoffset: 0 } }
  @keyframes hg-fade { from { opacity: 0 } to { opacity: 1 } }
  @keyframes hg-rise { from { opacity: 0; transform: translateY(6px) } to { opacity: 1; transform: translateY(0) } }
  @keyframes hg-grow { from { transform: scaleY(0) } to { transform: scaleY(1) } }

  @keyframes hg-rot1 { 0%, 31% { opacity: 1 } 33.3%, 98% { opacity: 0 } 100% { opacity: 1 } }
  @keyframes hg-rot2 { 0%, 31% { opacity: 0 } 33.3%, 64.6% { opacity: 1 } 66.6%, 100% { opacity: 0 } }
  @keyframes hg-rot3 { 0%, 64.6% { opacity: 0 } 66.6%, 98% { opacity: 1 } 100% { opacity: 0 } }

  @media (prefers-reduced-motion: no-preference) {
    .hg-thread  { stroke-dasharray: 1; stroke-dashoffset: 1; animation: hg-draw .8s ease-in-out forwards; }
    .hg-in      { opacity: 0; animation: hg-rise .45s ease-out forwards; }
    .hg-node    { opacity: 0; animation: hg-fade .3s ease-out forwards .85s; }
    .hg-panelfx { opacity: 0; animation: hg-fade .5s ease-out forwards 1s; }
    .hg-bar     { transform-box: fill-box; transform-origin: bottom; animation: hg-grow .45s cubic-bezier(.3,.7,.3,1) both 1.15s; }

    .hg-a { animation: hg-rot1 36s ease-in-out infinite; }
    .hg-b { animation: hg-rot2 36s ease-in-out infinite; }
    .hg-c { animation: hg-rot3 36s ease-in-out infinite; }

    /* phase offset per slot. negative delays start each mid-cycle. */
    .p1 { animation-delay: 0s }      .p2 { animation-delay: -7.2s }
    .p3 { animation-delay: -14.4s }  .p4 { animation-delay: -21.6s }
    .p5 { animation-delay: -28.8s }

    /* entry stagger */
    .s1 { animation-delay: .05s } .s2 { animation-delay: .11s } .s3 { animation-delay: .17s }
    .s4 { animation-delay: .23s } .s5 { animation-delay: .29s }
    .w1 { animation-delay: .30s } .w2 { animation-delay: .36s } .w3 { animation-delay: .42s }
    .w4 { animation-delay: .48s } .w5 { animation-delay: .54s }
  }

  /* Breakpoint is the original's, verbatim, same as the plates. */
  @media (max-width: 820px) {
    .hg { margin-top: 34px; }
    .hg-wide   { display: none; }
    .hg-narrow { display: block; }
  }
</style>
