---
/**
 * Hero graphic — busywork compiling into software.
 *
 * Replaced wholesale 29 Aug 2026 for the Style C redesign. The previous drawing
 * was the connects-to hub: nine tool logos cycling on three cards, wires into
 * the Thread mark, one window out. It is in git if the hub idea returns, and
 * `simple-icons` stays a dependency only for as long as nothing else needs it.
 *
 * What this one says, in one 8-second loop:
 *
 *   1. Nine loose task rows drift at angles across the canvas.  (0–27.5%)
 *   2. A cursor ticks three of them off by hand, one at a time. (8–25%)
 *   3. Every row pulls in and squares up.                       (27.5–45%)
 *   4. The stack compiles into an app window.                   (45–65%)
 *   5. The cursor presses RUN once and all nine complete.       (70–88.75%)
 *   6. Everything dissolves and scatters back for the loop.     (88.75–100%)
 *
 * The argument is in the contrast between step 2 and step 5: three ticks by
 * hand versus nine by one click. That is the whole page in a drawing, which is
 * why the hero copy no longer has to explain it.
 *
 * Motion rules, all three of which the site already required:
 *
 *   - CSS only. No JavaScript, no libraries, no SMIL. The design file drives
 *     this with a scroll handler; that is canvas scaffolding, not a spec.
 *   - Everything sits inside `prefers-reduced-motion: no-preference`, and the
 *     no-motion state is the finished composition — window drawn, all nine
 *     rows stacked and complete. A visitor who suppresses motion sees the
 *     outcome, not an empty canvas or nine rows scattered at angles.
 *   - Time-based, so landmine 22 does not apply: that is about
 *     `animation-timeline: view()` being folded into the `animation`
 *     shorthand by Lightning CSS. There is no scroll timeline here. The
 *     scroll-driven work is in RepetitiveGraphic.
 *
 * The nine rows share one keyframe and differ only by custom properties, so
 * the drift positions live on the elements next to the markup they move rather
 * than in nine near-identical keyframe blocks. The nine completion marks do
 * need their own keyframes: they fire 1.6% apart and all clear together, and a
 * phase shift on an infinite animation would carry the clear along with it.
 */

/* x/y/rotation where each row starts and drifts, the y it squares up to at the
   gather, and the y it lands on inside the window. The window's content area
   begins at x=240; rows stack 26 apart from y=100. */
const rows = [
  { x:   8, y:  26, r: -3,   ym: 128, y1: 100, w: 104 },
  { x: 300, y:  10, r:  2.5, ym: 134, y1: 126, w: 132 },
  { x: 150, y:  88, r:  1.5, ym: 140, y1: 152, w:  88 },
  { x: 420, y:  72, r: -2,   ym: 146, y1: 178, w: 120 },
  { x:  16, y: 150, r:  2,   ym: 152, y1: 204, w:  96 },
  { x: 296, y: 146, r: -1.5, ym: 158, y1: 230, w: 140 },
  { x: 120, y: 224, r:  2.5, ym: 164, y1: 256, w: 112 },
  { x: 404, y: 212, r: -2.5, ym: 170, y1: 282, w: 126 },
  { x:  24, y: 298, r:  1.5, ym: 176, y1: 308, w: 100 },
];

/* The phone composition, from "Thread Homepage - Mobile". Six rows, not nine,
   in a 300x250 canvas rather than 640x380.

   Six because of legibility, not fit: nine 88px rows stacked at phone scale
   put the drawing's own type under 6px, and the rows themselves become hairs.
   The argument survives the cut — three ticked by hand against six by one
   click still reads as the same contrast, and nobody counts them. */
const rowsNarrow = [
  { x:   6, y:  14, r: -3,   ym:  96, y1:  78, w: 52 },
  { x: 140, y:   8, r:  2.5, ym: 100, y1:  98, w: 60 },
  { x:  60, y:  66, r:  1.5, ym: 104, y1: 118, w: 44 },
  { x: 196, y:  58, r: -2,   ym: 108, y1: 138, w: 56 },
  { x:  12, y: 112, r:  2,   ym: 112, y1: 158, w: 48 },
  { x: 150, y: 150, r: -1.5, ym: 116, y1: 178, w: 64 },
];

/* The three the cursor ticks by hand. Their checkbox centres are where the
   cursor stops, so these indices and the cursor keyframes move together. Same
   three positions in the row order of both compositions. */
const ticked = [0, 2, 5];

/* ⚠️ The row keyframes are generated as LITERAL values, not one shared
   keyframe parameterised with custom properties.

   The shared version was tidier and is in git, but `transform: translate(var(--x),
   var(--y))` inside @keyframes is a pattern Safari has never handled reliably —
   it either steps between keyframes instead of interpolating, or drops the
   transform altogether, which piles every row at the origin. It worked in every
   environment available here and failed on a real iPhone, which is the whole
   reason the design file wrote nine separate blocks in the first place.

   Generating them means the values still live in one place; only the emitted
   CSS is repetitive. */
const kf = (prefix, set, xg, x1) => set.map((r, i) => `
@keyframes ${prefix}${i} {
  0%, 27.5% { transform: translate(${r.x}px, ${r.y}px) rotate(${r.r}deg); opacity: 1; animation-timing-function: cubic-bezier(.5,0,.2,1); }
  45%       { transform: translate(${xg}px, ${r.ym}px) rotate(0deg); opacity: 1; animation-timing-function: cubic-bezier(.4,0,.2,1); }
  65%, 88.75% { transform: translate(${x1}px, ${r.y1}px) rotate(0deg); opacity: 1; }
  93%       { transform: translate(${x1}px, ${r.y1}px) rotate(0deg); opacity: 0; }
  93.6%     { transform: translate(${r.x}px, ${r.y}px) rotate(${r.r}deg); opacity: 0; }
  100%      { transform: translate(${r.x}px, ${r.y}px) rotate(${r.r}deg); opacity: 1; }
}
.bw-row-${i} { animation-name: ${prefix}${i}; }`).join('');

const restKf = (set, x1) => set.map((r, i) =>
  `.bw-rest-${i} { transform: translate(${x1}px, ${r.y1}px); }`).join('\n');

const rowCss = `
@media (prefers-reduced-motion: no-preference) {
${kf('bw-k', rows, 204, 240)}
${kf('bw-nk', rowsNarrow, 96, 112)}
}
${restKf(rows, 240)}
${restKf(rowsNarrow, 112)}
`;
---

<svg
  class="bw bw-wide"
  viewBox="0 0 640 380"
  role="img"
  aria-label="Loose repetitive tasks drift across the screen and a few get ticked off by hand. They gather, compile into one system, and a single click completes the whole list."
>
  {/* The app window the stack compiles into. Deliberately the same object
      §02's plate draws full size: the hero promises the screen and §02
      delivers it. */}
  <g class="bw-win">
    <rect x="120" y="32" width="400" height="316" rx="2" fill="var(--color-white)" stroke="var(--color-ink)" stroke-width="1" />
    <path d="M120 66 H520" fill="none" stroke="var(--color-rule)" stroke-width="1" />
    <g fill="var(--color-hair)">
      <circle cx="134" cy="49" r="3.5" /><circle cx="146" cy="49" r="3.5" /><circle cx="158" cy="49" r="3.5" />
    </g>
    <rect x="300" y="41" width="200" height="16" rx="8" fill="var(--color-wash)" />
    <text x="312" y="52.5" class="t-micro" fill="var(--color-faint)">app.yourbusiness.com</text>
    <path d="M232 66 V348" fill="none" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="146" y="98"  width="70" height="9" rx="4.5" fill="var(--color-accent-dark)" />
    <rect x="146" y="126" width="54" height="9" rx="4.5" fill="var(--color-rule)" />
    <rect x="146" y="154" width="62" height="9" rx="4.5" fill="var(--color-rule)" />
    <rect x="146" y="182" width="46" height="9" rx="4.5" fill="var(--color-rule)" />
    <rect x="424" y="100" width="84" height="72" rx="2" fill="var(--color-white)" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="424" y="184" width="84" height="72" rx="2" fill="var(--color-white)" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="424" y="268" width="84" height="72" rx="2" fill="var(--color-white)" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="440" y="70" width="60" height="20" rx="2" fill="var(--color-accent)" />
    <text x="470" y="83.5" text-anchor="middle" class="t-run" fill="var(--color-white)">RUN</text>
  </g>

  {rows.map((row, i) => (
    <g
      class={`bw-row bw-row-${i} bw-rest-${i}`}
    >
      <rect width="170" height="26" rx="2" fill="var(--color-white)" stroke="var(--color-hair)" stroke-width="1" />
      <rect x="9" y="7" width="12" height="12" rx="1" fill="none" stroke="var(--color-hair)" stroke-width="1" />
      <rect x="30" y="10.5" width={row.w} height="5" rx="2.5" fill="var(--color-rule)" />

      {/* The by-hand tick: drawn in ink, not accent, and slightly out of the
          box. A person did this one. */}
      {ticked.includes(i) && (
        <path
          class={`bw-tick bw-tick-${ticked.indexOf(i)}`}
          d="M11.6 13.6 L14.3 16.3 L19.6 10.3"
          fill="none" stroke="var(--color-ink)" stroke-width="1.9"
          stroke-linecap="round" stroke-linejoin="round"
        />
      )}

      {/* The done-by-software mark: a filled accent box, square in the middle,
          all nine landing 1.6% apart after one click. */}
      <g class={`bw-done bw-done-${i}`}>
        <rect x="9" y="7" width="12" height="12" rx="1" fill="var(--color-accent)" />
        <path d="M11.9 13.2 L14.4 15.7 L18.4 10.6" fill="none" stroke="var(--color-white)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  ))}

  <g class="bw-cur">
    <path d="M0 0 L0 17 L4.8 12.6 L7.7 18.6 L10.9 17.1 L8 11.2 L13.6 10.7 Z"
          fill="var(--color-ink)" stroke="var(--color-paper)" stroke-width="1" />
  </g>
</svg>

{/* The phone composition. A separate drawing rather than the wide one scaled:
    landmine 17 — SVG type is drawing-space, so shrinking the 640-unit canvas
    to 350px would take its 11px labels to 6px. Same swap at the same
    breakpoint as everything else on the page. */}
<svg
  class="bw bw-narrow"
  viewBox="0 0 300 250"
  role="img"
  aria-label="Loose repetitive tasks drift across the screen and a few get ticked off by hand. They gather, compile into one system, and a single click completes the whole list."
>
  <g class="bw-win">
    <rect x="56" y="24" width="196" height="204" rx="2" fill="var(--color-white)" stroke="var(--color-ink)" stroke-width="1" />
    <path d="M56 50 H252" fill="none" stroke="var(--color-rule)" stroke-width="1" />
    <g fill="var(--color-hair)">
      <circle cx="66" cy="37" r="2.6" /><circle cx="75" cy="37" r="2.6" /><circle cx="84" cy="37" r="2.6" />
    </g>
    <rect x="150" y="30" width="94" height="13" rx="6.5" fill="var(--color-wash)" />
    <text x="158" y="39.5" class="t-micro" fill="var(--color-faint)">app.yourbusiness.com</text>
    <path d="M108 50 V228" fill="none" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="68" y="74"  width="32" height="7" rx="3.5" fill="var(--color-accent-dark)" />
    <rect x="68" y="94"  width="24" height="7" rx="3.5" fill="var(--color-rule)" />
    <rect x="68" y="114" width="28" height="7" rx="3.5" fill="var(--color-rule)" />
    <rect x="208" y="78"  width="40" height="46" rx="2" fill="var(--color-white)" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="208" y="132" width="40" height="46" rx="2" fill="var(--color-white)" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="208" y="186" width="40" height="38" rx="2" fill="var(--color-white)" stroke="var(--color-rule)" stroke-width="1" />
    <rect x="212" y="54" width="36" height="16" rx="2" fill="var(--color-accent)" />
    <text x="230" y="65" text-anchor="middle" class="t-run" fill="var(--color-white)">RUN</text>
  </g>

  {rowsNarrow.map((row, i) => (
    <g
      class={`bw-row bw-row-${i} bw-rest-${i}`}
    >
      <rect width="88" height="20" rx="2" fill="var(--color-white)" stroke="var(--color-hair)" stroke-width="1" />
      <rect x="7" y="5" width="10" height="10" rx="1" fill="none" stroke="var(--color-hair)" stroke-width="1" />
      <rect x="24" y="8" width={row.w} height="4" rx="2" fill="var(--color-rule)" />
      {ticked.includes(i) && (
        <path
          class={`bw-tick bw-tick-${ticked.indexOf(i)}`}
          d="M9.2 10.6 L11.5 12.9 L15.9 8"
          fill="none" stroke="var(--color-ink)" stroke-width="1.7"
          stroke-linecap="round" stroke-linejoin="round"
        />
      )}
      <g class={`bw-done bw-ndone-${i}`}>
        <rect x="7" y="5" width="10" height="10" rx="1" fill="var(--color-accent)" />
        <path d="M9.4 10.2 L11.6 12.4 L15 8.2" fill="none" stroke="var(--color-white)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </g>
  ))}

  <g class="bw-cur bw-ncur">
    <path d="M0 0 L0 14 L4 10.4 L6.4 15.4 L9 14.1 L6.6 9.2 L11.2 8.8 Z"
          fill="var(--color-ink)" stroke="var(--color-paper)" stroke-width="1" />
  </g>
</svg>

<style is:inline set:html={rowCss}></style>

<style>
  /* ---------- type inside the drawing ----------
     Landmine 17: SVG type is drawing-space, not pixels. Rendered size is
     `value × (rendered width ÷ 640)`, so the same number is a different size in
     every column this drawing sits in.

     Two roles only, both micro labels, re-valued per breakpoint band rather
     than added to. Target is 8.5–12px rendered at every width. The bands and
     the arithmetic behind them:

       ≥1025px  figure ≈ 559px  scale .87   11 → 9.6
       821–1024 figure ≈ 418-482 scale .65-.75  13 → 8.5–9.8
       ≤820     stacked, capped 680, scale 1.06–1.02   9 → 9.5–9.2
       ≤724     scale 1.02–.87   10 → 10.2–8.7
       ≤600     scale .87–.68    13 → 11.3–8.8
       ≤480     scale .68–.54    16 → 10.9–8.6

     Re-run this arithmetic before changing the canvas or the hero grid. */
  .bw {
    display: block; width: 100%; height: auto; overflow: visible;
    --fs-micro: 11px;
  }
  .bw-narrow { display: none; }

  @media (max-width: 1024px) { .bw-wide { --fs-micro: 13px; } }
  @media (max-width:  820px) { .bw-wide { --fs-micro:  9px; } }
  @media (max-width:  724px) { .bw-wide { --fs-micro: 10px; } }

  /* Composition swap at 640, the same breakpoint as everything else on the
     page. Below it the wide drawing's arithmetic stops working: at 480px the
     640-unit canvas renders about 0.68:1, and no --fs-micro value keeps a
     label legible without it dwarfing the row it sits in.

     The narrow canvas is 300 units against roughly 350px of column, so it
     renders about 1.17:1 — the only composition on the site that renders
     larger than it is drawn. 6.5 and 7 land at 7.6 and 8.2px, at the bottom of
     the 8-12px band but on a drawing whose labels are texture rather than
     information. */
  @media (max-width: 640px) {
    .bw-wide   { display: none; }
    .bw-narrow { display: block; --fs-micro: 6.5px; }
    .bw-narrow .t-run { font-size: 7px; }
  }

  .t-micro {
    font-family: var(--font-mono); font-size: var(--fs-micro);
    letter-spacing: var(--tracking-wide);
  }
  .t-run {
    font-family: var(--font-mono); font-size: var(--fs-micro);
    letter-spacing: .1em;
  }

  /* ---------- the resting composition ----------
     Everything below the media query is what a visitor sees when motion is
     suppressed, and it is deliberately the END of the loop rather than the
     start: the window drawn, the nine rows stacked inside it, every one
     complete. The drawing's claim survives without a single frame of motion.

     The by-hand ticks are hidden at rest and the cursor with them: both are
     narrative, and a frozen cursor mid-canvas reads as a rendering fault. */
  .bw-tick { opacity: 0; }
  .bw-cur { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .bw-cur { opacity: 1; }

    /* Duration and iteration only. The names and the movement come from the
       generated literal keyframes above — see the note in the frontmatter. */
    .bw-row {
      animation-duration: 8s;
      animation-timing-function: cubic-bezier(.5, 0, .2, 1);
      animation-iteration-count: infinite;
    }

    /* The window fades up as the stack lands and clears before the reset. */
    @keyframes bw-win {
      0%, 45%    { opacity: 0; transform: scale(.96); }
      58%        { opacity: 1; transform: scale(1); }
      88.75%     { opacity: 1; transform: scale(1); }
      94%, 100%  { opacity: 0; transform: scale(.96); }
    }
    .bw-win {
      transform-box: fill-box; transform-origin: center;
      animation: bw-win 8s cubic-bezier(.4, 0, .2, 1) infinite;
    }

    /* Three ticks by hand, 8% apart, all clearing together at 73% as the rows
       square up and the checkboxes are about to be redrawn. */
    @keyframes bw-tick-0 { 0%,  8% { opacity: 0 }  9% { opacity: 1 } 72% { opacity: 1 } 73%, 100% { opacity: 0 } }
    @keyframes bw-tick-1 { 0%, 16% { opacity: 0 } 17% { opacity: 1 } 72% { opacity: 1 } 73%, 100% { opacity: 0 } }
    @keyframes bw-tick-2 { 0%, 24% { opacity: 0 } 25% { opacity: 1 } 72% { opacity: 1 } 73%, 100% { opacity: 0 } }
    .bw-tick   { animation-duration: 8s; animation-timing-function: linear; animation-iteration-count: infinite; }
    .bw-tick-0 { animation-name: bw-tick-0; }
    .bw-tick-1 { animation-name: bw-tick-1; }
    .bw-tick-2 { animation-name: bw-tick-2; }

    /* Nine completion marks, 1.6% apart after the click, all clearing at 93%.
       Written out rather than staggered with animation-delay: a delay on an
       infinite animation shifts the clear along with the appearance, which
       would leave marks showing on rows that have already scattered. */
    .bw-done   { opacity: 0; animation-duration: 8s; animation-timing-function: linear; animation-iteration-count: infinite; }
    @keyframes bw-done-0 { 0%, 74.0% { opacity: 0 } 75.1% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-1 { 0%, 75.6% { opacity: 0 } 76.7% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-2 { 0%, 77.2% { opacity: 0 } 78.3% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-3 { 0%, 78.8% { opacity: 0 } 79.9% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-4 { 0%, 80.4% { opacity: 0 } 81.5% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-5 { 0%, 82.0% { opacity: 0 } 83.1% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-6 { 0%, 83.6% { opacity: 0 } 84.7% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-7 { 0%, 85.2% { opacity: 0 } 86.3% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-done-8 { 0%, 86.8% { opacity: 0 } 87.9% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    .bw-done-0 { animation-name: bw-done-0 } .bw-done-1 { animation-name: bw-done-1 }
    .bw-done-2 { animation-name: bw-done-2 } .bw-done-3 { animation-name: bw-done-3 }
    .bw-done-4 { animation-name: bw-done-4 } .bw-done-5 { animation-name: bw-done-5 }
    .bw-done-6 { animation-name: bw-done-6 } .bw-done-7 { animation-name: bw-done-7 }
    .bw-done-8 { animation-name: bw-done-8 }

    /* Six completion marks rather than nine, so they are spaced 2.4% apart
       instead of 1.6% and still finish before the clear at 90%. Written out
       for the same reason the nine are: a delay on an infinite animation
       shifts the clear along with the appearance. */
    @keyframes bw-ndone-0 { 0%, 74.0% { opacity: 0 } 75.2% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-ndone-1 { 0%, 76.4% { opacity: 0 } 77.6% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-ndone-2 { 0%, 78.8% { opacity: 0 } 80.0% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-ndone-3 { 0%, 81.2% { opacity: 0 } 82.4% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-ndone-4 { 0%, 83.6% { opacity: 0 } 84.8% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    @keyframes bw-ndone-5 { 0%, 86.0% { opacity: 0 } 87.2% { opacity: 1 } 90% { opacity: 1 } 93%, 100% { opacity: 0 } }
    .bw-ndone-0 { animation-name: bw-ndone-0 } .bw-ndone-1 { animation-name: bw-ndone-1 }
    .bw-ndone-2 { animation-name: bw-ndone-2 } .bw-ndone-3 { animation-name: bw-ndone-3 }
    .bw-ndone-4 { animation-name: bw-ndone-4 } .bw-ndone-5 { animation-name: bw-ndone-5 }

    /* The cursor. Its three stops are the checkbox centres of rows 0, 2 and 5
       at their drift positions, so if a row's --x0/--y0 changes this keyframe
       changes with it. The scale dip is the press. It parks off-canvas from
       31% to 62% so it is not hovering over the compile, then travels to RUN. */
    @keyframes bw-cur {
      0%   { transform: translate(300px, 352px) scale(1); }
      5%   { transform: translate(23px, 39px) scale(1); }
      7%   { transform: translate(23px, 39px) scale(.82); }
      9%   { transform: translate(23px, 39px) scale(1); }
      13%  { transform: translate(165px, 101px) scale(1); }
      15%  { transform: translate(165px, 101px) scale(.82); }
      17%  { transform: translate(165px, 101px) scale(1); }
      21%  { transform: translate(311px, 159px) scale(1); }
      23%  { transform: translate(311px, 159px) scale(.82); }
      25%  { transform: translate(311px, 159px) scale(1); }
      31%, 62% { transform: translate(180px, 360px) scale(1); }
      70%  { transform: translate(470px, 80px) scale(1); }
      72%  { transform: translate(470px, 80px) scale(.82); }
      74%  { transform: translate(470px, 80px) scale(1); }
      88.75% { transform: translate(470px, 80px) scale(1); }
      100% { transform: translate(300px, 352px) scale(1); }
    }
    .bw-cur { animation: bw-cur 8s cubic-bezier(.45, 0, .25, 1) infinite; }

    /* The phone cursor. Same beats, different canvas — its three stops are the
       checkbox centres of narrow rows 0, 2 and 5 at their drift positions, and
       its RUN stop is that composition's button. */
    @keyframes bw-ncur {
      0%   { transform: translate(150px, 230px) scale(1); }
      5%   { transform: translate(19px, 27px) scale(1); }
      7%   { transform: translate(19px, 27px) scale(.82); }
