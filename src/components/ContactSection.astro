---
import { contact } from '../content/site';
---

<div class="cta-band" id="contact">
  <div class="wrap cta-in">
    <div>
      <div class="eyebrow">§ 07 · Start here</div>
      <h2 style="margin:16px 0 22px;max-width:13ch">Tell Thread what isn’t working.</h2>
      <p class="lead" style="max-width:48ch">
        A short description is enough to start. If it’s a fit, the next step is a
        twenty-five minute call. If it isn’t, you’ll get an honest answer and a pointer
        somewhere better.
      </p>

      <p class="contact-meta">
        <a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.location}
      </p>
    </div>

    {/* A native POST to a server endpoint — no client bundle, and it still
        works with JavaScript disabled. */}
    <form class="form" action="/api/contact" method="POST">
      {/* Honeypot. Positioned off-screen rather than display:none, which bots
          check for. Hidden from assistive tech and skipped by the tab order. */}
      <div class="hp" aria-hidden="true">
        <label for="f-company-website">Company website</label>
        <input
          id="f-company-website"
          name="company_website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <label for="f-name">Name</label>
      <input id="f-name" name="name" type="text" autocomplete="name" required />

      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required />

      <label for="f-biz">What does the business do?</label>
      <input id="f-biz" name="business" type="text" />

      <label for="f-stack">What software are you running?</label>
      <textarea
        id="f-stack"
        name="stack"
        placeholder="QuickBooks, Square, a scheduling app, and a lot of spreadsheets…"
      ></textarea>

      <button type="submit" class="btn">Request my systems map</button>
    </form>
  </div>
</div>

<style>
  .cta-band { background: var(--color-wash); border-top: 1px solid var(--color-rule); }

  /* ⚠️ Reproduces a shorthand collision in index.html rather than correcting it.
     There, `.cta-in{padding:88px 0}` and `.wrap{padding:0 40px}` are both single
     class selectors, so source order alone decides the winner:

       above 640px  →  padding 88px 0    (§07 content sits at x=130, while every
                                          other section sits at x=170 — the band
                                          is 40px out of alignment)
       at/below 640 →  padding 0 22px    (the later `@media(max-width:640px)
                                          .wrap` rule replaces the shorthand
                                          outright, deleting all 176px of
                                          vertical padding on phones)

     Astro's scoping raises this rule's specificity, so it would otherwise win at
     every width and change the rendering. Held bug-compatible pending a decision
     — see LAUNCH-CHECKLIST.md. The fix, if wanted, is `padding-block: 88px` and
     letting `.wrap` supply the horizontal padding. */
  .cta-in {
    display: grid; grid-template-columns: minmax(0, 1fr) 380px;
    gap: 64px; padding: 88px 0; align-items: start;
  }
  .contact-meta {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .1em;
    text-transform: uppercase; color: var(--color-faint);
    margin-top: 30px; line-height: 2;
  }
  .contact-meta a { color: var(--color-faint); }
  .contact-meta a:hover { color: var(--color-koa); }

  .form {
    background: var(--color-white); border: 1px solid var(--color-hair);
    border-radius: 3px; padding: 28px;
  }
  .hp {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .form label {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-faint);
    display: block; margin-bottom: 7px;
  }
  .form input, .form textarea {
    width: 100%; padding: 11px 13px; border: 1px solid var(--color-hair);
    border-radius: 2px; background: var(--color-paper);
    font-family: var(--font-sans); font-size: 14px;
    color: var(--color-ink); margin-bottom: 18px;
  }
  .form input:focus, .form textarea:focus {
    outline: 2px solid var(--color-line); outline-offset: -1px;
    border-color: var(--color-line);
  }
  .form textarea { resize: vertical; min-height: 82px; }
  .form .btn { width: 100%; text-align: center; }

  @media (max-width: 1000px) {
    .cta-in { grid-template-columns: 1fr; gap: 34px; }
  }
  /* see the note above — this is the original's accidental result, reproduced */
  @media (max-width: 640px) {
    .cta-in { padding: 0 22px; }
  }
</style>
