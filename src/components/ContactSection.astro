---
import { contact } from '../content/site';
import IntakeForm from './IntakeForm.astro';
---

<div class="cta-band" id="contact">
  <div class="wrap cta-in">
    <div>
      {/* This marker stays above the heading rather than moving to the right
          margin like §01 and §02. Those sections have an empty right third;
          this one has the form there. The rule is that the marker sits in the
          margin only where a margin exists. Same reason the margin-note branch
          of Section.astro keeps its eyebrow stacked. */}
      {/* Back to 04, 19 Aug 2026 evening: the merged section split out again,
          so the page has four numbered bands once more. */}
      <div class="eyebrow">04 · Start here</div>
      {/* First person singular, 17 Aug 2026. These were the last "us" and "we"
          on the page, and Thread is one person. */}
      <h2 style="margin:16px 0 22px;max-width:16ch">Tell me what is taking too much time.</h2>
      <p class="lead" style="max-width:38ch">
        If it is a fit, I will book a free 30-minute call. If not, I will tell you.
      </p>

      <p class="contact-meta">
        <a href={`mailto:${contact.email}`}>{contact.email}</a><br />{contact.location}
      </p>
    </div>

    <IntakeForm />
  </div>
</div>

<style>
  .cta-band {
    background-color:var(--color-wash); border-top:1px solid var(--color-rule);
    background-image:linear-gradient(to right, color-mix(in srgb, var(--color-rule) 50%, transparent) 1px, transparent 1px);
    background-size:88px 100%;
  }

  /* index.html had `.cta-in{padding:88px 0}` and `.wrap{padding:0 40px}` as two
     single-class selectors, so source order alone decided the winner. The
     result was accidental in both directions: §07 sat 40px out of alignment
     with every other section above 640px, and lost all 176px of its vertical
     padding below it.

     Both were reproduced faithfully until now. The band is being rebuilt and
     the phone case is a visible bug, so this is the fix the original's own
     shorthand was reaching for: padding-block here, horizontal padding left to
     .wrap at every width. §07 now starts at x=170 like everything else.

     This is the second deliberate deviation from index.html, after the submit
     button's font. Recorded in CLAUDE.md and LAUNCH-CHECKLIST.md. */
  /* Was minmax(0,1fr) 380px — the copy took roughly two thirds and the form
     was squeezed into a fixed 380px column. The form is the point of this
     section, so the proportions are reversed: the copy is capped and the form
     takes the rest. */
  .cta-in {
    display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 64px; padding-block: 88px; align-items: start;
  }
  .cta-note {
    font-family: var(--font-serif); font-size: var(--text-body); line-height: var(--leading-body);
    color: var(--color-faint); max-width: 46ch; margin-top: 18px;
  }
  .contact-meta {
    font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-faint);
    margin-top: 30px; line-height: var(--leading-body);
  }
  .contact-meta a { color: var(--color-faint); }
  .contact-meta a:hover { color: var(--color-koa); }

  @media (max-width: 1000px) {
    .cta-in { grid-template-columns: 1fr; gap: 34px; }
  }
  @media (max-width: 640px) {
    .cta-in { padding-block: 66px; }
  }
</style>
