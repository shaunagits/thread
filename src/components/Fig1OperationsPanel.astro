---
/**
 * Fig. 1 — Operations panel, annotated.
 *
 * Ported from index.html. Every coordinate, radius and path command is
 * unchanged; only the colour and font-family attributes were lifted into
 * classes so no hex sits in the component. The six leader lines and the
 * badge positions are the design — do not reflow them.
 */
---

<svg
  class="plate f-mono"
  viewBox="0 0 1180 520"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A concept drawing of an operations dashboard with six numbered callouts describing what each part does: live counts pulled from Jobber, revenue reconciled against QuickBooks, invoices sent automatically, one login with roles you control, a layout shaped to your process, and data that runs in your own account."
>
  <!-- ======== the panel ======== -->
  <rect class="f-panel" x="270" y="30" width="640" height="460" rx="4" stroke-width="1"/>
  <path class="f-rule" d="M270 66 H910" stroke-width="1"/>
  <circle class="f-ochre" cx="289" cy="49" r="4.5"/>
  <text class="f-plate" x="304" y="53" font-size="10" letter-spacing="1.1">OPERATIONS · SAMPLE ACCOUNT</text>

  <!-- sidebar -->
  <path class="f-rule" d="M338 66 V490" stroke-width="1"/>
  <g class="f-hair">
    <rect x="286" y="88" width="36" height="4.5" rx="2"/><rect x="286" y="110" width="28" height="4.5" rx="2"/>
    <rect x="286" y="132" width="34" height="4.5" rx="2"/><rect x="286" y="154" width="24" height="4.5" rx="2"/>
    <rect x="286" y="176" width="32" height="4.5" rx="2"/>
  </g>
  <rect class="f-ochre" x="278" y="125" width="3.5" height="20" rx="1.75"/>

  <!-- kpi tiles -->
  <g class="f-rule" stroke-width="1">
    <rect x="354" y="84" width="126" height="60" rx="2"/><rect x="490" y="84" width="126" height="60" rx="2"/>
    <rect x="626" y="84" width="126" height="60" rx="2"/><rect x="762" y="84" width="126" height="60" rx="2"/>
  </g>
  <g class="f-ink f-serif" font-size="25" font-weight="600" letter-spacing="-0.5">
    <text x="368" y="120">142</text><text x="504" y="120">$18.4k</text><text x="640" y="120">6</text><text x="776" y="120">94%</text>
  </g>
  <g class="f-faint" font-size="8.5" letter-spacing="0.8">
    <text x="368" y="136">OPEN JOBS</text><text x="504" y="136">UNBILLED</text>
    <text x="640" y="136">OVERDUE</text><text x="776" y="136">ON TIME</text>
  </g>

  <!-- chart -->
  <rect class="f-rule" x="354" y="166" width="350" height="150" rx="2" stroke-width="1"/>
  <text class="f-plate" x="368" y="188" font-size="9" letter-spacing="0.9">REVENUE BY WEEK</text>
  <g class="f-ochre">
    <rect x="368" y="266" width="18" height="34"/><rect x="406" y="246" width="18" height="54"/>
    <rect x="444" y="226" width="18" height="74"/><rect x="482" y="254" width="18" height="46"/>
    <rect x="520" y="212" width="18" height="88"/><rect x="558" y="236" width="18" height="64"/>
    <rect x="596" y="200" width="18" height="100"/><rect x="634" y="220" width="18" height="80"/>
    <rect x="672" y="240" width="18" height="60"/>
  </g>

  <!-- side list -->
  <rect class="f-rule" x="718" y="166" width="170" height="150" rx="2" stroke-width="1"/>
  <text class="f-plate" x="732" y="188" font-size="9" letter-spacing="0.9">TODAY</text>
  <g class="f-rule" stroke-width="1"><path d="M732 226 H874"/><path d="M732 258 H874"/></g>
  <g class="f-plate" font-size="9.5">
    <text x="732" y="218">4 crews dispatched</text><text x="732" y="250">2 invoices sent</text>
    <text x="732" y="282">1 needs your review</text>
  </g>

  <!-- table -->
  <text class="f-plate" x="354" y="346" font-size="9" letter-spacing="0.9">ACTIVE JOBS</text>
  <g class="f-rule" stroke-width="1"><path d="M354 376 H888"/><path d="M354 406 H888"/></g>
  <g class="f-plate" font-size="10">
    <text x="354" y="368">Kahala remodel · invoice queued</text>
    <text x="354" y="398">Waimea install · awaiting parts</text>
    <text x="354" y="428">ʻAiea maintenance · scheduled</text>
  </g>
  <g class="f-koa" font-size="8.5" text-anchor="end" letter-spacing="0.7">
    <text x="888" y="368">AUTO</text><text x="888" y="398">AUTO</text><text x="888" y="428">AUTO</text>
  </g>

  <!-- status bar -->
  <path class="f-rule" d="M270 448 H910" stroke-width="1"/>
  <circle class="f-ochre" cx="362" cy="468" r="3.5"/>
  <text class="f-faint" x="374" y="472" font-size="8.5" letter-spacing="0.7">SYNCED 42 SECONDS AGO · YOUR ACCOUNT</text>

  <!-- Says out loud that this is a drawing, not a screenshot of real client
       software. Sits below the panel so it reads as a plate annotation. -->
  <text class="f-koa" x="270" y="510" font-size="8.5" letter-spacing="0.7">CONCEPT DRAWING</text>

  <!-- ======== callouts ======== -->
  <g class="f-line" stroke-width="1">
    <path d="M270 113 H232"/><path d="M270 241 H232"/><path d="M270 396 H232"/>
    <path d="M910 113 H948"/><path d="M910 241 H948"/><path d="M910 468 H948"/>
  </g>
  <g class="f-line-fill">
    <circle cx="270" cy="113" r="2.5"/><circle cx="270" cy="241" r="2.5"/><circle cx="270" cy="396" r="2.5"/>
    <circle cx="910" cy="113" r="2.5"/><circle cx="910" cy="241" r="2.5"/><circle cx="910" cy="468" r="2.5"/>
  </g>
  {/* Badges carry numerals, so they take the koa fill with light text.
      Every other ochre fill in this plate holds no text and stays ochre. */}
  <g class="f-badge">
    <circle cx="220" cy="113" r="12"/><circle cx="220" cy="241" r="12"/><circle cx="220" cy="396" r="12"/>
    <circle cx="960" cy="113" r="12"/><circle cx="960" cy="241" r="12"/><circle cx="960" cy="468" r="12"/>
  </g>
  <g class="f-badge-num" font-size="11.5" font-weight="500" text-anchor="middle">
    <text x="220" y="117">1</text><text x="220" y="245">2</text><text x="220" y="400">3</text>
    <text x="960" y="117">4</text><text x="960" y="245">5</text><text x="960" y="472">6</text>
  </g>

  <!-- callout copy -->
  <g class="f-body f-sans" font-size="13" text-anchor="end">
    <text x="194" y="108">Live counts, pulled from</text>
    <text x="194" y="126">Jobber every 90 seconds</text>
    <text x="194" y="236">Revenue reconciled</text>
    <text x="194" y="254">against QuickBooks</text>
    <text x="194" y="391">Invoices sent the moment</text>
    <text x="194" y="409">a job is marked closed</text>
  </g>
  <g class="f-body f-sans" font-size="13">
    <text x="982" y="108">One login for the team.</text>
    <text x="982" y="126">You set who sees what.</text>
    <text x="982" y="236">Shaped around your</text>
    <text x="982" y="254">process, not a template</text>
    <text x="982" y="463">Runs in your account,</text>
    <text x="982" y="481">on your data. You own it.</text>
  </g>
</svg>

<style>
  .f-mono   { font-family: var(--font-mono); }
  .f-sans   { font-family: var(--font-sans); }
  .f-serif  { font-family: var(--font-serif); }

  .f-panel      { fill: var(--color-white); stroke: var(--color-hair); }
  .f-rule       { stroke: var(--color-rule); }
  .f-hair       { fill: var(--color-hair); }
  .f-ochre      { fill: var(--color-ochre); }
  .f-line       { stroke: var(--color-line); }
  .f-line-fill  { fill: var(--color-line); }
  .f-ink        { fill: var(--color-ink); }
  .f-badge      { fill: var(--color-koa); }
  .f-badge-num  { fill: var(--color-paper); }
  .f-plate      { fill: var(--color-plate); }
  .f-faint      { fill: var(--color-faint); }
  .f-koa        { fill: var(--color-koa); }
  .f-body       { fill: var(--color-body); }
</style>
