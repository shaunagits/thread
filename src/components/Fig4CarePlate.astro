---
/**
 * Fig. 4 — What ships with every build.
 *
 * Answers the bus-factor objection with a list instead of a reassurance, and
 * makes the care plan visible without a sales paragraph.
 *
 * The only compact plate in the set. It is rendered through
 * `<Figure narrow>`, which drops the 860px mobile min-width the wide plates
 * need — this one fits a phone, and forcing it to scroll sideways would waste
 * the one reason it earns its place.
 *
 * Ported from thread-figures-v1.html. Colours lifted into classes.
 */
---

<svg
  class="plate f-mono"
  viewBox="0 0 560 240"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A handover plate listing five things that ship with every build: the source code, written documentation, running in your own accounts, monitoring, and a standing monthly hour. The first three are included; the last two are part of the care plan."
>
  <rect class="f-panel" x="20" y="20" width="520" height="200" rx="4" stroke-width="1"/>
  <path class="f-rule" stroke-width="1" d="M20 58 H540"/>
  <circle class="f-ochre" cx="42" cy="39" r="4"/>
  <text class="f-plate" x="58" y="43" font-size="9.5" letter-spacing="1.1">SHIPS WITH EVERY BUILD</text>

  <g class="f-rule" stroke-width="1">
    <path d="M44 94 H516"/><path d="M44 124 H516"/><path d="M44 154 H516"/><path d="M44 184 H516"/>
  </g>
  <g class="f-body f-sans" font-size="13.5">
    <text x="44" y="86">The source, in your repository</text>
    <text x="44" y="116">A written plate: what it does, and why</text>
    <text x="44" y="146">Running in your accounts, on your data</text>
    <text x="44" y="176">Monitoring, so you hear it from Thread first</text>
    <text x="44" y="206">A standing hour each month, if you want it</text>
  </g>
  <g class="f-koa" font-size="8.5" letter-spacing="0.7" text-anchor="end">
    <text x="516" y="86">INCLUDED</text><text x="516" y="116">INCLUDED</text>
    <text x="516" y="146">INCLUDED</text><text x="516" y="176">CARE PLAN</text><text x="516" y="206">CARE PLAN</text>
  </g>
</svg>

<style>
  .f-mono { font-family: var(--font-mono); }
  .f-sans { font-family: var(--font-sans); }

  .f-panel { fill: var(--color-white); stroke: var(--color-hair); }
  .f-rule  { stroke: var(--color-rule); }
  .f-ochre { fill: var(--color-ochre); }
  .f-body  { fill: var(--color-body); }
  .f-plate { fill: var(--color-plate); }
  .f-koa   { fill: var(--color-koa); }
</style>
