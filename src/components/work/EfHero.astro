---
/**
 * EstimateFlow's hero composite: the estimator's desktop view of a project,
 * with the customer's phone intake overlapping it at the left and a dashed
 * flow cue from one to the other. Ported from
 * _docs/designs_091226/Hero Visual.dc.html, supplied by the owner 12 Sep
 * 2026, and built as drawn, with two exceptions recorded below.
 *
 * SCALING, WITHOUT SCRIPT. The design is a fixed 1200x900 stage. WindwardAir
 * fits its stage with a three-line fit() because it already carries a script;
 * this page carries none, so the stage sits inside an <svg viewBox="0 0 1200
 * 900"> in a <foreignObject>, which the browser scales like any other SVG.
 * Type inside is therefore stage-space, not pixels (landmine 17): a 15px
 * field label renders at 13.7px in the 1100px column and 4.4px on a 350px
 * phone. On a phone the composite is a picture of an app, not a thing to
 * read; the walkthrough shows the same screens one at a time at full size.
 *
 * ⚠️ RAISED, NOT FIXED: foreignObject and Safari. Absolutely positioned
 * children inside foreignObject have had bugs in older WebKit. Checked in
 * Chrome at build; the owner should look at it in Safari on the phone once.
 * If it misbehaves there, the fallback is the WindwardAir fit() script.
 *
 * Two changes from the supplied file:
 *  1. The desktop customer was "Dana Whitfield, 1420 NE Halsey St, Portland
 *     OR". The other two drawings on this page are Malia Santos in Pearl
 *     City, so this one is too: the page follows one inquiry.
 *  2. Three photo <image-slot>s became photo stand-ins (.efh-photo), as in
 *     EfAfter.
 *
 * Same rules as EfBefore.astro: the app's own palette and sizes, `ef`
 * custom properties on the root, the site's sans in place of Instrument Sans.
 *
 * ⚠️ EstimateFlow is a demonstration build, not a client. See work.ts.
 */
import EfPhone from './EfPhone.astro';
interface Props { class?: string }
const { class: klass } = Astro.props;
---

<figure class={['efh-fig', klass].filter(Boolean).join(' ')} aria-hidden="true">
  <svg class="efh-svg" viewBox="0 0 1200 900" xmlns="http://www.w3.org/2000/svg" role="presentation" focusable="false">
    <foreignObject x="0" y="0" width="1200" height="900">
      <div xmlns="http://www.w3.org/1999/xhtml" class="efh">
        <div class="efh-grid"></div>

        <!-- Desktop: estimator -->
        <div class="efh-desk">
          <div class="efh-chrome">
            <div class="efh-dots"><span></span><span></span><span></span></div>
            <div class="efh-url">app.estimateflow.com/projects/4821</div>
          </div>

          <div class="efh-body">
            <div class="efh-rail"><span class="efh-rail-on"></span><span></span><span></span><span></span></div>

            <div class="efh-main">
              <div class="efh-top">
                <div class="efh-title-wrap">
                  <div class="efh-title-row">
                    <div class="efh-title">Active residential leak</div>
                    <div class="efh-urgent"><span class="efh-urgent-dot"></span>High urgency</div>
                  </div>
                  <div class="efh-meta"><span>Project #4821</span><span>·</span><span>Submitted 4 min ago via customer intake</span></div>
                </div>
                <div class="efh-top-actions"><span class="efh-btn-line">Assign</span><span class="efh-btn-fill">Build estimate</span></div>
              </div>

              <div class="efh-cols">
                <div class="efh-col-main">
                  <div class="efh-panel">
                    <div class="efh-label">Customer &amp; property</div>
                    <div class="efh-fields">
                      <div class="efh-field"><span class="efh-k">Customer</span><span class="efh-v">Malia Santos</span></div>
                      <div class="efh-field"><span class="efh-k">Phone</span><span class="efh-v efh-num">(808) 555-0148</span></div>
                      <div class="efh-field"><span class="efh-k">Address</span><span class="efh-v">Pearl City, HI 96782</span></div>
                      <div class="efh-field"><span class="efh-k">Roof type</span><span class="efh-v">Asphalt shingle · 2 story</span></div>
                      <div class="efh-field"><span class="efh-k">Roof age</span><span class="efh-v efh-num">18 years</span></div>
                      <div class="efh-field"><span class="efh-k">Access</span><span class="efh-v">Driveway, west side</span></div>
                    </div>
                  </div>

                  <div class="efh-photos-wrap">
                    <div class="efh-photos-head"><span class="efh-label">Attached photos</span><span class="efh-k">3 from customer</span></div>
                    <div class="efh-photos"><div class="efh-photo"></div><div class="efh-photo"></div><div class="efh-photo"></div></div>
                  </div>
                </div>

                <div class="efh-col-side">
                  <div class="efh-panel efh-ready">
                    <div class="efh-ring-wrap">
                      <svg viewBox="0 0 118 118" class="efh-ring">
                        <circle cx="59" cy="59" r="49.5" fill="none" stroke="#EDF1EF" stroke-width="9"></circle>
                        <circle cx="59" cy="59" r="49.5" fill="none" stroke="#0F766E" stroke-width="9" stroke-linecap="round" stroke-dasharray="311" class="efh-ring-arc"></circle>
                      </svg>
                      <div class="efh-ring-text"><div class="efh-pct">92%</div><div class="efh-pct-l">ready</div></div>
                    </div>
                    <div class="efh-ready-note">Intake complete. Measurements and photos attached.</div>
                  </div>

                  <div class="efh-reco">
                    <div class="efh-reco-l">Recommended next action</div>
                    <div class="efh-reco-t">Send the emergency tarp quote, $840, and book inspection Tue 10 AM.</div>
                    <div class="efh-btn-fill efh-reco-btn">Send quote</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Phone: customer intake -->
        <div class="efh-phone"><EfPhone animated /></div>

        <!-- Flow cue: intake -> estimator -->
        <svg viewBox="0 0 1200 900" class="efh-cue">
          <path d="M146 200 C138 150 176 112 292 106" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" opacity="0.9"></path>
          <path d="M146 200 C138 150 176 112 292 106" fill="none" stroke="#0F766E" stroke-width="2.25" stroke-linecap="round" stroke-dasharray="7 7" opacity="0.85" class="efh-dash"></path>
          <polygon points="287,98 305,106 287,114" fill="#0F766E" opacity="0.9"></polygon>
          <circle r="5.5" fill="#0F766E" class="efh-dot-travel">
            <animateMotion dur="7s" repeatCount="indefinite" calcMode="linear" keyPoints="0;0;1;1" keyTimes="0;0.2;0.4;1" path="M146 200 C138 150 176 112 292 106"></animateMotion>
          </circle>
        </svg>
      </div>
    </foreignObject>
  </svg>
</figure>

<style>
  .efh-fig { margin: 0; width: 100%; }
  .efh-svg { display: block; width: 100%; height: auto; }

  .efh {
    --ef-ink: #14201C; --ef-text: #33443E; --ef-mid: #6E7C77; --ef-muted: #8A9792; --ef-cap: #7C8A85;
    --ef-line: #E6EAE8; --ef-line-2: #DCE2DF; --ef-ground: #F7F9F8;
    --ef-teal: #0F766E; --ef-red: #A8291C; --ef-red-bg: #FEF2F1; --ef-red-line: #F6D7D3; --ef-red-dot: #C2392A;
    position: relative; width: 1200px; height: 900px; overflow: hidden; box-sizing: border-box;
    background: radial-gradient(120% 90% at 22% 8%, #FDFEFD 0%, #EFF2F0 55%, #E4E9E6 100%);
    font-family: var(--font-sans); color: var(--ef-ink); line-height: 1.35;
  }
  .efh *, .efh *::before, .efh *::after { box-sizing: border-box; }
  .efh-grid {
    position: absolute; inset: 0;
    background-image: linear-gradient(#0f766e0a 1px, transparent 1px), linear-gradient(90deg, #0f766e0a 1px, transparent 1px);
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 45%, #000 0%, transparent 100%);
            mask-image: radial-gradient(70% 60% at 50% 45%, #000 0%, transparent 100%);
  }

  /* ---- desktop ---- */
  .efh-desk {
    position: absolute; left: 300px; top: 74px; width: 870px; height: 640px; border-radius: 14px;
    background: #fff; border: 1px solid var(--ef-line-2); overflow: hidden;
    box-shadow: 0 40px 90px -30px rgba(14,32,28,.28), 0 4px 12px rgba(14,32,28,.06);
  }
  .efh-chrome {
    display: flex; align-items: center; gap: 14px; height: 46px; padding: 0 16px;
    background: var(--ef-ground); border-bottom: 1px solid var(--ef-line);
  }
  .efh-dots { display: flex; gap: 7px; }
  .efh-dots span { width: 10px; height: 10px; border-radius: 50%; background: #DDE3E0; }
  .efh-url {
    flex: 1; max-width: 420px; height: 26px; border-radius: 13px; background: #fff; border: 1px solid var(--ef-line);
    display: flex; align-items: center; padding: 0 12px; font-size: 12px; color: var(--ef-cap); letter-spacing: .01em;
  }
  .efh-body { display: flex; height: 594px; }
  .efh-rail {
    width: 60px; flex: none; background: var(--ef-ground); border-right: 1px solid var(--ef-line);
    display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 16px 0;
  }
  .efh-rail span { width: 28px; height: 28px; border-radius: 8px; background: var(--ef-line); }
  .efh-rail .efh-rail-on { background: var(--ef-teal); }
  .efh-main { flex: 1; min-width: 0; padding: 26px 28px 26px 68px; display: flex; flex-direction: column; gap: 20px; }

  .efh-top { display: flex; align-items: flex-start; gap: 16px; }
  .efh-title-wrap {
    flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px;
    padding: 6px 10px; margin: -6px -10px; border-radius: 10px;
  }
  .efh-title-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .efh-title { font-size: 27px; font-weight: 600; letter-spacing: -.02em; }
  .efh-urgent {
    display: flex; align-items: center; gap: 6px; background: var(--ef-red-bg); border: 1px solid var(--ef-red-line);
    color: var(--ef-red); font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 999px;
    letter-spacing: .02em; text-transform: uppercase;
  }
  .efh-urgent-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ef-red-dot); }
  .efh-meta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ef-mid); }
  .efh-top-actions { flex: none; display: flex; gap: 8px; }
  .efh-btn-line { font-size: 13px; font-weight: 500; color: var(--ef-text); border: 1px solid var(--ef-line-2); border-radius: 8px; padding: 9px 14px; background: #fff; }
  .efh-btn-fill { font-size: 13px; font-weight: 600; color: #fff; border-radius: 8px; padding: 9px 14px; background: var(--ef-teal); }

  .efh-cols { display: grid; grid-template-columns: minmax(0, 1fr) 252px; gap: 20px; align-items: start; }
  .efh-col-main { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .efh-col-side { display: flex; flex-direction: column; gap: 14px; }
  .efh-panel { border: 1px solid var(--ef-line); border-radius: 12px; padding: 18px 20px; background: #fff; }
  .efh-label { font-size: 11px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; color: var(--ef-muted); }
  .efh-panel > .efh-label { display: block; margin-bottom: 14px; }
  .efh-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; }
  .efh-field { display: flex; flex-direction: column; gap: 3px; }
  .efh-k { font-size: 12px; color: var(--ef-cap); }
  .efh-v { font-size: 15px; font-weight: 500; }
  .efh-num { font-variant-numeric: tabular-nums; }

  .efh-photos-wrap { display: flex; flex-direction: column; gap: 10px; }
  .efh-photos-head { display: flex; align-items: baseline; justify-content: space-between; }
  .efh-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .efh-photo {
    height: 134px; border-radius: 10px; border: 1px solid var(--ef-line);
    background: linear-gradient(135deg, #E8EEEB 0%, #D5DEDA 55%, #C7D2CD 100%);
  }

  .efh-ready { padding: 18px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .efh-ring-wrap { position: relative; width: 118px; height: 118px; }
  .efh-ring { width: 118px; height: 118px; transform: rotate(-90deg); display: block; }
  .efh-ring-arc { stroke-dashoffset: 24.9; }
  .efh-ring-text { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; }
  .efh-pct { font-size: 29px; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .efh-pct-l { font-size: 11px; color: var(--ef-cap); letter-spacing: .02em; }
  .efh-ready-note { font-size: 13px; color: #5D6B66; text-align: center; line-height: 1.45; text-wrap: pretty; }

  .efh-reco { border: 1px solid #D6E4E0; border-radius: 12px; padding: 16px; background: #F5FAF8; box-shadow: 0 1px 2px rgba(16,24,32,.04); }
  .efh-reco-l { font-size: 11px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; color: var(--ef-teal); margin-bottom: 8px; }
  .efh-reco-t { font-size: 15px; font-weight: 500; line-height: 1.4; margin-bottom: 12px; text-wrap: pretty; }
  .efh-reco-btn { display: flex; align-items: center; justify-content: center; padding: 10px 12px; }

  /* ---- phone ---- */
  .efh-phone { position: absolute; left: 58px; top: 210px; }

  /* ---- flow cue ---- */
  .efh-cue { position: absolute; inset: 0; width: 1200px; height: 900px; pointer-events: none; overflow: visible; }

  /* ---- motion, the design's own, on its 7s cycle ---- */
  @media (prefers-reduced-motion: no-preference) {
    .efh-title-wrap { animation: efh-arrive 7s linear infinite; }
    .efh-urgent-dot { animation: efh-pulse 2.2s ease-in-out infinite; }
    .efh-ring-arc { animation: efh-ring 7s cubic-bezier(.2,.7,.2,1) infinite; }
    .efh-reco { animation: efh-lift 7s cubic-bezier(.2,.7,.2,1) infinite; }
    .efh-dash { animation: efh-dash 1.1s linear infinite; }
    .efh-dot-travel { animation: efh-dot 7s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) {
    .efh-dot-travel { display: none; }
  }
  @keyframes efh-dash { to { stroke-dashoffset: -28; } }
  @keyframes efh-dot { 0%, 19% { opacity: 0; } 24%, 38% { opacity: 1; } 43%, 100% { opacity: 0; } }
  @keyframes efh-arrive {
    0%, 38%  { background: rgba(15,118,110,0); }
    46%      { background: rgba(15,118,110,.10); }
    62%,100% { background: rgba(15,118,110,0); }
  }
  @keyframes efh-ring {
    0%, 40%   { stroke-dashoffset: 24.9; }
    44%, 45%  { stroke-dashoffset: 311; }
    66%, 100% { stroke-dashoffset: 24.9; }
  }
  @keyframes efh-lift {
    0%, 60%   { transform: translateY(0); box-shadow: 0 1px 2px rgba(16,24,32,.04); }
    68%       { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(15,118,110,.16); }
    82%, 100% { transform: translateY(0); box-shadow: 0 1px 2px rgba(16,24,32,.04); }
  }
  @keyframes efh-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
</style>
