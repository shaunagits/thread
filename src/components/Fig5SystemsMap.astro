---
/**
 * Fig. 5 — Systems map, specimen sheet.
 *
 * The most load-bearing plate on the page: §04 sells a deliverable, and nobody
 * requests something they can't picture. This is what a delivered map looks
 * like, and it doubles as the production template.
 *
 * Two things here are deliberate and shouldn't be "tidied":
 *
 *  - `SPECIMEN · NOT A REAL CLIENT` in the header rail. It stays. The whole
 *    point of the rebuild was that nothing on this page pretends to be a real
 *    engagement.
 *  - The third recommendation is "Don't build a CRM." Ranking a do-nothing
 *    third on a sample deliverable is the only place the restraint claim is
 *    evidence rather than assertion. Don't replace it with a fourth build.
 *
 * The two `~N WEEKS` figures are the only numbers on the plate. They illustrate
 * the format of a map's output, not Thread's quoted timings. If real service
 * durations get set, match them.
 *
 * Ported from thread-figures-v1.html. Colours lifted into classes.
 */
---

<svg
  class="plate f-mono"
  viewBox="0 0 1180 460"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A specimen systems map. Six process stages from enquiry to paid, with the tool handling each. Three of the five transitions are marked as manual. Below, a friction list and a ranked list of what to fix first, the third item being advice not to build anything."
>
  <!-- ======== sheet and header rail ======== -->
  <rect class="f-panel" x="20" y="20" width="1140" height="420" rx="4" stroke-width="1"/>
  <path class="f-rule" stroke-width="1" d="M20 62 H1160"/>
  <circle class="f-ochre" cx="42" cy="42" r="4.5"/>
  <text class="f-plate" x="58" y="46" font-size="10" letter-spacing="1.1">SYSTEMS MAP · LEAD TO INVOICE</text>
  <text class="f-koa" x="1138" y="46" font-size="9" letter-spacing="0.9" text-anchor="end">SPECIMEN · NOT A REAL CLIENT</text>

  <!-- ======== the six stages ======== -->
  <g class="f-hair-stroke" stroke-width="1">
    <rect x="52" y="96" width="150" height="46" rx="2"/>
    <rect x="237" y="96" width="150" height="46" rx="2"/>
    <rect x="422" y="96" width="150" height="46" rx="2"/>
    <rect x="607" y="96" width="150" height="46" rx="2"/>
    <rect x="792" y="96" width="150" height="46" rx="2"/>
    <rect x="977" y="96" width="150" height="46" rx="2"/>
  </g>
  <g class="f-ink f-serif" font-size="15" font-weight="600" text-anchor="middle">
    <text x="127" y="118">Enquiry</text><text x="312" y="118">Quote</text><text x="497" y="118">Scheduled</text>
    <text x="682" y="118">Work done</text><text x="867" y="118">Invoice</text><text x="1052" y="118">Paid</text>
  </g>
  <g class="f-faint" font-size="9" letter-spacing="0.7" text-anchor="middle">
    <text x="127" y="134">WEB FORM</text><text x="312" y="134">EMAIL</text><text x="497" y="134">SCHEDULER</text>
    <text x="682" y="134">FIELD NOTES</text><text x="867" y="134">QUICKBOOKS</text><text x="1052" y="134">BANK</text>
  </g>

  <!-- dashed transitions are the manual ones, and each carries a badge -->
  <g class="f-line" stroke-width="1.4" stroke-dasharray="3 4" stroke-linecap="round">
    <path d="M202 119 H210"/><path d="M229 119 H237"/>
    <path d="M387 119 H395"/><path d="M414 119 H422"/>
    <path d="M757 119 H765"/><path d="M784 119 H792"/>
  </g>
  <g class="f-line" stroke-width="1.4" stroke-linecap="round">
    <path d="M572 119 H607"/><path d="M942 119 H977"/>
  </g>
  <g class="f-badge">
    <circle cx="219.5" cy="119" r="9"/><circle cx="404.5" cy="119" r="9"/><circle cx="774.5" cy="119" r="9"/>
  </g>
  <g class="f-badge-num" font-size="10" font-weight="500" text-anchor="middle">
    <text x="219.5" y="123">1</text><text x="404.5" y="123">2</text><text x="774.5" y="123">3</text>
  </g>
  <g class="f-faint" font-size="8.5" letter-spacing="0.6" text-anchor="middle">
    <text x="589.5" y="104">AUTO</text><text x="959.5" y="104">AUTO</text>
  </g>

  <!-- ======== the two columns ======== -->
  <path class="f-rule" stroke-width="1" d="M52 176 H1128"/>
  <path class="f-rule" stroke-width="1" d="M600 200 V410"/>

  <text class="f-koa" x="52" y="204" font-size="9.5" letter-spacing="1.1">WHERE THE TIME GOES</text>
  <g class="f-ochre">
    <rect x="52" y="224" width="3.5" height="20" rx="1.75"/>
    <rect x="52" y="272" width="3.5" height="20" rx="1.75"/>
    <rect x="52" y="320" width="3.5" height="20" rx="1.75"/>
  </g>
  <g class="f-body f-sans" font-size="13">
    <text x="70" y="234">1 · Enquiry details re-keyed into the quote</text>
    <text x="70" y="252">template. Nothing carries across.</text>
    <text x="70" y="282">2 · Quote goes out as a PDF. Whether it came</text>
    <text x="70" y="300">back is tracked in someone’s head.</text>
    <text x="70" y="330">3 · Invoice is raised by hand once the crew</text>
    <text x="70" y="348">reports in, one to three days later.</text>
  </g>
  <text class="f-faint" x="52" y="392" font-size="9" letter-spacing="0.7">TIME COST ESTIMATED WITH YOU ON THE CALL</text>

  <text class="f-koa" x="628" y="204" font-size="9.5" letter-spacing="1.1">WHAT’S WORTH FIXING FIRST</text>
  <g class="f-ink f-serif" font-size="15" font-weight="600">
    <text x="628" y="236">Stop building the invoice by hand.</text>
    <text x="628" y="290">Let an accepted quote book itself.</text>
    <text x="628" y="344">Don’t build a CRM.</text>
  </g>
  <g class="f-body f-sans" font-size="12.5">
    <text x="628" y="256">Raises itself when a job closes. Removes 3.</text>
    <text x="628" y="310">Removes 1 and 2 in one go.</text>
    <text x="628" y="364">Your scheduler already does this. Turn it on.</text>
  </g>
  <g class="f-faint" font-size="9" letter-spacing="0.7" text-anchor="end">
    <text x="1128" y="236">~2 WEEKS</text>
    <text x="1128" y="290">~3 WEEKS</text>
    <text x="1128" y="344">NO COST · DO THIS FIRST</text>
  </g>
  <path class="f-rule" stroke-width="1" d="M628 372 H1128"/>
  <text class="f-faint" x="628" y="392" font-size="9" letter-spacing="0.7">YOURS TO KEEP · NO OBLIGATION ATTACHED</text>
</svg>

<style>
  .f-mono  { font-family: var(--font-mono); }
  .f-sans  { font-family: var(--font-sans); }
  .f-serif { font-family: var(--font-serif); }

  .f-panel       { fill: var(--color-white); stroke: var(--color-hair); }
  .f-hair-stroke { stroke: var(--color-hair); }
  .f-rule        { stroke: var(--color-rule); }
  .f-line        { stroke: var(--color-line); }
  .f-ochre       { fill: var(--color-ochre); }
  .f-ink         { fill: var(--color-ink); }
  .f-body        { fill: var(--color-body); }
  .f-faint       { fill: var(--color-faint); }
  .f-plate       { fill: var(--color-plate); }
  .f-koa         { fill: var(--color-koa); }
  /* numerals sit on koa with paper text, never on ochre — see landmine 5 */
  .f-badge       { fill: var(--color-koa); }
  .f-badge-num   { fill: var(--color-paper); }
</style>
