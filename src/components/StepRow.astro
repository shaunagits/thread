---
import { steps } from '../content/site';
---

<div class="steps">
  {steps.map((step) => (
    <div class="step">
      <span class="n">{step.n}</span>
      {/* h3, not the original's h4: the enclosing section heading is an h2,
          so h4 skipped a level. Renders identically. */}
      <h3>{step.title}</h3>
      <p>{step.body}</p>
    </div>
  ))}
</div>

<style>
  .steps {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    margin-top: 54px; border-top: 1px solid var(--color-rule);
  }
  .step { padding: 28px 30px 8px; border-right: 1px solid var(--color-rule); }
  .step:last-child { border-right: 0; }
  .step .n {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .15em;
    color: var(--color-koa); display: block; margin-bottom: 12px;
  }
  .step h3 {
    font-size: 21px; margin-bottom: 9px;
    font-family: var(--font-serif); font-weight: 500;
    letter-spacing: -.015em; line-height: 1.12;
  }
  .step p {
    font-family: var(--font-serif); font-size: 15.5px;
    line-height: 1.58; color: var(--color-body);
  }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr; }
    .step { border-right: 0; border-bottom: 1px solid var(--color-rule); padding: 26px 0 22px; }
    .step:last-child { border-bottom: 0; }
  }
</style>
