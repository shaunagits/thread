---
import { steps } from '../content/site';
---

<ol class="journey">
  {steps.map((step) => (
    <li class="step">
      <span class="n">{step.n}</span>
      <span class="label">{step.label}</span>
      <h3>{step.title}</h3>
      <p>{step.body}</p>
    </li>
  ))}
</ol>

<style>
  .journey {
    display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); gap:clamp(22px, 3vw, 52px);
    margin-top:54px; padding:0; list-style:none; position:relative;
  }
  .journey::before {
    content:''; position:absolute; left:17px; right:17px; top:17px;
    border-top:1px solid var(--color-hair);
  }
  .step { min-width:0; padding-top:54px; position:relative; }
  .n {
    position:absolute; top:0; left:0; z-index:1; width:34px; height:34px;
    display:grid; place-items:center; border:1px solid var(--color-hair); border-radius:50%;
    background:var(--color-paper); color:var(--color-koa); font-family:var(--font-mono); font-size:10px; letter-spacing:.04em;
  }
  .label { display:block; margin-bottom:12px; color:var(--color-koa); font-family:var(--font-mono); font-size:9.5px; letter-spacing:.14em; text-transform:uppercase; }
  h3 { margin-bottom:10px; font-size:clamp(22px, 2vw, 28px); line-height:1.1; }
  p { max-width:23ch; font-family:var(--font-serif); font-size:16px; line-height:1.58; color:var(--color-body); }
  @media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .n, h3 { transition:color .2s ease, border-color .2s ease, background .2s ease; }
    .step:hover .n { border-color:var(--color-koa); background:var(--color-koa); color:var(--color-paper); }
    .step:hover h3 { color:var(--color-koa); }
  }
  @media (max-width:760px) {
    .journey { grid-template-columns:1fr; gap:0; margin-top:42px; }
    .journey::before { left:17px; right:auto; top:17px; bottom:17px; border-top:0; border-left:1px solid var(--color-hair); }
    .step { padding:4px 0 40px 58px; }
    .step:last-child { padding-bottom:0; }
    .n { top:0; }
  }
</style>
