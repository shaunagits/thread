---
/**
 * §01's signals list: seven specific descriptions of repetitive work, then an
 * open eighth row for whatever the visitor's own is.
 *
 * New with the Style C redesign, 29 Aug 2026. It replaces nothing — the ocean
 * design had no equivalent, and this is the section that does the work the old
 * §01 lead was trying to do in one sentence ("The number that gets typed into
 * three systems…"). Seven named symptoms beat one summarising line because a
 * visitor recognises their own week in a list and does not in a paragraph.
 *
 * The eighth row is the point of the whole section. It is drawn open — dashed,
 * unnumbered in accent, with a cursor bar — so the list reads as extensible
 * rather than as a menu of the only seven things on offer.
 */
import { signals, signalOpen } from '../content/site';
---

<ul class="signals">
  {signals.map((text, i) => (
    <li class="sig">
      <span class="n">{String(i + 1).padStart(2, '0')}</span>
      <span class="bar" aria-hidden="true"></span>
      <span class="t">{text}</span>
    </li>
  ))}

  {/* Not a real entry, so it takes no number in sequence colour and its text
      sits back in --color-faint. The bar after the label is a text cursor:
      the row is a field the visitor fills in mentally. */}
  <li class="sig sig-open">
    <span class="n">{String(signals.length + 1).padStart(2, '0')}</span>
    <span class="bar" aria-hidden="true"></span>
    <span class="t">
      {signalOpen}
      <span class="caret" aria-hidden="true"></span>
    </span>
  </li>
</ul>

<style>
  .signals { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:12px; }

  .sig {
    display:flex; align-items:center; gap:22px;
    background:var(--color-white); border:1px solid var(--color-ink);
    padding:18px 26px;
  }

  /* Fixed width so the numerals form a column and the text edges align, which
     is what makes eight rows read as a list rather than eight cards. */
  .n {
    font-family:var(--font-mono); font-size:var(--text-nav);
    letter-spacing:.06em; color:var(--color-accent);
    flex:none; width:22px;
  }
  .bar { width:1px; height:24px; background:var(--color-rule); flex:none; }
  .t {
    font-size:var(--text-body); line-height:var(--leading-snug);
    color:var(--color-ink);
  }

  /* Drawn at 16.5px and shipped at --text-body (17). Half a pixel is not a
     hierarchy and these are prose a visitor reads. See the type scale note in
     global.css. */

  .sig-open {
    background:transparent; border:1px dashed var(--color-hair);
    padding:20px 26px;
  }
  .sig-open .n { color:var(--color-hair); }
  .sig-open .t {
    color:var(--color-faint);
    display:flex; align-items:center; gap:8px;
  }
  .caret {
    display:inline-block; width:2px; height:20px;
    background:var(--color-accent); opacity:.6;
  }

  /* The cursor blinks, because a static bar next to grey text reads as a
     stray rule rather than as an invitation. Motion-gated like everything
     else on the site, and the resting state is the bar simply present. */
  @media (prefers-reduced-motion: no-preference) {
    .caret { animation:sig-blink 1.15s steps(1, end) infinite; }
  }
  @keyframes sig-blink {
    0%, 55%  { opacity:.6; }
    56%, 99% { opacity:0; }
  }

  /* The vertical rule between the numeral and the text goes on a phone. It is
     an alignment cue for a wide row, and in a 350px column it costs 23px of
     measure to separate two things that are already 14px apart. The numeral
     takes a 3px nudge down so it sits on the first line's baseline once the
     text wraps to two or three lines. */
  @media (max-width:640px) {
    .signals { gap:10px; }
    .sig { gap:14px; padding:16px 18px; align-items:flex-start; }
    .sig-open { padding:16px 18px; }
    .bar { display:none; }
    .n { width:20px; padding-top:3px; font-size:11.5px; }
    .t { font-size:var(--text-ui); line-height:1.45; }
  }
</style>
