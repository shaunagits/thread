---
/**
 * Fig. 2 — Current state, typical intake.
 *
 * The "before" to Fig. 3's "after". Same five tool boxes, but the connections
 * are dashed and each one dips through an ochre node — a person carrying the
 * data by hand. Dashed means manual; Fig. 3's solid strokes mean automatic.
 * That contrast is the whole argument and it needs no legend, so don't make
 * one of them solid without changing the other.
 *
 * Ported from thread-figures-v1.html. Colours lifted into classes, per the
 * no-hex-in-components rule.
 */
---

<svg
  class="plate f-mono"
  viewBox="0 0 1000 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Five business tools in a row with four dashed connections between them. Each connection passes through a marked point representing a person doing the transfer by hand."
>
  <!-- the five tools -->
  <g class="f-hair-stroke" stroke-width="1">
    <rect x="30" y="24" width="140" height="34" rx="2"/>
    <rect x="216" y="24" width="140" height="34" rx="2"/>
    <rect x="402" y="24" width="140" height="34" rx="2"/>
    <rect x="588" y="24" width="140" height="34" rx="2"/>
    <rect x="774" y="24" width="140" height="34" rx="2"/>
  </g>
  <g class="f-plate" font-size="11" text-anchor="middle">
    <text x="100" y="46">Square POS</text>
    <text x="286" y="46">Jobber</text>
    <text x="472" y="46">Spreadsheets</text>
    <text x="658" y="46">QuickBooks</text>
    <text x="844" y="46">Email</text>
  </g>

  <!-- dashed = nothing here is automatic -->
  <g class="f-line" stroke-width="1.4" stroke-dasharray="3 4" stroke-linecap="round">
    <path d="M100 58 C100 140, 286 140, 286 58"/>
    <path d="M286 58 C286 140, 472 140, 472 58"/>
    <path d="M472 58 C472 140, 658 140, 658 58"/>
    <path d="M658 58 C658 140, 844 140, 844 58"/>
  </g>

  <!-- the ochre nodes are people -->
  <g class="f-ochre">
    <circle cx="193" cy="120" r="6"/>
    <circle cx="379" cy="120" r="6"/>
    <circle cx="565" cy="120" r="6"/>
    <circle cx="751" cy="120" r="6"/>
  </g>

  <g class="f-rule" stroke-width="1">
    <path d="M193 128 V166"/><path d="M379 128 V166"/>
    <path d="M565 128 V166"/><path d="M751 128 V166"/>
  </g>

  <g class="f-body" font-size="10.5" text-anchor="middle">
    <text x="193" y="184">typed in by hand</text>
    <text x="379" y="184">exported, re-imported</text>
    <text x="565" y="184">reconciled by hand</text>
    <text x="751" y="184">someone remembers</text>
  </g>
  <g class="f-faint" font-size="9.5" text-anchor="middle" letter-spacing="0.6">
    <text x="193" y="200">EVERY EVENING</text>
    <text x="379" y="200">TWICE A WEEK</text>
    <text x="565" y="200">EVERY FRIDAY</text>
    <text x="751" y="200">OR THEY DON’T</text>
  </g>

  <path class="f-rule" stroke-width="1" d="M30 236 H914"/>
  <circle class="f-ochre" cx="38" cy="260" r="3.5"/>
  <text class="f-faint" x="52" y="264" font-size="9.5" letter-spacing="0.9">
    FOUR HANDOFFS · NONE OF THEM AUTOMATIC · NONE OF THEM ON ANY INVOICE
  </text>
  <text class="f-koa" x="914" y="264" font-size="9" letter-spacing="0.9" text-anchor="end">
    CONCEPT DRAWING
  </text>
</svg>

<style>
  .f-mono { font-family: var(--font-mono); }

  .f-hair-stroke { stroke: var(--color-hair); }
  .f-rule        { stroke: var(--color-rule); }
  .f-line        { stroke: var(--color-line); }
  .f-ochre       { fill: var(--color-ochre); }
  .f-plate       { fill: var(--color-plate); }
  .f-body        { fill: var(--color-body); }
  .f-faint       { fill: var(--color-faint); }
  .f-koa         { fill: var(--color-koa); }
</style>
