---
// ⚠️ Fabricated case study, including all three metrics. Do not publish as
// written. See src/content/placeholders.ts and LAUNCH-CHECKLIST.md.
import { specimen } from '../content/placeholders';
---

<div class="specimen">
  <div class="spec-head">
    <span class="id">{specimen.id}</span>
    <span class="id">{specimen.scale}</span>
  </div>
  <div class="spec-body">
    <div class="spec-text">
      {specimen.paragraphs.map((p) => (
        <p><strong>{p.label}</strong> {p.body}</p>
      ))}
    </div>
    <div class="spec-figs">
      {specimen.figures.map((f) => (
        <div class="fig">
          <span class="v">{f.value}</span>
          <span class="k">{f.key}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .specimen {
    border: 1px solid var(--color-hair); border-radius: 3px;
    background: var(--color-white); overflow: hidden; margin-top: 48px;
  }
  .spec-head {
    display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    padding: 22px 32px; border-bottom: 1px solid var(--color-rule);
    background: var(--color-wash);
  }
  .spec-head .id {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .15em;
    text-transform: uppercase; color: var(--color-koa);
  }
  .spec-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 0; }
  .spec-text { padding: 34px 32px; }
  .spec-text p {
    font-family: var(--font-serif); font-size: 16.5px; line-height: 1.62;
    color: var(--color-body); margin-bottom: 14px; max-width: 54ch;
  }
  .spec-text strong { font-weight: 600; }
  .spec-figs { border-left: 1px solid var(--color-rule); padding: 34px 32px; }
  .fig {
    padding-bottom: 20px; margin-bottom: 20px;
    border-bottom: 1px solid var(--color-rule);
  }
  .fig:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .fig .v {
    font-family: var(--font-serif); font-size: 34px; font-weight: 600;
    color: var(--color-ink); letter-spacing: -.02em; line-height: 1.1;
  }
  .fig .k {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-faint);
    margin-top: 6px; display: block;
  }

  @media (max-width: 1000px) {
    .spec-body { grid-template-columns: 1fr; }
    .spec-figs {
      border-left: 0; border-top: 1px solid var(--color-rule);
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
    }
    .fig { border-bottom: 0; padding-bottom: 0; margin-bottom: 0; }
  }
  @media (max-width: 640px) {
    .spec-figs { grid-template-columns: 1fr; }
  }
</style>
