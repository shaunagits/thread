---
// ⚠️ Names, copy and pricing are placeholders — see src/content/placeholders.ts
import { products } from '../content/placeholders';
---

<div class="products">
  {products.map((product) => (
    <div class="card">
      <span class="tag">{product.tag}</span>
      <h3>{product.name}</h3>
      <p>{product.blurb}</p>
      <div class="price">{product.price}<small>{product.unit}</small></div>
      <ul>
        {product.features.map((feature) => <li>{feature}</li>)}
      </ul>
      <div class="foot">
        <a href={product.cta.href} class={product.cta.style}>{product.cta.label}</a>
      </div>
    </div>
  ))}
</div>

<style>
  .products {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 22px; margin-top: 52px;
  }
  .card {
    border: 1px solid var(--color-hair); border-radius: 3px;
    background: var(--color-white); padding: 30px 28px 28px;
    display: flex; flex-direction: column;
  }
  .card .tag {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-koa);
    margin-bottom: 16px; display: block;
  }
  .card h3 { margin-bottom: 10px; }
  .card .price {
    font-family: var(--font-serif); font-size: 32px; font-weight: 600;
    color: var(--color-ink); margin: 16px 0 4px; letter-spacing: -.02em;
  }
  .card .price small {
    font-size: 14px; font-weight: 400;
    color: var(--color-quiet); letter-spacing: 0;
  }
  .card p {
    font-family: var(--font-serif); font-size: 15.5px;
    line-height: 1.58; color: var(--color-body);
  }
  .card ul {
    list-style: none; margin: 18px 0 24px;
    padding-top: 18px; border-top: 1px solid var(--color-rule);
  }
  .card li {
    font-size: 13.5px; color: var(--color-body); padding-left: 18px;
    position: relative; margin-bottom: 9px; line-height: 1.5;
  }
  .card li::before {
    content: ''; position: absolute; left: 0; top: 8px;
    width: 8px; height: 1.5px; background: var(--color-line);
  }
  .card .foot { margin-top: auto; }
  .card .btn, .card .btn-ghost { width: 100%; text-align: center; padding: 12px 20px; }

  @media (max-width: 1000px) {
    .products { grid-template-columns: 1fr; }
  }
</style>
