---
/**
 * Layout guides. Development only.
 *
 * Base.astro renders this behind `import.meta.env.DEV`, so it is not in the
 * production build at all — no markup, no CSS, no bytes.
 *
 * What it draws, all from the same tokens the layout uses, so it can never
 * drift from the real thing:
 *   - the .wrap container edge (--col, 1180px) and its 40px gutters
 *   - twelve columns inside the content width
 *   - the 220px margin column (--side) the section markers and notes sit in
 *   - a horizontal rule every 8px for vertical rhythm
 *
 * Toggle with the checkbox, bottom left. CSS only, no JavaScript, so it cannot
 * leak a script into a site whose whole premise is not having one.
 */
---

<div class="devgrid">
  <input type="checkbox" id="devgrid-on" />
  <label for="devgrid-on">grid</label>
  <div class="devgrid-layers" aria-hidden="true">
    <div class="devgrid-wrap">
      <div class="devgrid-cols"></div>
      <div class="devgrid-side"></div>
    </div>
    <div class="devgrid-baseline"></div>
  </div>
</div>

<style>
  .devgrid label {
    position: fixed; left: 12px; bottom: 12px; z-index: 9999;
    font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-paper);
    background: var(--color-ink); padding: 6px 10px; cursor: pointer;
    opacity: .35;
  }
  .devgrid label:hover { opacity: 1; }
  .devgrid input { position: fixed; left: -100px; }
  .devgrid input:checked + label { opacity: 1; }

  .devgrid-layers { display: none; }
  .devgrid input:checked ~ .devgrid-layers {
    display: block; position: fixed; inset: 0; z-index: 9998; pointer-events: none;
  }

  .devgrid-wrap {
    max-width: var(--col); height: 100%; margin: 0 auto; padding: 0 40px;
    position: relative;
    /* the container edge and the gutter */
    background:
      linear-gradient(to right,
        color-mix(in srgb, var(--color-accent-dark) 30%, transparent) 0 1px,
        transparent 1px calc(100% - 1px),
        color-mix(in srgb, var(--color-accent-dark) 30%, transparent) calc(100% - 1px) 100%);
  }

  /* twelve columns across the content width */
  .devgrid-cols {
    height: 100%;
    background: repeating-linear-gradient(to right,
      color-mix(in srgb, var(--color-accent-dark) 11%, transparent) 0 calc((100% - 11 * 24px) / 12),
      transparent 0 calc((100% - 11 * 24px) / 12 + 24px));
  }

  /* the margin column that section markers and notes live in */
  .devgrid-side {
    position: absolute; top: 0; bottom: 0; right: 40px; width: var(--side);
    border-left: 1px dashed color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 4%, transparent);
  }

  .devgrid-baseline {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(to bottom,
      color-mix(in srgb, var(--color-ink) 7%, transparent) 0 1px,
      transparent 1px 8px);
  }
</style>
