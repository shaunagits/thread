---
/** The before state: useful tools, but a person carrying the work between them. */
---

<figure class="problem-flow">
  <svg viewBox="0 0 1040 340" role="img" aria-labelledby="flow-title flow-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="flow-title">The hidden work between business tools</title>
    <desc id="flow-desc">Accounting, payments, and orders rely on manual re-entry, checking, and remembering before work can move forward.</desc>

    <g class="tool source-one"><rect x="26" y="38" width="210" height="50" rx="2" /><text x="50" y="69">Accounting</text></g>
    <g class="tool source-two"><rect x="26" y="145" width="210" height="50" rx="2" /><text x="50" y="176">Payments</text></g>
    <g class="tool source-three"><rect x="26" y="252" width="210" height="50" rx="2" /><text x="50" y="283">Orders</text></g>

    <g class="manual-lines" fill="none" stroke-linecap="round">
      <path pathLength="1" class="line-one" d="M236 63C323 63 333 130 418 130" />
      <path pathLength="1" class="line-two" d="M236 170H418" />
      <path pathLength="1" class="line-three" d="M236 277C323 277 333 210 418 210" />
    </g>

    <g class="manual-actions">
      <circle cx="310" cy="94" r="4" /><text x="326" y="98">RE-ENTER</text>
      <circle cx="326" cy="170" r="4" /><text x="342" y="174">CHECK</text>
      <circle cx="310" cy="246" r="4" /><text x="326" y="250">REMEMBER</text>
    </g>

    <g class="manual-node">
      <rect x="418" y="128" width="126" height="84" rx="2" />
      <text class="node-label" x="481" y="160" text-anchor="middle">MANUAL</text>
      <text class="node-label" x="481" y="181" text-anchor="middle">WORK</text>
    </g>
    <path class="exit-line" pathLength="1" d="M544 170H592" />

    <g class="statement">
      <text class="statement-copy" x="622" y="151">The work lands</text>
      <text class="statement-copy" x="622" y="191">on your team.</text>
      <path d="M622 224H986" />
    </g>
  </svg>
</figure>

<style>
  .problem-flow { margin-top:46px; max-width:1040px; }
  svg { display:block; width:100%; height:auto; overflow:visible; }
  .tool rect, .manual-node rect { fill:var(--color-white); stroke:var(--color-hair); stroke-width:1; }
  .tool text { font-family:var(--font-serif); font-size:18px; fill:var(--color-ink); }
  .manual-lines { stroke:var(--color-hair); stroke-width:1.2; stroke-dasharray:3 6; }
  .manual-actions circle { fill:var(--color-line); }
  .manual-actions text, .node-label { font-family:var(--font-mono); font-size:10px; letter-spacing:.12em; fill:var(--color-faint); }
  .node-label { font-size:10.5px; letter-spacing:.16em; fill:var(--color-koa); }
  .exit-line { stroke:var(--color-line); stroke-width:1.3; }
  .statement-copy { font-family:var(--font-serif); font-size:31px; fill:var(--color-ink); letter-spacing:-.025em; }
  .statement path { stroke:var(--color-rule); stroke-width:1; }
  @keyframes flow-draw { to { stroke-dashoffset:0; } }
  @keyframes flow-reveal { to { opacity:1; } }
  @media (prefers-reduced-motion:no-preference) {
    .tool, .manual-actions, .manual-node, .statement { opacity:0; }
    .source-one { animation:flow-reveal .24s ease-out forwards .04s; }
    .source-two { animation:flow-reveal .24s ease-out forwards .12s; }
    .source-three { animation:flow-reveal .24s ease-out forwards .2s; }
    .manual-lines path, .exit-line { stroke-dasharray:1; stroke-dashoffset:1; animation:flow-draw .62s cubic-bezier(.5,0,.25,1) forwards; }
    .line-one { animation-delay:.28s; } .line-two { animation-delay:.36s; } .line-three { animation-delay:.44s; }
    .manual-actions { animation:flow-reveal .2s ease-out forwards .76s; }
    .manual-node { animation:flow-reveal .24s ease-out forwards .94s; }
    .exit-line { animation-delay:1.04s; }
    .statement { animation:flow-reveal .3s ease-out forwards 1.16s; }
  }
  @media (max-width:640px) { .problem-flow { margin-top:34px; } .statement-copy { font-size:34px; } .tool text { font-size:20px; } }
</style>
