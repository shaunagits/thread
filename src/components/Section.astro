---
/**
 * Shared section wrapper: the `<section>`, the `.wrap`, and the numbered rule
 * that marks the section.
 *
 * Rewritten 29 Aug 2026 for the Style C redesign. The previous version owned
 * the heading, an eyebrow label and an optional right-margin note on the `.doc`
 * grid. None of those survive:
 *
 *  - The marker is gone entirely. It carried a label ("01 · What I do") under
 *    the ocean design, became a bare number with Style C, and lost the number
 *    too on 29 Aug 2026 on the owner's instruction. What is left is the
 *    hairline it sat on, which opens the section above the heading.
 *  - Because the numbers are gone, the section wording now lives only in the
 *    nav and the footer, which must still agree with each other. See site.ts.
 *  - The heading moved into the sections themselves. Each of the three has a
 *    different internal grid (35/65, full width, 72/128) and a different
 *    relationship between heading, lead and content, so a shared heading slot
 *    was doing nothing but forcing three exceptions.
 *  - The `.doc` margin-note grid is unused by every section in this design.
 *    It survives in global.css for the legal pages.
 */
interface Props {
  id?: string;
  /** drop the top rule — for a section that follows one that draws its own */
  noRule?: boolean;
  /**
   * Drop the opening hairline, keeping the full-bleed boundary rule.
   *
   * Every section draws two rules: the `<section>`'s own `border-top`, which
   * is the boundary between sections and runs edge to edge, and this hairline
   * 100px below it, at column width, which opens the section's heading. A
   * section with no heading leaves the hairline opening nothing, and the two
   * lines then read as one divider drawn twice — 100px of empty space between
   * them and small body copy underneath. Added 2 Sep 2026 for #problem, whose
   * heading the owner removed.
   */
  noHairline?: boolean;
  /** put the section on the quiet ground */
  wash?: boolean;
  /** draw the ruled background behind the section */
  ruled?: boolean;
  /** extra classes */
  class?: string;
}

const { id, noRule = false, noHairline = false, wash = false, ruled = false, class: klass } = Astro.props;

const classes = [
  noRule && 'no-rule',
  wash && 'on-wash',
  ruled && 'ruled',
  klass,
].filter(Boolean).join(' ');
---

<section id={id} class={classes || undefined}>
  <div class="wrap">
    {!noHairline && <hr class="section-rule" />}
    <slot />
  </div>
</section>
