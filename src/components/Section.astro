---
/**
 * Shared section wrapper: the `<section>`, the `.wrap`, and the numbered rule
 * that marks the section.
 *
 * Rewritten 29 Aug 2026 for the Style C redesign. The previous version owned
 * the heading, an eyebrow label and an optional right-margin note on the `.doc`
 * grid. None of those survive:
 *
 *  - The marker is a bare number on a full-width rule, above the heading. It
 *    carried a label ("01 · What I do") until this change, and the standing
 *    rule was that the nav had to match those labels exactly. Style C drops
 *    them, so the section wording now lives only in the nav and the footer,
 *    which must still agree with each other. See site.ts.
 *  - The marker is above the heading again, where it sat before 25 Aug 2026.
 *    It reads as a section number on a rule here rather than as a stray label
 *    opposite a heading, which is what moved it below in the first place.
 *  - The heading moved into the sections themselves. Each of the three has a
 *    different internal grid (35/65, full width, 72/128) and a different
 *    relationship between heading, lead and content, so a shared heading slot
 *    was doing nothing but forcing three exceptions.
 *  - The `.doc` margin-note grid is unused by every section in this design.
 *    It survives in global.css for the legal pages.
 */
interface Props {
  id?: string;
  /** the section number, e.g. "01" */
  n: string;
  /** drop the top rule — for a section that follows one that draws its own */
  noRule?: boolean;
  /** put the section on the quiet ground */
  wash?: boolean;
  /** draw the ruled background behind the section */
  ruled?: boolean;
  /** extra classes */
  class?: string;
}

const { id, n, noRule = false, wash = false, ruled = false, class: klass } = Astro.props;

const classes = [
  noRule && 'no-rule',
  wash && 'on-wash',
  ruled && 'ruled',
  klass,
].filter(Boolean).join(' ');
---

<section id={id} class={classes || undefined}>
  <div class="wrap">
    <div class="marker"><span>{n}</span></div>
    <slot />
  </div>
</section>
