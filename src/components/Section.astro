---
/**
 * Shared section wrapper: the "§ NN — Label" eyebrow, the heading, and an
 * optional margin note in the right-hand column.
 *
 * Passing anything into the `note` slot switches the section to the annotated
 * document grid; without it the section runs full width. The `after` slot is
 * for content that sits below the grid at full width — the services list, the
 * product cards, the step row.
 */
interface Props {
  id?: string;
  /** e.g. "§ 01 — The problem" */
  eyebrow: string;
  heading: string;
  /** max-width of the heading, in ch — matches the original's inline styles */
  headingWidth: number;
  /** bottom margin under the heading; §01 is the only section using 24 */
  headingGap?: number;
  /** mono label above the margin note, e.g. "In the margin" */
  noteLabel?: string;
  /** gap under the document grid, where the original set one inline */
  docGap?: number;
}

const {
  id,
  eyebrow,
  heading,
  headingWidth,
  headingGap = 22,
  noteLabel,
  docGap,
} = Astro.props;

const hasNote = Astro.slots.has('note');
/* The marker sits below the heading as a sub-title since 25 Aug 2026, on the
   owner's instruction. The heading keeps 16px to the marker and the marker
   takes the old heading gap down to the content, so the section's total
   rhythm is unchanged. */
const headStyle = `margin:0 0 16px;max-width:${headingWidth}ch`;
const eyebrowStyle = `margin-bottom:${headingGap}px`;
---

<section id={id}>
  <div class="wrap">
    {hasNote ? (
      <div class="doc" style={docGap ? `margin-bottom:${docGap}px` : undefined}>
        <div>
          <h2 style={headStyle}>{heading}</h2>
          <div class="eyebrow" style={eyebrowStyle}>{eyebrow}</div>
          <slot />
        </div>
        <aside class="side">
          {noteLabel && <span class="lbl">{noteLabel}</span>}
          <slot name="note" />
        </aside>
      </div>
    ) : (
      <>
        {/* The marker was above the heading until 25 Aug 2026 (and briefly in
            the right margin on 17 Aug, moved back the same day). It now sits
            below the heading as a sub-title, on the owner's instruction. */}
        <h2 style={headStyle}>{heading}</h2>
        <div class="eyebrow" style={eyebrowStyle}>{eyebrow}</div>
        <slot />
      </>
    )}
    <slot name="after" />
  </div>
</section>
