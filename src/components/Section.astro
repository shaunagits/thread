---
/**
 * Shared section wrapper: the "§ NN — Label" eyebrow, the heading, and an
 * optional margin note in the right-hand column.
 *
 * Passing anything into the `note` slot switches the section to the annotated
 * document grid; without it the section runs full width. The `after` slot is
 * for content that sits below the grid at full width — the services list, the
 * product cards, the step row.
 *
 * `split` is a third arrangement, added 18 Aug 2026 for §03: the eyebrow,
 * heading and copy in a left column with the `aside` slot beside them. Unlike
 * the other two it puts the heading inside the grid, which is the whole point —
 * the copy block has to be the left column, not sit above it.
 */
interface Props {
  id?: string;
  /** e.g. "§ 01 — The problem" */
  eyebrow: string;
  heading: string;
  /** max-width of the heading, in ch — matches the original's inline styles */
  headingWidth: number;
  /** bottom margin under the heading; §01 is the only section using 24 */
  headingGap?: number;
  /** mono label above the margin note, e.g. "In the margin" */
  noteLabel?: string;
  /** two equal columns: eyebrow + heading + default slot left, `aside` right */
  split?: boolean;
  /** gap under the document grid, where the original set one inline */
  docGap?: number;
}

const {
  id,
  eyebrow,
  heading,
  headingWidth,
  headingGap = 22,
  noteLabel,
  split = false,
  docGap,
} = Astro.props;

const hasNote = Astro.slots.has('note');
const headStyle = `margin:16px 0 ${headingGap}px;max-width:${headingWidth}ch`;
---

<section id={id}>
  <div class="wrap">
    {split ? (
      <div class="split">
        <div>
          <div class="eyebrow">{eyebrow}</div>
          <h2 style={headStyle}>{heading}</h2>
          <slot />
        </div>
        <div class="split-aside"><slot name="aside" /></div>
      </div>
    ) : hasNote ? (
      <div class="doc" style={docGap ? `margin-bottom:${docGap}px` : undefined}>
        <div>
          <div class="eyebrow">{eyebrow}</div>
          <h2 style={headStyle}>{heading}</h2>
          <slot />
        </div>
        <aside class="side">
          {noteLabel && <span class="lbl">{noteLabel}</span>}
          <slot name="note" />
        </aside>
      </div>
    ) : (
      <>
        {/* The marker sits above the heading. It was moved into the right
            margin on 17 Aug 2026 to give the empty right third a job, and
            moved back the same day: opposite a heading it read as a stray
            label rather than an annotation. The whitespace is the better
            problem to have. */}
        <div class="eyebrow">{eyebrow}</div>
        <h2 style={headStyle}>{heading}</h2>
        <slot />
      </>
    )}
    <slot name="after" />
  </div>
</section>

<style>
  /* Mirrors .doc exactly — the same 56px gap and the same 1000px collapse to a
     single column at 34px — so a split section reflows on the page's existing
     beat instead of introducing a breakpoint of its own. No new spacing values.

     minmax(0, 1fr) twice rather than 1fr twice: a bare 1fr floors at the
     content's min-width, and the right column carries a list whose longest row
     would otherwise refuse to shrink and push the grid wider than .wrap. */
  .split {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px; align-items: start;
  }

  /* Astro scoped styles do not cross slot boundaries — landmine 7 — so the
     slotted component's own class is unreachable from here without :global.
     The list carries a 40px top margin for the stacked arrangement it was
     built for; beside the copy it should start on the heading's line. */
  .split-aside :global(.ships) { margin-top: 0; }

  @media (max-width: 1000px) {
    .split { grid-template-columns: 1fr; gap: 34px; }
  }
</style>
