---
import { steps } from '../content/site';

/**
 * The process, as a vertical timeline.
 *
 * Replaces StepRow's four-across grid. The reason is contrast: the hero and the
 * dashboard plate are both horizontal flows built out of hairline rectangles,
 * and StepRow was a third horizontal row of hairline circles, so the page read
 * as one diagram repeated three times. This has no boxes at all. It is a line,
 * four marks on it, and text in a margin, which is the annotated-document
 * idiom the design already owns and the only place on the page that uses it.
 *
 * Going vertical also removes a breakpoint problem rather than creating one:
 * four columns had to collapse on a phone, a vertical list is already the shape
 * a phone wants, so the same composition works at every width.
 *
 * The spine is drawn twice. The faint one is the whole path, present from the
 * start. The accent one grows downward as the section scrolls, so the timeline
 * fills in as you read it. That uses animation-timeline: view(), which Firefox
 * still has behind a flag, so it sits behind @supports and the unsupported path
 * lands on the finished composition rather than an empty one — the rule
 * CLAUDE.md sets for scroll-driven work.
 */
---

<ol class="timeline">
  {/* A step may carry an `id` — step 05 is the old #ownership block folded
      into the arc on 19 Aug 2026, and indexed /#ownership links land on it.
      The scroll-margin below is what keeps that landing clear of the sticky
      header, since a list item has no section padding to absorb it. */}
  {steps.map((step) => (
    <li class="tl-step" id={'id' in step ? step.id : undefined}>
      <span class="tl-n">{step.n}</span>
      <span class="tl-node" aria-hidden="true"></span>
      <div class="tl-body">
        <span class="tl-label">{step.label}</span>
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  /* The spine sits on the section's own left edge and the content is indented
     a single step from it, so §02 lines up with §01 and §03 instead of sitting
     96px inboard of them. It used to reserve a 96px margin column for the step
     numbers, which read as a misalignment rather than as an annotation, because
     nothing else on the page has that column. The numbers moved above their
     labels instead — where they were already going on a phone, so this also
     removes a breakpoint. */
  /* Horizontal since 18 Aug 2026, on the owner's instruction. The steps read
     left to right along a single thread rather than down one, which suits a
     process better and takes roughly a third of the height. The spine runs
     above the content and the nodes hang from it; below 1000px, where five
     columns cannot hold a sentence, the whole thing returns to the vertical
     composition it had — see the media query at the end.

     Five columns since 19 Aug 2026, when the ownership copy became step 05:
     the engagement ends with the system being yours, so the arc ends there
     too, on the node the design already fills as the arrival. The collapse
     breakpoint moved 820 → 1000 in the same change — four columns held a
     sentence at 850px, five do not — reusing the width ServiceList and the
     contact band already change at. */
  .timeline {
    position: relative; list-style: none; margin-top: 56px;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 34px; padding-top: 32px;
  }

  /* The full path, always present. Faded at both ends so it reads as a thread
     passing through rather than a rule that starts and stops. */
  .timeline::before,
  .timeline::after {
    content: ''; position: absolute; left: 0; right: 0; top: 5px; height: 1px;
  }
  .timeline::before {
    background: linear-gradient(to right,
      transparent 0,
      var(--color-rule) 5%,
      var(--color-rule) 95%,
      transparent 100%);
  }
  /* The accent spine, drawn over the faint one as the section scrolls. */
  .timeline::after {
    background: linear-gradient(to right,
      transparent 0,
      var(--color-line) 5%,
      var(--color-line) 95%,
      transparent 100%);
    transform-origin: left;
  }

  .tl-step { position: relative; scroll-margin-top: 104px; }

  .tl-n {
    display: block; margin-bottom: 7px;
    font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: var(--tracking-wide);
    color: var(--color-faint);
  }

  /* On the spine, at each column's left edge. The list has 32px of top padding
     and the spine sits at 5px inside it, so the 11px node starts 32px above its
     own step to land centred on the line. */
  .tl-node {
    position: absolute; left: 0; top: -32px; width: 11px; height: 11px;
    border-radius: 50%; background: var(--color-paper);
    border: 1px solid var(--color-line);
  }
  /* The last one is the arrival, so it is filled rather than open. */
  .tl-step:last-child .tl-node { background: var(--color-line); }

  .tl-label {
    display: block; margin-bottom: 10px;
    font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: var(--tracking-wide);
    text-transform: uppercase; color: var(--color-koa);
  }
  .tl-step h3 {
    margin-bottom: 10px; max-width: 20ch;
    font-size: var(--text-d3); line-height: var(--leading-tight);
  }
  .tl-step p {
    max-width: 46ch; font-family: var(--font-serif); font-size: var(--text-body);
    line-height: var(--leading-body); color: var(--color-body);
  }

  /* The from-state lives in the keyframes, NOT in the rule. That is the whole
     point: if the animation declaration is ever dropped — by a minifier, an
     unsupported value, anything — the content renders normally instead of
     staying at opacity 0 forever. Never write `opacity: 0` outside a keyframe
     for a scroll-driven reveal. */
  @keyframes tl-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }
  /* scaleX, not scaleY — the spine runs across now. Paired with
     transform-origin: left so it draws in reading order. */
  @keyframes tl-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  /* The narrow composition puts the spine back on its side, so it needs its own
     axis. Reusing tl-grow there would scale a 1px-wide vertical rule's width
     and never draw it — silently, and only on phones. */
  @keyframes tl-grow-y {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhands, not the `animation` shorthand. Lightning CSS folds
         `animation-timeline` into the shorthand when it can, producing
         `animation: linear both tl-in view()`, which no browser parses — so the
         whole declaration is dropped and the element keeps whatever hidden
         state the rule set. It only happens in production, because the dev
         server does not minify. See landmine 22. */
      .tl-step {
        animation-name: tl-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 12% cover 34%;
      }
      .timeline::after {
        animation-name: tl-grow;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 18% cover 78%;
      }
      /* Same breakpoint as the layout below, so the spine's axis and the
         keyframe driving it can never disagree. */
      @media (max-width: 1000px) {
        .timeline::after { animation-name: tl-grow-y; }
      }
    }
  }

  /* Back to vertical below 1000px — five columns cannot hold a sentence
     under it, and 1000 is the width ServiceList and the contact band already
     change at. Every horizontal rule is undone here rather than the other way
     round, so the narrow composition is the plain one. */
  @media (max-width: 1000px) {
    .timeline {
      grid-template-columns: 1fr; gap: 0;
      padding-top: 0; padding-left: 34px;
    }
    .timeline::before,
    .timeline::after {
      left: 0; right: auto; top: 4px; bottom: 4px; width: 1px; height: auto;
    }
    .timeline::before {
      background: linear-gradient(transparent 0, var(--color-rule) 5%,
        var(--color-rule) 95%, transparent 100%);
    }
    .timeline::after {
      background: linear-gradient(transparent 0, var(--color-line) 5%,
        var(--color-line) 95%, transparent 100%);
      transform-origin: top;
    }
    .tl-step { padding-bottom: 54px; }
    .tl-step:last-child { padding-bottom: 0; }
    .tl-node { left: -39px; top: 5px; }
  }
  @media (max-width: 640px) {
    .timeline { margin-top: 40px; padding-left: 28px; }
    .tl-node { left: -33px; }
    .tl-step { padding-bottom: 40px; }
  }
</style>
