---
const services = [
  ['Connect', 'Bring the tools you already use into one clear view.'],
  ['Automate', 'Let routine work move without someone chasing it.'],
  ['Build', 'Make the missing piece when no product fits your process.'],
];
---
<div class="service-line">
  {services.map(([title, body], index) => <article class="service"><span class="service-number">0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}
</div>
<style>
  .service-line {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px;
    position: relative; padding-top: 42px; margin-top: 52px;
  }
  .service-line::before {
    content: ''; position: absolute; top: 4px; left: 0; right: 0;
    border-top: 1px solid var(--color-hair);
  }
  .service { position: relative; padding-top: 20px; }
  .service::before {
    content: ''; position: absolute; top: -1px; left: 0; width: 9px; height: 9px;
    border: 2px solid var(--color-paper); border-radius: 50%; background: var(--color-line);
  }
  .service-number {
    display: block; font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em;
    color: var(--color-koa); margin-bottom: 16px;
  }
  .service h3 { margin-bottom: 11px; font-size: clamp(26px, 2.4vw, 32px); }
  .service p {
    font-family: var(--font-sans); font-size: 15px; line-height: 1.65;
    color: var(--color-body); max-width: 29ch;
  }
  @media (max-width: 720px) {
    .service-line { grid-template-columns: 1fr; gap: 30px; margin-top: 38px; padding-top: 0; }
    .service-line::before { left: 3px; right: auto; top: 4px; bottom: 4px; border-top: 0; border-left: 1px solid var(--color-hair); }
    .service { padding: 0 0 0 28px; }
    .service::before { top: 1px; left: -1px; }
  }
</style>
