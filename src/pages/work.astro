---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import EfHero from '../components/work/EfHero.astro';
import { caseStudies } from '../content/work';
import { cta, ctaHref } from '../content/site';
import { audit } from '../content/site-v2';

/**
 * The Work index. One card per entry in src/content/work.ts, linking to
 * /work/[slug].
 *
 * This was a noindex holding page ("Being written.") from 17 Aug 2026 until
 * 12 Sep 2026, when the owner published the first case study and switched
 * the page on: the nav entry in site.ts, the robots.txt Disallow and the
 * sitemap filter in astro.config.mjs all flipped in the same commit, as the
 * holding page's own comment said they should. The holding copy is in git
 * if the page ever has to go dark again.
 *
 * The first entry is a demonstration build published on the owner's
 * explicit instruction. Read the header of work.ts before adding to it.
 *
 * Cards are drawn by key, like the template: a case study whose hero is not
 * an EstimateFlow drawing needs a case added to the figure below.
 */
---

<Base
  title="Work · Thread"
  description="Custom software and automation built by Thread, Honolulu: what was built, what it replaced, and what changed."
>
  <Header />

  <section class="hero wk-hero">
    <div class="wrap">
      <p class="eyebrow">Work</p>
      <h1>What this looks like, built.</h1>
      <p class="lead wk-intro">
        One job at a time, from the first message to the finished screen. Each page follows a single piece of work through the software that now runs it.
      </p>
    </div>
  </section>

  <Section class="wk-list">
    <ol class="wk-cards">
      {caseStudies.map((study) => (
        <li class="wk-card">
          <a href={`/work/${study.slug}`} class="wk-link">
            <div class="wk-fig">
              {study.hero === 'ef-hero' && <EfHero />}
            </div>
            <div class="wk-copy">
              <p class="eyebrow">{study.eyebrow}</p>
              <h2 class="wk-title">{study.title}</h2>
              <p class="wk-intro-sm">{study.intro}</p>
              <span class="btn-ghost wk-more">Read the case study<span class="u" aria-hidden="true"></span></span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </Section>

  <Section wash class="wk-cta">
    <div class="wk-cta-row">
      <div>
        <h2 class="wk-cta-h">Want to see where your week goes?</h2>
        <p class="lead wk-cta-sub">{audit.sub}</p>
      </div>
      <a href={ctaHref} class="btn">{cta}</a>
    </div>
  </Section>

  <Footer />
</Base>

<style>
  .wk-hero h1 { max-width: 18ch; margin: 12px 0 16px; }
  .wk-intro { max-width: 56ch; }

  .wk-cards { list-style: none; display: grid; gap: 40px; }
  .wk-link {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center;
    color: inherit; text-decoration: none;
  }
  .wk-link:hover { text-decoration: none; }
  .wk-fig { border: 1px solid var(--color-ink); background: var(--color-white); overflow: hidden; }
  .wk-link:hover .wk-fig { border-color: var(--color-accent); }
  .wk-title { margin: 12px 0 14px; max-width: 18ch; font-size: var(--text-d3); }
  .wk-intro-sm {
    font-family: var(--font-serif); font-size: var(--text-body); line-height: var(--leading-body);
    color: var(--color-body); max-width: 48ch;
  }
  .wk-more { margin-top: 22px; }
  /* The ghost button's hover gesture is bound to :hover on the button; here
     the whole card is the link, so the gesture follows the card. */
  @media (hover:hover) and (prefers-reduced-motion: no-preference) {
    .wk-link:hover .wk-more .u { transform: scaleX(1); }
    .wk-link:hover .wk-more::after { transform: translateX(4px); color: var(--color-accent); }
  }
  .wk-link:hover .wk-more { color: var(--color-accent-dark); }

  .wk-cta-row { display: flex; align-items: center; justify-content: space-between; gap: 36px; }
  .wk-cta-h { max-width: 24ch; font-size: var(--text-d3); }
  .wk-cta-sub { margin-top: 10px; max-width: 46ch; }

  @media (max-width: 820px) {
    .wk-link { grid-template-columns: 1fr; gap: 22px; }
    .wk-cta-row { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 640px) {
    .wk-hero h1, .wk-intro, .wk-title, .wk-intro-sm, .wk-cta-h, .wk-cta-sub { max-width: none; }
  }
</style>
