---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ConnectsStrip from '../components/ConnectsStrip.astro';
import DashboardPlate from '../components/DashboardPlate.astro';
import Section from '../components/Section.astro';
import SignalList from '../components/SignalList.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { cta, ctaHref } from '../content/site';
---

<Base businessSchema>
  <Header />
  <Hero />
  {/* Full-bleed band rather than a section, so it sits outside .wrap and
      supplies its own rules top and bottom. On the ink ground since the
      Style C redesign, which makes it the page's first hard horizontal and
      separates the hero from the argument that follows. */}
  <ConnectsStrip />

  {/* ---------------------------------------------------------------
      §01 · The busywork

      Anchors changed with the redesign, 29 Aug 2026. The page used to run
      #services / #how / #ownership over four sections; it now runs
      #busywork / #build / #contact over three. #contact is unchanged and
      must stay so: the hero CTA, the footer and vercel.json's /systems-map
      301 all target it. The three retired fragments now land at the top of
      the page, which is the harmless failure mode for a fragment.

      No top rule: the connects strip above draws its own on both edges, and
      a third here would double them. --------------------------------- */}
  <Section id="busywork" noRule>
    {/* ⚠️ These three are siblings of the grid, not two nested blocks, and that
        is load-bearing. They used to be an intro and a closer wrapped in one
        left-hand column, which read correctly at desktop and stacked as
        heading → lead → closing statement → list on a phone: the sentence that
        closes the list landed above the list. A nested child cannot be
        reordered against its parent's sibling, so the wrapper had to go.

        Flat, the DOM order is already the phone order, and the desktop layout
        is explicit grid placement instead. */}
    <div class="bw-grid">
      <div class="bw-intro">
        <h2 class="bw-head">
          If it happens over and over, it should be <span class="hl">automated.</span>
        </h2>
        <p class="lead">Maybe your team is:</p>
      </div>

      <SignalList />

      {/* Sits at the foot of the left column at desktop, so it lands level
          with the end of the list rather than floating under the heading. */}
      <div class="bw-close">
        <p class="lead">These little inefficiencies add up.</p>
        <p class="claim">That’s the busywork I build out of your business.</p>
      </div>
    </div>

    {/* The ask sits after the list: by this point a visitor has read seven
        specific descriptions of their own week. */}
    <div class="btn-row bw-cta">
      <a href={ctaHref} class="btn">{cta}</a>
    </div>
  </Section>

  {/* ---------------------------------------------------------------
      §02 · What I build

      The one section on the quiet ground. Carries the five build types and
      then the annotated dashboard plate, which is the page's only picture of
      a finished thing. --------------------------------------------- */}
  <Section id="build" wash>
    <h2 class="bd-head">Your process. Just without all the work.</h2>
    <p class="lead bd-lead">
      I look at how the work actually gets done, find the repetitive steps,
      bottlenecks, and workarounds, then build a simpler system around them.
    </p>
    <p class="mono-note bd-note">That might be a:</p>

    <ServiceCards />
    <DashboardPlate />
  </Section>

  {/* §03 renders its own marker: it sits inside the left column of the
      contact grid rather than running the full width, so it cannot come from
      Section.astro. */}
  <ContactSection />
  <Footer />
  {/* Phone only, and the last thing in the document so it is last in the
      tab order too — it is a shortcut, not the primary path. */}
  <StickyCta />
</Base>

<style>
  /* ---------- §01 ----------
     35/65. The list is the substance here and the copy is the frame, which is
     the reverse of every other section on the page. */
  .bw-grid {
    display:grid; grid-template-columns:minmax(0,35fr) minmax(0,65fr);
    column-gap:64px; row-gap:48px;
  }
  /* Explicit placement, because the DOM order is the phone order and the
     desktop arrangement is the exception. The list spans both rows so row 2
     has height to give, and align-self drops the closing block to the foot of
     the column, level with the end of the list. */
  .bw-intro { grid-column:1; grid-row:1; }
  .bw-close { grid-column:1; grid-row:2; align-self:end; }
  /* ⚠️ Inside :global() in full. `.signals` is SignalList.astro's root
     element, so a scoped selector compiles to `.signals[data-astro-cid-THIS]`
     and silently matches nothing — landmine 18, which already cost §01's
     accent rule once under the ocean design. */
  :global(.bw-grid > .signals) { grid-column:2; grid-row:1 / span 2; }
  .bw-head { margin:0 0 18px; }
  .bw-close { border-top:1px solid var(--color-ink); padding-top:26px; }
  .bw-close .lead { margin-bottom:10px; }
  .bw-cta { margin-top:44px; }

  /* The highlight behind "automated." A background gradient rather than a
     border or a pseudo-element, so it wraps with the text if the line ever
     breaks mid-phrase. 62% is the baseline: below that the wash cuts the
     descenders, above it the phrase looks underlined rather than marked. */
  .hl {
    background:linear-gradient(transparent 62%, var(--color-accent-soft) 62%);
  }

  /* ---------- §02 ---------- */
  .bd-head { margin:0 0 18px; max-width:26ch; }
  .bd-lead { max-width:58ch; }
  .bd-note { margin-top:18px; }

  /* ---------- responsive ----------
     820px is where the hero grid stacks and both drawings swap to their narrow
     compositions, so §01 stacks at the same width and the whole page changes
     shape once rather than three times. */
  @media (max-width:820px) {
    /* One column, and the placements reset to auto so the DOM order takes
       over: heading, lead, list, then the closing statement. That order is
       the whole reason the three blocks are flat siblings — see the note in
       the markup. */
    .bw-grid { grid-template-columns:1fr; row-gap:34px; }
    .bw-intro, .bw-close { grid-column:auto; grid-row:auto; }
    :global(.bw-grid > .signals) { grid-column:auto; grid-row:auto; }
  }

  /* ⚠️ §01's ask is hidden on phones for the same reason the hero's is:
     StickyCta carries the same label, pinned, from the moment the page loads,
     so this one sits a few hundred pixels above a permanent copy of itself.

     Both this and Hero's rule are coupled to StickyCta existing and pointing
     at the same place. If the sticky bar goes or changes, both come back in
     the same commit — otherwise the page has no in-flow CTA at all between
     the headline and the form. */
  @media (max-width:640px) {
    .bw-cta { display:none; }
  }
</style>
