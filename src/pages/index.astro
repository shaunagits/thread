---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServiceList from '../components/ServiceList.astro';
import Section from '../components/Section.astro';
import StepRow from '../components/StepRow.astro';
import Fig4CarePlate from '../components/Fig4CarePlate.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Base businessSchema>
  <Header />
  <Hero />

  <Section
    eyebrow="§ 01 · The problem"
    heading="Good tools can still create busywork."
    headingWidth={23}
  >
    <p class="lead" style="max-width:52ch;margin-bottom:18px">
      When information doesn’t move cleanly, your team carries it by hand.
    </p>
    <p class="problem-actions">Re-enter. Check. Remember.</p>
  </Section>

  <Section
    id="services"
    eyebrow="§ 02 · What I do"
    heading="Make the work easier to run."
    headingWidth={23}
  >
    <p class="lead" style="max-width:50ch">
      Thread fixes the gaps that slow your team down, then builds the tools your business has outgrown.
    </p>
    <ServiceList />
  </Section>

  <Section
    id="how"
    eyebrow="§ 03 · The process"
    heading="Start small. Build with confidence."
    headingWidth={22}
  >
    <p class="lead" style="max-width:52ch">
      You do not need to know the answer before the first call.
    </p>
    <StepRow />
  </Section>

  <Section
    id="ownership"
    eyebrow="§ 04 · Ownership"
    heading="The system is yours."
    headingWidth={20}
  >
    <div class="ownership-layout">
      <div>
        <p class="lead" style="max-width:42ch;margin-bottom:18px">
          It runs in your accounts and works for your team.
        </p>
        <p class="txt" style="max-width:48ch">
          Your data. Your code. Clear handover.
        </p>
      </div>
      <Fig4CarePlate />
    </div>
  </Section>

  <ContactSection />
  <Footer />
</Base>

<style>
  .problem-actions {
    margin-top:42px; font-family:var(--font-serif); font-size:clamp(28px, 3.2vw, 42px);
    line-height:1.15; letter-spacing:-.025em; color:var(--color-ink);
  }
  :global(#services) {
    background-color:var(--color-wash);
    background-image:linear-gradient(to right, color-mix(in srgb, var(--color-rule) 42%, transparent) 1px, transparent 1px);
    background-size:88px 100%;
  }
  :global(#services) .wrap { position:relative; }
  :global(#services) .wrap::after { content:''; position:absolute; right:0; top:0; width:74px; border-top:2px solid var(--color-line); }
  :global(#ownership) { background:var(--color-paper); padding-block:88px; }
  .ownership-layout { display:grid; grid-template-columns:minmax(0,.82fr) minmax(400px,1.18fr); align-items:center; gap:clamp(36px,7vw,100px); max-width:1100px; }
  .ownership-layout :global(svg.plate) { max-width:560px; justify-self:end; }
  @media (max-width:720px) { .ownership-layout { grid-template-columns:1fr; gap:30px; } .ownership-layout :global(svg.plate) { justify-self:start; } }
</style>
