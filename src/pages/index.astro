---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import HeroV2 from '../components/v2/HeroV2.astro';
import StepsV2 from '../components/v2/StepsV2.astro';
import OffersV2 from '../components/v2/OffersV2.astro';
import ProofV2 from '../components/v2/ProofV2.astro';
import FaqV2 from '../components/v2/FaqV2.astro';
import ContactV2 from '../components/v2/ContactV2.astro';
import {
  title, description, problem, about,
} from '../content/site-v2';

/**
 * THE HOMEPAGE. Built 1 Sep 2026 from _docs/homepage-wireframe.html, shipped
 * at /v2 the same day, and promoted to `/` on the owner's instruction.
 *
 * The page it replaced is at /v1, noindex, kept for reference. See v1.astro.
 *
 * It reuses the shell rather than reimplementing it — Base, Header, Footer,
 * Section and IntakeForm are shared with every other page, so the type scale,
 * the palette, the section rhythm and the working contact endpoint cannot
 * drift from the rest of the site.
 *
 * ⚠️ Its nav, CTA and footer columns are in `site.ts`, NOT in site-v2.ts.
 * They moved there with the promotion, because `Header`, `Footer` and /work
 * render them with no props on every page: the moment this became `/` they
 * stopped being one page's content and became the site's. Everything else this
 * page says is in site-v2.ts.
 *
 * ⚠️ `#contact` is unchanged from the previous homepage and must stay so. The
 * hero CTA, the footer, /work and vercel.json's /systems-map 301 all target it.
 * The retired anchors `#busywork` and `#build` now land at the top of this
 * page, which is the harmless failure mode for a fragment.
 *
 * Nine sections, in the wireframe's own build order:
 *   hero · problem · how it works · offers · proof · about · checklist · FAQ · contact
 */
---

<Base title={title} description={description} businessSchema>
  {/* No props: the header and the footer read site.ts, which now carries this
      page's nav and CTA. /v1 is the page that passes props now. */}
  <Header />

  <HeroV2 />

  {/* ---------------------------------------------------------------
      The problem. Cut from the live homepage on 29 Aug 2026 because §01's
      signal list was already naming the same symptoms one scroll down. This
      page has no signal list, so the section earns its place again. ------ */}
  <Section id="problem">
    <div class="pb">
      <h2>{problem.heading}</h2>
      {problem.body.map((para) => <p class="lead">{para}</p>)}
      <p class="claim pb-claim">{problem.claim}</p>
    </div>
  </Section>

  {/* How it works. The live site deleted its three-step arc with ProcessIndex
      on 29 Aug; this is the wireframe's version, not that component restored. */}
  <Section id="how">
    <h2 class="s-head">You bring the problem. I’ll figure out the software.</h2>
    <StepsV2 />
  </Section>

  {/* Offers. ⚠️ Carries prices — see the header of site-v2.ts. */}
  <Section id="offers" wash>
    <h2 class="s-head">Three ways to work together.</h2>
    <OffersV2 />
  </Section>

  {/* Proof. ⚠️ Three visible gaps since 4 Sep 2026 — no results on this page.
      See ProofV2.astro. The heading below is left as written: it describes
      what the section will hold, and the owner asked to keep the layout and
      hierarchy intact while the content is gathered. */}
  <Section id="proof">
    <h2 class="s-head">What this looks like in real businesses.</h2>
    <ProofV2 />
  </Section>

  <Section id="about">
    <div class="ab">
      {/* The real photo, already in public/ and used by the live contact card.
          The wireframe asks for something different — "at a desk or on site,
          not a grey-backdrop headshot" — so this is a real asset standing in
          for a better one, not a placeholder. Swap the file, keep the markup. */}
      <img
        class="ab-photo"
        src="/shauna.jpg"
        alt=""
        aria-hidden="true"
        width="220"
        height="220"
        loading="lazy"
        decoding="async"
      />
      <div class="ab-copy">
        <h2>{about.heading}</h2>
        {about.body.map((para) => <p class="lead">{para}</p>)}
        <p class="claim claim-sm ab-claim">{about.claim}</p>
      </div>
    </div>
  </Section>

  {/* ⚠️ The lead-magnet section was DELETED here on 1 Sep 2026 with the audit
      rebuild. It offered a "20 Tasks Your Business Is Still Doing by Hand"
      checklist that never existed, behind a button that was never wired up,
      and the audit is the same idea done properly: it asks for the same
      information and gives back something written for that business.

      LeadMagnetV2.astro and the `leadMagnet` export went in the same commit.
      Recover both from git rather than rewriting them if the checklist ever
      becomes real. Its three-step strip lives on inside the audit section. */}

  <Section id="faq">
    <h2 class="s-head">Common questions.</h2>
    <FaqV2 />
  </Section>

  {/* ⚠️ KEEP `id="contact"`. It is the only anchor on this site with an
      indexed inbound link — the hero CTA, the footer, /work and vercel.json's
      /systems-map 301 all target it. The section is the audit now; the anchor
      is a contract and does not follow the copy. See ContactV2.astro.

      No heading here: the audit section pairs its heading with the promise in
      a two-column block, so it owns both. */}
  <Section id="contact">
    <ContactV2 />
  </Section>

  <Footer />
</Base>

<style>
  /* One heading treatment for six sections. The live homepage gives each of
     its three a bespoke grid; nine sections cannot each be an exception. */
  .s-head { margin: 0 0 4px; max-width: 24ch; }

  /* ---------- the problem ---------- */
  .pb { max-width: 62ch; }
  .pb h2 { margin: 0 0 18px; max-width: 22ch; }
  .pb .lead { margin-bottom: 12px; }
  .pb-claim { margin-top: 22px; }

  /* ---------- about ---------- */
  .ab {
    display: grid; grid-template-columns: 220px minmax(0, 1fr);
    gap: 56px; align-items: start;
  }
  .ab-photo {
    width: 220px; height: 220px; display: block;
    object-fit: cover; border: 1px solid var(--color-ink);
    background: var(--color-wash);
  }
  .ab-copy h2 { margin: 0 0 18px; max-width: 20ch; }
  .ab-copy .lead { margin-bottom: 12px; max-width: 60ch; }
  .ab-claim { margin-top: 20px; max-width: 52ch; }
  @media (max-width: 820px) {
    .ab { grid-template-columns: 1fr; gap: 30px; }
    .ab-photo { width: 160px; height: 160px; }
  }
  @media (max-width: 640px) {
    .s-head, .pb h2, .ab-copy h2 { max-width: none; }
    .ab-copy .lead, .ab-claim { max-width: none; }
  }
</style>
