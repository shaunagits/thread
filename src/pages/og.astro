---
/**
 * Social card generator — renders the 1200×630 image at /og.
 *
 * Not content. Excluded from the sitemap, disallowed in robots.txt, and
 * noindex'd. Rasterise it with:
 *
 *   npm run og:build      (dev server must be running)
 *
 * It is a real page rather than a hand-drawn SVG so the card uses the actual
 * self-hosted Newsreader and JetBrains Mono, including the ʻokina.
 */
import '../styles/global.css';
import { hero } from '../content/site-v2';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Thread · social card</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="card">
      <div class="top">
        <span class="mark">thread<span class="dot">.</span></span>
      </div>

      <div class="middle">
        <div class="eyebrow">Custom software and automation · Honolulu, Hawaiʻi</div>
        {/* ⚠️ Mirrors the hero headline, and no longer by hand. It is read
            from site-v2.ts, which is where the homepage's hero copy lives
            since the swap on 1 Sep 2026. That closes the gap this comment used
            to describe: the card is the link preview everywhere the site gets
            shared, so a stale line here outlives the page edit in every
            already-scraped cache, and the old arrangement relied on somebody
            remembering. The previous homepage kept its copy in Hero.astro's
            markup, which is why it could not be imported.

            ⚠️ scripts/build-og.py still carries the string separately — it is
            a Python renderer and cannot import a .ts module. Change its
            HEADLINE constant in the same commit, and re-run `npm run og:build`
            or /og.png stays on the old headline. */}
        <h1>{hero.h1}</h1>
      </div>

      <div class="bottom">
        {/* The four old service names went with the v3 copy. These are the
            three engagements it actually sells. */}
        <span class="meta">Automation · Custom apps · Ongoing support</span>
        <svg class="motif" viewBox="0 0 120 24" fill="none" aria-hidden="true">
          <path d="M2 6 C40 6, 44 12, 74 12" stroke="var(--color-accent-dark)" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M2 12 H74" stroke="var(--color-accent-dark)" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M2 18 C40 18, 44 12, 74 12" stroke="var(--color-accent-dark)" stroke-width="1.6" stroke-linecap="round"/>
          <circle cx="78" cy="12" r="5" fill="var(--color-accent)"/>
          <path d="M86 12 H118" stroke="var(--color-accent-dark)" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </body>
</html>

<style>
  body { margin: 0; background: var(--color-paper); }
  .card {
    width: 1200px; height: 630px;
    background: var(--color-paper);
    border-bottom: 10px solid var(--color-accent);
    padding: 62px 72px 56px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .mark {
    font-family: var(--font-wordmark); font-weight: 600; font-size: 40px;
    letter-spacing: -.025em; color: var(--color-ink);
  }
  .mark .dot { color: var(--color-accent); }

  .middle { padding-bottom: 8px; }
  .eyebrow { font-size: 15px; letter-spacing: .16em; margin-bottom: 26px; }
  /* 56px, down from 74, and 21ch rather than 17. The headline went from 31
     characters to 63 with the homepage swap on 1 Sep 2026; at the old size it
     set as four lines and overran the 630px card. Measured in a browser at
     these values rather than guessed. */
  .middle h1 {
    font-family: var(--font-display); font-weight: 500; font-size: 56px;
    line-height: 1.12; letter-spacing: -.015em;
    color: var(--color-ink); max-width: 21ch;
  }

  .bottom {
    display: flex; align-items: center; justify-content: space-between;
    gap: 40px; padding-top: 28px; border-top: 1px solid var(--color-rule);
  }
  .meta {
    font-family: var(--font-mono); font-size: 14px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-faint);
  }
  .motif { width: 120px; height: 24px; flex: none; }
</style>
