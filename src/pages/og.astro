---
/**
 * Social card generator — renders the 1200×630 image at /og.
 *
 * Not content. Excluded from the sitemap, disallowed in robots.txt, and
 * noindex'd. Rasterise it with:
 *
 *   npm run og:build      (dev server must be running)
 *
 * It is a real page rather than a hand-drawn SVG so the card uses the actual
 * self-hosted Newsreader and JetBrains Mono, including the ʻokina.
 */
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Thread · social card</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <div class="card">
      <div class="top">
        <span class="mark">thread<span class="dot">.</span></span>
      </div>

      <div class="middle">
        <div class="eyebrow">Custom software and automation · Honolulu, Hawaiʻi</div>
        {/* Mirrors the hero headline. This card is the link preview everywhere
            the site gets shared, so a stale line here outlives the page edit in
            every already-scraped cache. Kept in sync by hand, deliberately: the
            hero's copy lives in Hero.astro's markup, not in a shared constant,
            and hoisting it would be a bigger change than this file deserves. */}
        <h1>Software that brings your business together.</h1>
      </div>

      <div class="bottom">
        {/* The four old service names went with the v3 copy. These are the
            three engagements it actually sells. */}
        <span class="meta">Connect · Build · Ongoing</span>
        <svg class="motif" viewBox="0 0 120 24" fill="none" aria-hidden="true">
          <path d="M2 6 C40 6, 44 12, 74 12" stroke="#AE7126" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M2 12 H74" stroke="#AE7126" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M2 18 C40 18, 44 12, 74 12" stroke="#AE7126" stroke-width="1.6" stroke-linecap="round"/>
          <circle cx="78" cy="12" r="5" fill="#C8873F"/>
          <path d="M86 12 H118" stroke="#AE7126" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </body>
</html>

<style>
  body { margin: 0; background: var(--color-paper); }
  .card {
    width: 1200px; height: 630px;
    background: var(--color-paper);
    border-bottom: 10px solid var(--color-ochre);
    padding: 62px 72px 56px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .mark {
    font-family: var(--font-serif); font-weight: 600; font-size: 40px;
    letter-spacing: -.025em; color: var(--color-ink);
  }
  .mark .dot { color: var(--color-ochre); }

  .middle { padding-bottom: 8px; }
  .eyebrow { font-size: 15px; letter-spacing: .16em; margin-bottom: 26px; }
  .middle h1 {
    font-family: var(--font-serif); font-weight: 500; font-size: 74px;
    line-height: 1.1; letter-spacing: -.015em;
    color: var(--color-ink); max-width: 17ch;
  }

  .bottom {
    display: flex; align-items: center; justify-content: space-between;
    gap: 40px; padding-top: 28px; border-top: 1px solid var(--color-rule);
  }
  .meta {
    font-family: var(--font-mono); font-size: 14px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-faint);
  }
  .motif { width: 120px; height: 24px; flex: none; }
</style>
