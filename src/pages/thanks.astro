---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contact } from '../content/site';

// Server-rendered so it can show the outcome. The homepage stays fully
// prerendered — only this page and /api/contact run on request.
export const prerender = false;

// The `form` parameter and its `map` branch went with the systems map offer,
// killed by the owner 14 Aug 2026. One form now, one message.
const status = Astro.url.searchParams.get('status');

const STATES = {
  ok: {
    eyebrow: '§ · Received',
    heading: 'Your request is in.',
    body: 'I’ll read what you sent and reply within one business day, usually the same day. If it isn’t a fit, you’ll hear that plainly rather than not hearing back.',
    back: 'Back to the homepage',
  },
  invalid: {
    eyebrow: '§ · Incomplete',
    heading: 'A couple of things are missing.',
    body: 'A name and a working email address are the two the form can’t do without. Nothing else was lost. Go back and the rest of it is still there.',
    back: 'Back to the form',
  },
  error: {
    eyebrow: '§ · Not sent',
    heading: 'That didn’t go through.',
    body: `Something broke on this end, not yours. Email ${contact.email} directly and it reaches the same place.`,
    back: 'Back to the homepage',
  },
} as const;

const state =
  status === 'invalid' ? STATES.invalid : status === 'error' ? STATES.error : STATES.ok;

const backHref = state === STATES.invalid ? '/#contact' : '/#top';
---

<Base
  title={`${state.heading} · Thread`}
  description="Thread · custom software for Hawaiʻi businesses. Apps, dashboards, automation and practical AI, Honolulu."
>
  <Header />

  <section class="result">
    <div class="wrap">
      <div class="eyebrow">{state.eyebrow}</div>
      <h1>{state.heading}</h1>
      <p class="lead">{state.body}</p>
      <div class="btn-row">
        <a href={backHref} class="btn">{state.back}</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .result { border-top: 0; padding: 120px 0 140px; }
  .result h1 {
    font-size: clamp(34px, 4.4vw, 52px);
    margin: 20px 0 22px;
    max-width: 16ch;
  }
  .result p.lead { max-width: 52ch; }

  @media (max-width: 640px) {
    .result { padding: 76px 0 88px; }
  }
</style>
