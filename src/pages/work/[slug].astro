---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/Section.astro';
import Placeholder from '../../components/v2/Placeholder.astro';
import EfHero from '../../components/work/EfHero.astro';
import EfBefore from '../../components/work/EfBefore.astro';
import EfAfter from '../../components/work/EfAfter.astro';
import EfPhone from '../../components/work/EfPhone.astro';
import { caseStudies, type WorkGraphic } from '../../content/work';
import { audit } from '../../content/site-v2';
import { cta, ctaHref } from '../../content/site';

/**
 * THE CASE STUDY TEMPLATE. Built 12 Sep 2026 from structure 1a ("Scroll
 * walkthrough") of the owner's design file, _docs/designs_091226/
 * Custom App Graphic.dc.html (misnamed; it is the case study page in three
 * structures). 1d in the same file is this layout stacked at 390px, and the
 * phone rules below follow it.
 *
 * One page per entry in src/content/work.ts. The content file owns every
 * word; this file owns the order and the geometry:
 *
 *   hero (eyebrow · h1 · intro · facts) · hero drawing · [results] ·
 *   before/after · walkthrough (four steps, figures alternate) · clip ·
 *   details · what I built + built on · audit CTA [+ more work]
 *
 * Bracketed blocks are omitted while their data is empty rather than drawn
 * as gaps: a results band of three "Finish later" cards is a row of invented
 * numbers waiting to happen. Every other missing asset IS drawn as a gap,
 * with the site's Placeholder component, so the page and the source agree
 * about what is unfinished. `grep -rn Placeholder src/pages/work` lists them.
 *
 * Drawings are chosen by key so the content file never imports a component.
 * A new case study with its own screens adds a key to WorkGraphic and a case
 * to `Graphic` below.
 *
 * Read the header of work.ts before touching the first entry.
 */
export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}
const { study } = Astro.props;
const more = caseStudies.filter((c) => c.slug !== study.slug);
---

<Base title={study.seoTitle} description={study.description}>
  <Header />

  {/* ---------- hero ---------- */}
  <section class="hero cs-hero">
    <div class="wrap">
      <p class="eyebrow">{study.eyebrow}</p>
      <h1>{study.title}</h1>
      <p class="lead cs-intro">{study.intro}</p>
      <ul class="cs-facts" aria-label="At a glance">
        {study.facts.map((f) => <li>{f}</li>)}
      </ul>
      <div class="cs-hero-fig">
        {study.hero === 'ef-hero' && <EfHero />}
      </div>
    </div>
  </section>

  {/* ---------- results, only when there are real ones ---------- */}
  {study.results.length > 0 && (
    <Section wash class="cs-results">
      <p class="eyebrow eyebrow-quiet">Results</p>
      <ol class="cs-results-row">
        {study.results.map((r) => (
          <li><span class="cs-result-v">{r.value}</span><span class="cs-result-l">{r.label}</span></li>
        ))}
      </ol>
    </Section>
  )}

  {/* ---------- before, and after ---------- */}
  <Section class="cs-ba">
    <h2>Before, and after.</h2>
    <p class="lead cs-lead">{study.beforeAfter.lead}</p>
    <div class="cs-ba-grid">
      <figure class="cs-ba-item">
        <p class="eyebrow eyebrow-quiet">Before</p>
        <div class="cs-frame">
          {study.beforeAfter.before.graphic === 'ef-before' && <EfBefore />}
        </div>
        <figcaption>{study.beforeAfter.before.caption}</figcaption>
      </figure>
      <figure class="cs-ba-item">
        <p class="eyebrow">After</p>
        <div class="cs-frame cs-frame-after">
          {study.beforeAfter.after.graphic === 'ef-after' && <EfAfter />}
        </div>
        <figcaption>{study.beforeAfter.after.caption}</figcaption>
      </figure>
    </div>
  </Section>

  {/* ---------- the walkthrough ---------- */}
  <Section class="cs-walk">
    <p class="eyebrow eyebrow-quiet">The walkthrough</p>
    <h2 class="cs-walk-h">{study.walkthrough.heading}</h2>
    <p class="lead cs-lead">{study.walkthrough.lead}</p>
    <ol class="cs-steps">
      {study.walkthrough.steps.map((step, i) => (
        <li class={i % 2 === 1 ? 'cs-step cs-step-flip' : 'cs-step'}>
          <div class="cs-step-fig">
            {step.graphic === 'ef-phone' && <div class="cs-phone-stage"><EfPhone /></div>}
            {step.graphic === 'ef-before' && <div class="cs-frame"><EfBefore /></div>}
            {step.graphic === 'ef-after' && <div class="cs-frame"><EfAfter /></div>}
            {step.graphic === 'placeholder' && <Placeholder label={step.shot ?? 'Screenshot'} minHeight="230px" />}
          </div>
          <div class="cs-step-copy">
            <p class="eyebrow">Step {step.n}</p>
            <h3>{step.title}</h3>
            <p class="cs-step-body">{step.body}</p>
            {step.why && <p class="cs-step-why">{step.why}</p>}
          </div>
        </li>
      ))}
    </ol>
  </Section>

  {/* ---------- the clip ---------- */}
  <Section class="cs-clip">
    <h2>{study.clip.heading}</h2>
    {/* A <video muted loop playsinline autoplay> goes here when there is a
        file. Autoplay of a muted, inline video is not script and not
        interaction, so it stays inside the site's rules. */}
    <Placeholder label={study.clip.shot} minHeight="250px" class="cs-clip-ph" />
    <p class="cs-note">{study.clip.note}</p>
  </Section>

  {/* ---------- details ---------- */}
  <Section class="cs-details">
    <p class="eyebrow eyebrow-quiet">Details</p>
    <h2 class="cs-details-h">{study.details.heading}</h2>
    <ul class="cs-details-grid">
      {study.details.items.map((d) => (
        <li>
          <Placeholder label={d.shot} minHeight="120px" />
          <p class="cs-detail-body">{d.body}</p>
        </li>
      ))}
    </ul>
  </Section>

  {/* ---------- what I built · built on ---------- */}
  <Section class="cs-scope">
    <div class="cs-scope-grid">
      <div>
        <h3>What I built</h3>
        <ul class="cs-scope-list">
          {study.scope.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <h3>Built on</h3>
        {study.builtOn.length > 0 ? (
          <ul class="cs-chips">{study.builtOn.map((b) => <li>{b}</li>)}</ul>
        ) : (
          <Placeholder label="Stack · one chip per system" minHeight="72px" class="cs-chips-ph" />
        )}
        <p class="cs-note">{study.builtOnNote}</p>
      </div>
    </div>
  </Section>

  {/* ---------- the audit, and more work ---------- */}
  <Section wash class="cs-cta">
    <div class={more.length > 0 ? 'cs-cta-grid' : 'cs-cta-grid cs-cta-solo'}>
      <div>
        <p class="eyebrow">{audit.eyebrow}</p>
        <h2 class="cs-cta-h">Want to see where your week goes?</h2>
        <p class="lead cs-cta-sub">{audit.sub}</p>
        <div class="btn-row"><a href={ctaHref} class="btn">{cta}</a></div>
      </div>
      {more.length > 0 && (
        <div>
          <p class="eyebrow eyebrow-quiet">More work</p>
          <ul class="cs-more">
            {more.map((m) => (
              <li><a href={`/work/${m.slug}`}><span class="cs-more-name">{m.name}</span><span class="cs-more-title">{m.title}</span></a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </Section>

  <Footer />
</Base>

<style>
  /* Two eyebrow registers, from the design: accent for the page's own
     markers, quiet for section labels. */
  .eyebrow-quiet { color: var(--color-faint); }

  /* ---------- hero ---------- */
  .cs-hero h1 { max-width: 20ch; margin: 12px 0 16px; }
  .cs-intro { max-width: 56ch; }
  .cs-facts {
    list-style: none; display: flex; flex-wrap: wrap; gap: 12px 28px;
    margin: 24px 0 28px; padding: 14px 0;
    border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule);
  }
  .cs-facts li {
    font-family: var(--font-mono); font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--color-faint);
  }
  /* The drawing is framed like every other bounded object on the site: an
     ink hairline, square corners. Its own inside carries the app's radii. */
  .cs-hero-fig { border: 1px solid var(--color-ink); background: var(--color-white); overflow: hidden; }

  /* ---------- results ---------- */
  .cs-results-row {
    list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 14px;
  }
  .cs-results-row li { display: flex; flex-direction: column; gap: 4px; padding-top: 14px; border-top: 1px solid var(--color-ink); }
  .cs-result-v { font-family: var(--font-display); font-weight: 650; font-size: var(--text-d2); letter-spacing: var(--tracking-tight); line-height: 1; color: var(--color-ink); }
  .cs-result-l { font-family: var(--font-serif); font-size: var(--text-small); color: var(--color-quiet); }

  /* ---------- shared ---------- */
  .cs-lead { max-width: 60ch; margin-top: 8px; }
  .cs-frame {
    display: flex; justify-content: center; align-items: flex-start;
    border: 1px solid var(--color-hair); background: var(--color-white); overflow: hidden;
  }
  .cs-frame-after { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 5%, var(--color-white)); }
  .cs-note {
    font-family: var(--font-serif); font-size: var(--text-small); line-height: var(--leading-body);
    color: var(--color-quiet); margin-top: 12px; max-width: 60ch;
  }

  /* ---------- before, and after ---------- */
  .cs-ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 24px; }
  .cs-ba-item { margin: 0; }
  .cs-ba-item .eyebrow { margin-bottom: 8px; }
  .cs-ba-item figcaption {
    font-family: var(--font-serif); font-size: var(--text-small); line-height: var(--leading-body);
    color: var(--color-body); margin-top: 10px;
  }

  /* ---------- walkthrough ---------- */
  .cs-walk-h { max-width: 24ch; margin: 12px 0 6px; }
  .cs-steps { list-style: none; margin: 30px 0 0; }
  .cs-step {
    display: grid; grid-template-columns: 1.45fr 1fr; gap: 30px; align-items: center;
    padding-top: 26px; border-top: 1px solid var(--color-rule);
  }
  .cs-step + .cs-step { margin-top: 26px; }
  /* Figures alternate side, per 1a. `direction` would reorder the DOM for
     screen readers too; explicit column placement does not. */
  .cs-step-flip { grid-template-columns: 1fr 1.45fr; }
  .cs-step-flip .cs-step-fig { grid-column: 2; grid-row: 1; }
  .cs-step-flip .cs-step-copy { grid-column: 1; grid-row: 1; }
  .cs-step-copy h3 { margin: 8px 0 10px; }
  .cs-step-body { font-family: var(--font-serif); font-size: var(--text-body); line-height: var(--leading-body); color: var(--color-body); }
  .cs-step-why { font-family: var(--font-serif); font-size: var(--text-small); line-height: var(--leading-body); color: var(--color-quiet); margin-top: 12px; }
  /* The phone is a fixed 308x612 object; give it a ground so the step reads
     as a figure rather than a floating device. */
  .cs-phone-stage {
    display: flex; justify-content: center; padding: 28px 0;
    border: 1px solid var(--color-hair); background: var(--color-white);
  }

  /* ---------- clip ---------- */
  .cs-clip-ph { margin-top: 18px; }

  /* ---------- details ---------- */
  .cs-details-h { margin: 10px 0 4px; }
  .cs-details-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 20px; }
  .cs-detail-body { font-family: var(--font-serif); font-size: var(--text-small); line-height: var(--leading-body); color: var(--color-body); margin-top: 9px; }

  /* ---------- scope ---------- */
  .cs-scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
  .cs-scope-list { list-style: none; margin-top: 14px; border-top: 1px solid var(--color-rule); }
  .cs-scope-list li {
    padding: 11px 0; border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono); font-size: var(--text-nav); letter-spacing: var(--tracking-mono); color: var(--color-body);
  }
  .cs-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .cs-chips li {
    font-family: var(--font-mono); font-size: var(--text-nav); letter-spacing: var(--tracking-mono); color: var(--color-body);
    border: 1px solid var(--color-rule); background: var(--color-white); padding: 6px 9px;
  }
  .cs-chips-ph { margin-top: 16px; }

  /* ---------- CTA ---------- */
  .cs-cta-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: start; }
  .cs-cta-solo { grid-template-columns: minmax(0, 1fr); }
  .cs-cta-h { max-width: 20ch; margin: 12px 0 10px; }
  .cs-cta-sub { max-width: 48ch; }
  .cs-more { list-style: none; display: grid; gap: 12px; margin-top: 12px; }
  .cs-more a {
    display: flex; flex-direction: column; gap: 4px; padding: 14px 16px;
    border: 1px solid var(--color-ink); background: var(--color-white); color: var(--color-ink); text-decoration: none;
  }
  .cs-more a:hover { border-color: var(--color-accent); }
  .cs-more-name { font-family: var(--font-mono); font-size: var(--text-micro); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--color-accent); }
  .cs-more-title { font-family: var(--font-display); font-weight: 600; font-size: var(--text-d4); letter-spacing: -.01em; line-height: 1.2; }

  /* ---------- responsive ---------- */
  @media (max-width: 1000px) {
    .cs-details-grid { grid-template-columns: 1fr; }
    .cs-results-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 820px) {
    .cs-ba-grid { grid-template-columns: 1fr; }
    .cs-step, .cs-step-flip { grid-template-columns: 1fr; gap: 16px; }
    .cs-step-flip .cs-step-fig, .cs-step-flip .cs-step-copy { grid-column: 1; grid-row: auto; }
    .cs-step-flip .cs-step-fig { order: 0; }
    .cs-step-flip .cs-step-copy { order: 1; }
    .cs-scope-grid, .cs-cta-grid { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .cs-hero h1, .cs-intro, .cs-walk-h, .cs-cta-h, .cs-cta-sub { max-width: none; }
    .cs-facts { gap: 10px 14px; margin: 16px 0 20px; padding: 12px 0; }
    .cs-phone-stage { padding: 20px 0; }
  }
</style>
