---
import '../styles/global.css';

import { contact, services } from '../content/site';
import DevGrid from '../components/DevGrid.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Emit the business entity as structured data. Homepage only — repeating the
   * same entity on every page adds nothing and muddies which URL it belongs to.
   */
  businessSchema?: boolean;
  /** Keep the page out of the index. For pages that exist but are not ready. */
  noindex?: boolean;
}

const {
  title = 'Thread · Custom software and automation, Honolulu, Hawaiʻi',
  /**
   * 144 characters. The previous default ran 190 and Google truncates around
   * 155, which cut it mid-claim. Chosen by the owner 19 Aug 2026 from three
   * drafts; every claim in it already appears on the page. Keep any future
   * rewrite under ~155 characters, and check the length before shipping it.
   */
  description = 'Custom software, dashboards and automation for Hawaiʻi businesses, built in Honolulu around how you already work. You own the code when it ships.',
  businessSchema = false,
  noindex = false,
} = Astro.props;

// Absolute URLs, derived from `site` in astro.config.mjs. Social scrapers
// reject relative image paths, so these must resolve against the real domain.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

/**
 * The entity, stated once in machine-readable form. The brand guide's §10 asks
 * for a consistent description of what Thread is across the web so search and
 * assistants resolve it to one thing; this is that description at the source.
 *
 * Deliberately absent: street address, telephone, opening hours, price range,
 * and aggregate rating. Every one of those would be invented today. Add them
 * here as they become real. `sameAs` landed 19 Aug 2026, once the profiles
 * existed.
 */
const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#thread', Astro.site).href,
  name: 'Thread',
  /**
   * What people actually type. The site is "Thread"; the search is "Thread
   * Hawaii", and that phrase is contested locally by three long-established
   * embroidery and threading businesses. alternateName is how the entity is
   * told which strings refer to it.
   */
  alternateName: ['Thread Hawaii', 'Thread Hawaiʻi'],
  description:
    'Custom software for Hawaiʻi businesses. Thread connects the tools a business already runs, or builds the one nobody sells, and hands over the source code, the data and the accounts it runs in.',
  url: new URL('/', Astro.site).href,
  /**
   * Added 19 Aug 2026, URLs supplied by the owner. This is what lets search
   * resolve the site, the Google Business Profile and the LinkedIn page to
   * one entity — which matters here more than usual, because "Thread Hawaii"
   * is contested by several established embroidery businesses.
   *
   * The Google link is the listing's canonical ?cid= form, derived from the
   * full Maps URL the owner supplied on 19 Aug 2026: the value is the decimal
   * of the second hex in its `!1s0x…:0x…` pair (0xbf357e16c96894b5). It
   * replaced a share.google short link the same day — same listing, stable
   * URL instead of a redirect.
   */
  sameAs: [
    'https://maps.google.com/?cid=13778057271343355061',
    'https://www.linkedin.com/company/threadhawaii/',
  ],
  email: contact.email,
  founder: { '@type': 'Person', name: 'Shauna' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Honolulu',
    addressRegion: 'HI',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Hawaiʻi' },
    { '@type': 'Country', name: 'United States' },
  ],
  knowsAbout: [
    'Custom software development',
    'Business process automation',
    'Systems integration',
    'Operations dashboards',
    'Applied AI for small business',
  ],
  /**
   * Generated from the `services` array in site.ts since 19 Aug 2026, so the
   * schema always states the same four services the page shows and cannot
   * drift when they change. It previously carried the v3 copy's three
   * engagements (Connect / Build / Ongoing), which no longer appeared
   * anywhere on the page. The free systems map came out 14 Aug 2026 when the
   * owner killed the offer — this block is indexed, so it outlives page edits
   * and has to change in the same commit as the page.
   *
   * No `priceSpecification` on any of these. The prices are still
   * `[CONFIRM]` and a structured-data price is the most quotable kind of
   * invented number there is.
   */
  makesOffer: services.map((service) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: service.title,
      description: service.body,
    },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    {/* The site's only executable JavaScript, added 18 Aug 2026 on the owner's
        call. It exists because nothing in CSS can reach scroll restoration.

        The browser restores your scroll position on reload, so reloading
        part-way down the homepage put you back part-way down. The owner wanted
        every load to start at the top, and `history.scrollRestoration` is the
        only switch for that.

        ⚠️ It must be set unconditionally, on every load. The value lives on the
        history entry and is read when the browser decides whether to restore,
        so setting it during a load is too late for that same load — it only
        takes effect from the next one. Scoping it to `navigation.type ===
        'reload'` was tried and measured: the first reload still restored and
        only later ones landed at the top. Half-fixed is worse than either
        choice, so the condition is gone.

        The cost, accepted knowingly: back and forward no longer restore either.
        Returning from /privacy, /terms or /work lands at the top of the
        homepage rather than where you left. That is the price of the switch;
        there is no finer-grained control without storing scroll positions by
        hand, which is far more JavaScript than this site should carry.

        Inline and synchronous on purpose: it has to run before the browser
        restores, which a deferred or external script would miss. */}
    <script is:inline>
      if (history.scrollRestoration) history.scrollRestoration = 'manual';
    </script>

    <!-- icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Matches --color-paper in global.css. Was #FCFBF7, the earth palette's
        paper, missed in the 17 Aug ocean swap because it is a literal here
        rather than a token — this file renders before the stylesheet loads,
        so it cannot read the variable. If the paper colour changes again,
        change this with it. */}
    <meta name="theme-color" content="#FCFCF9" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thread" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Thread · custom software for Hawaiʻi businesses. Apps, dashboards, automation and practical AI, Honolulu."
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted; these four are used above the fold: Newsreader
         for the h1, Plex 400 for the eyebrow and nav, Plex 500 for the
         buttons, and the JetBrains subset that supplies the U+2192 arrow in
         the ghost button. Public Sans was preloaded here until 19 Aug 2026
         despite being unreferenced since the Option K trial — a preload forces
         the download an unused @font-face would otherwise never make. -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {businessSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(businessLd)}
      />
    )}
  </head>
  <body>
    <slot />
    {/* Layout guides, development only. `import.meta.env.DEV` is resolved at
        build time, so this is absent from the production output entirely. */}
    {import.meta.env.DEV && <DevGrid />}
  </body>
</html>
