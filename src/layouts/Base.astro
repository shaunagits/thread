---
import '../styles/global.css';

import { contact } from '../content/site';
import DevGrid from '../components/DevGrid.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Emit the business entity as structured data. Homepage only — repeating the
   * same entity on every page adds nothing and muddies which URL it belongs to.
   */
  businessSchema?: boolean;
  /** Keep the page out of the index. For pages that exist but are not ready. */
  noindex?: boolean;
}

const {
  title = 'Thread · Custom software and automation, Honolulu, Hawaiʻi',
  description = 'Thread builds custom software that fits how your business already works. I connect the tools you run, or build the one nobody sells. You own the code, the data, and the accounts it lives in.',
  businessSchema = false,
  noindex = false,
} = Astro.props;

// Absolute URLs, derived from `site` in astro.config.mjs. Social scrapers
// reject relative image paths, so these must resolve against the real domain.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

/**
 * The entity, stated once in machine-readable form. The brand guide's §10 asks
 * for a consistent description of what Thread is across the web so search and
 * assistants resolve it to one thing; this is that description at the source.
 *
 * Deliberately absent: street address, telephone, opening hours, price range,
 * aggregate rating, and `sameAs` profile links. Every one of those would be
 * invented today. Add them here as they become real — `sameAs` first, once the
 * LinkedIn and Google Business Profile URLs exist.
 */
const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#thread', Astro.site).href,
  name: 'Thread',
  description:
    'Custom software for Hawaiʻi businesses. Thread connects the tools a business already runs, or builds the one nobody sells, and hands over the source code, the data and the accounts it runs in.',
  url: new URL('/', Astro.site).href,
  email: contact.email,
  founder: { '@type': 'Person', name: 'Shauna' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Honolulu',
    addressRegion: 'HI',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Hawaiʻi' },
    { '@type': 'Country', name: 'United States' },
  ],
  knowsAbout: [
    'Custom software development',
    'Business process automation',
    'Systems integration',
    'Operations dashboards',
    'Applied AI for small business',
  ],
  /**
   * The three engagements from the v3 copy. The free systems map was here
   * until 14 Aug 2026, when the owner killed it as an offer — and because this
   * block is indexed, it outlives the page edit, so it had to come out in the
   * same change rather than later.
   *
   * No `priceSpecification` on any of these. The prices are still
   * `[CONFIRM]` and a structured-data price is the most quotable kind of
   * invented number there is.
   */
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Connect',
        description:
          'One place to see and run everything: live data from the systems you already use, with automation closing the handoffs between them.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Build',
        description:
          'The custom application a business needs and nobody sells, plus the integrations that keep it fed.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Ongoing',
        description:
          'Monitoring, fixes and a set amount of new work each month after handover. Month to month, and optional.',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <!-- icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FCFBF7" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thread" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Thread · custom software for Hawaiʻi businesses. Apps, dashboards, automation and practical AI, Honolulu."
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted; these three are used above the fold. -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {businessSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(businessLd)}
      />
    )}
  </head>
  <body>
    <slot />
    {/* Layout guides, development only. `import.meta.env.DEV` is resolved at
        build time, so this is absent from the production output entirely. */}
    {import.meta.env.DEV && <DevGrid />}
  </body>
</html>
