---
import '../styles/global.css';

import { contact } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  /**
   * Emit the business entity as structured data. Homepage only — repeating the
   * same entity on every page adds nothing and muddies which URL it belongs to.
   */
  businessSchema?: boolean;
}

const {
  title = 'Custom software for Hawaiʻi businesses · Thread, Honolulu',
  description = 'Thread builds custom apps, dashboards, automation and practical AI for Hawaiʻi businesses. Based in Honolulu. Every engagement starts with a free systems map.',
  businessSchema = false,
} = Astro.props;

// Absolute URLs, derived from `site` in astro.config.mjs. Social scrapers
// reject relative image paths, so these must resolve against the real domain.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;

/**
 * The entity, stated once in machine-readable form. The brand guide's §10 asks
 * for a consistent description of what Thread is across the web so search and
 * assistants resolve it to one thing; this is that description at the source.
 *
 * Deliberately absent: street address, telephone, opening hours, price range,
 * aggregate rating, and `sameAs` profile links. Every one of those would be
 * invented today. Add them here as they become real — `sameAs` first, once the
 * LinkedIn and Google Business Profile URLs exist.
 */
const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#thread', Astro.site).href,
  name: 'Thread',
  description:
    'Custom software, dashboards, automation and practical AI for Hawaiʻi businesses. Thread maps how work moves through a business, then builds what closes the gaps.',
  url: new URL('/', Astro.site).href,
  email: contact.email,
  founder: { '@type': 'Person', name: 'Shauna' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Honolulu',
    addressRegion: 'HI',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Hawaiʻi' },
    { '@type': 'Country', name: 'United States' },
  ],
  knowsAbout: [
    'Custom software development',
    'Business process automation',
    'Systems integration',
    'Operations dashboards',
    'Applied AI for small business',
  ],
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Systems map',
        description:
          'A free map of how one workflow moves through your business, with a ranked list of what is worth fixing first.',
      },
    },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom internal apps' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Dashboards and reporting' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Automation and integration' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Practical AI' } },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- icons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FCFBF7" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Thread" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Thread · custom software for Hawaiʻi businesses. Apps, dashboards, automation and practical AI, Honolulu."
    />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted; these three are used above the fold. -->
    <link
      rel="preload"
      href="/fonts/newsreader-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/public-sans-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {businessSchema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(businessLd)}
      />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
