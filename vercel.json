{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/work",
      "destination": "https://shauna.digital/results/",
      "permanent": true
    },
    {
      "source": "/work/:path*",
      "destination": "https://shauna.digital/results/",
      "permanent": true
    },
    {
      "source": "/automation-audit",
      "destination": "https://shauna.digital/contact/",
      "permanent": true
    },
    {
      "source": "/systems-map",
      "destination": "https://shauna.digital/contact/",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://shauna.digital/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://shauna.digital/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.ico|apple-touch-icon.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ]
}
